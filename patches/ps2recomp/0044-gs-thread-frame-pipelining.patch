+void PS2Memory::noteDisplayWrite(uint32_t address)
+{
+    if (!m_gsWorkerEnabled)
+        return;
+    const uint32_t offset = (address - PS2_GS_PRIV_REG_BASE) & ~0x7u;
+    switch (offset)
+    {
+    case 0x00u: // PMODE
+    case 0x20u: // SMODE2
+    case 0x70u: // DISPFB1
+    case 0x80u: // DISPLAY1
+    case 0x90u: // DISPFB2
+    case 0xA0u: // DISPLAY2
+    case 0xE0u: // BGCOLOR
+        if (uint64_t *reg = gsRegPtr(gs_regs, PS2_GS_PRIV_REG_BASE + offset))
+            enqueueGsSpecial(1u, offset, *reg);
+        break;
+    default:
+        break;
+    }
+}
+
+void PS2Memory::enqueueGsSpecial(uint8_t kind, uint32_t offset, uint64_t value)
+{
+    std::vector<uint8_t> data(12u);
+    std::memcpy(data.data(), &offset, 4u);
+    std::memcpy(data.data() + 4u, &value, 8u);
+    {
+        std::lock_guard<std::mutex> lock(m_gsWorkMutex);
+        m_gsWorkBytes += data.size();
+        GsWorkItem item;
+        item.special = kind;
+        item.data = std::move(data);
+        m_gsWork.push_back(std::move(item));
+    }
+    m_gsWorkCv.notify_one();
+}
+
+void PS2Memory::applyGsSpecial(uint8_t kind, uint32_t offset, uint64_t value)
+{
+    if (kind == 1u)
+    {
+        if (m_gsDisplayFn)
+            m_gsDisplayFn(offset, value);
+    }
+    else if (kind == 3u)
