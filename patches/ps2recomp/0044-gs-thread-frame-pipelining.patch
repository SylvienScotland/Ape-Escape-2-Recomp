+        return false;
+    const size_t at = m_gsBatch.size();
+    m_gsBatch.resize(at + 4u + sizeBytes);
+    std::memcpy(m_gsBatch.data() + at, &sizeBytes, 4u);
+    std::memcpy(m_gsBatch.data() + at + 4u, data, sizeBytes);
+    return true;
+}
