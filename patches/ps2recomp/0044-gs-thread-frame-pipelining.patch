+        return;
+    const uint64_t id = ++m_frameMarkPushed;
+    enqueueGsSpecial(2u, 0u, id);
+    if (id < 2u)
+        return;
+    std::unique_lock<std::mutex> lock(m_frameMarkMutex);
+    if (m_frameMarkDone.load(std::memory_order_acquire) >= id - 1u)
+        return;
+    const uint64_t t0 = gsWorkerNowUs();
+    m_frameMarkCv.wait(lock, [&]
+                       { return m_frameMarkDone.load(std::memory_order_acquire) >= id - 1u; });
