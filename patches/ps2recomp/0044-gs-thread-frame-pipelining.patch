+void PS2Memory::flushGsBatch()
+{
+    if (m_gsBatch.empty())
+        return;
+    std::unique_lock<std::mutex> lock(m_gsThreadMutex);
+    constexpr size_t kMaxQueuedBytes = 48u << 20;
+    if (m_gsThreadBytes > kMaxQueuedBytes)
