+        if (len < static_cast<int>(sizeof(line)))
+            std::snprintf(line + len, sizeof(line) - len, " | worst frame %.1f ms, >20ms %u, >33ms %u",
+                          static_cast<double>(g_worstGapNs.exchange(0)) / 1e6, g_gaps20.exchange(0), g_gaps33.exchange(0));
         std::fprintf(stderr, "%s\n", line);
         std::fflush(stderr);
 
@@ -222,6 +228,19 @@ namespace ps2perf
     inline void countFrame()
     {
         g_frames.fetch_add(1, std::memory_order_relaxed);
-        maybeReport(nowNs());
+        const int64_t now = nowNs();
+        static int64_t lastFrameNs = 0;
+        if (lastFrameNs != 0)
+        {
+            const int64_t gap = now - lastFrameNs;
+            if (gap > g_worstGapNs.load(std::memory_order_relaxed))
+                g_worstGapNs.store(gap, std::memory_order_relaxed);
+            if (gap > 20'000'000)
+                g_gaps20.fetch_add(1, std::memory_order_relaxed);
+            if (gap > 33'000'000)
