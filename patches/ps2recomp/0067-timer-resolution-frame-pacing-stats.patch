index 2f839f4..826c471 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -774,6 +774,35 @@ int EeScheduler::startThread(int id, uint32_t arg, const R5900Context &caller, b
     return KE_OK;
 }
 
+#ifdef _WIN32
+// 0067: the scheduler paces frames with condition-variable waits (wait_until), and Windows rounds those to the
+// system timer tick, 15.6 ms unless the process asks for 1 ms. A wait meant to end just before a frame's deadline
+// woke up to ~15 ms late: single 33 ms frames (one missed vblank) 1-3 times every 2 s in play. APE2_TIMER_RES=0
+// keeps the default tick.
+extern "C" __declspec(dllimport) unsigned int __stdcall timeBeginPeriod(unsigned int);
+extern "C" __declspec(dllimport) unsigned int __stdcall timeEndPeriod(unsigned int);
+#pragma comment(lib, "winmm.lib")
+namespace
+{
+    struct Ape2TimerResolution
+    {
+        bool on = false;
+        Ape2TimerResolution()
+        {
+            const char *e = std::getenv("APE2_TIMER_RES");
+            on = !(e && e[0] == '0');
+            if (on)
+                timeBeginPeriod(1u);
+        }
+        ~Ape2TimerResolution()
+        {
+            if (on)
+                timeEndPeriod(1u);
+        }
+    } g_ape2TimerResolution;
+}
+#endif
+
 extern uint32_t g_ape2LastSyscall, g_ape2LastSyscallRa; // ps2_runtime.cpp
 namespace
 {
