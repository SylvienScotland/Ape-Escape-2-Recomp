+// PS2 compares, MIN and MAX: there is no NaN or Inf and denormals are zero, so values are ordered as
+// sign-magnitude numbers (exponent 255 is just bigger than the largest host float). The host's own compares
+// call those patterns unordered and return false, which broke searches that start from a 0x7FFFFFFF-style
+// "largest" value. As the PAL port JackyPendrag0n/ae2-recomp (port/include/ps2.h, fkey; Ape Escape 2 recomp
+// patch 0030).
+inline int32_t ps2_fkey(float f)
+{
+    const uint32_t u = std::bit_cast<uint32_t>(f);
+    if ((u & 0x7F800000u) == 0u)
+        return 0;
+    return (u & 0x80000000u) ? -static_cast<int32_t>(u & 0x7FFFFFFFu) : static_cast<int32_t>(u);
+}
+inline float ps2_fmax(float a, float b) { return ps2_fkey(a) > ps2_fkey(b) ? a : b; }
+inline float ps2_fmin(float a, float b) { return ps2_fkey(a) < ps2_fkey(b) ? a : b; }
