+size_t PS2AudioBackend::streamRingFill() const
+{
+#if defined(PLATFORM_VITA)
+    return 0u;
+#else
+    if (!m_impl)
+        return 0u;
+    std::lock_guard<std::mutex> lock(const_cast<std::mutex &>(m_mutex));
+    return m_impl->streamReady ? m_impl->ringCount : 0u;
+#endif
+}
+
+void PS2AudioBackend::pushStreamPcm(const int16_t *pcm, size_t frames)
+{
+#if defined(PLATFORM_VITA)
+    (void)pcm;
+    (void)frames;
+    return;
+#else
+    if (!m_audioReady || !pcm || frames == 0u)
+        return;
+
+    // One emulated video frame at 48 kHz. Must match the sub-buffer size set below.
+    constexpr size_t kChunk = 800u;
+
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto &impl = *m_impl;
+
+    if (!impl.streamReady)
+    {
+        // 0210: raylib splits the stream buffer in two and zero-fills whatever a call does not supply, so the
+        // sub-buffer must be exactly the number of frames we hand over. With the default 4096 the sub-buffer was
+        // 2048 frames against a 512-frame chunk: 75% of every submission was silence.
+        SetAudioStreamBufferSizeDefault(static_cast<int>(kChunk * 2u));
+        impl.stream = LoadAudioStream(static_cast<unsigned>(Impl::kStreamRate), 16u, 2u);
+        if (!IsAudioStreamValid(impl.stream))
+            return;
+        g_streamSink.lock = &m_mutex;
+        g_streamSink.ring = &impl.streamRing;
+        g_streamSink.head = &impl.ringHead;
+        g_streamSink.count = &impl.ringCount;
+        g_streamSink.capacity = Impl::kRingFrames;
+        SetAudioStreamCallback(impl.stream, streamFillCallback);
+        PlayAudioStream(impl.stream);
+        impl.streamReady = true;
+    }
+
+    for (size_t i = 0; i < frames; ++i)
+    {
+        const size_t slot = (impl.ringHead + impl.ringCount) % Impl::kRingFrames;
+        impl.streamRing[slot * 2u + 0u] = pcm[i * 2u + 0u];
+        impl.streamRing[slot * 2u + 1u] = pcm[i * 2u + 1u];
+        if (impl.ringCount < Impl::kRingFrames)
+            ++impl.ringCount;
+        else
+            impl.ringHead = (impl.ringHead + 1u) % Impl::kRingFrames; // overrun: drop oldest
+    }
+
+    // 0211: the device is fed by streamFillCallback; this function only fills the ring.
+#endif
+}
