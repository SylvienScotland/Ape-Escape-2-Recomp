+// 0072: the presenter's side of the high-resolution copies (see PresentSlot)
+bool ape2AcquireGpuFrame(uint32_t fbp, uint32_t width, uint32_t height, Ape2GpuFrame &out)
+{
+    out = Ape2GpuFrame{};
+    if (!gpuPresentOn() || width == 0u || height == 0u)
+        return false;
+    std::lock_guard<std::mutex> lock(g_presentMutex);
+    int best = -1;
+    for (int i = 0; i < kPresentSlots; ++i)
+    {
+        const PresentSlot &p = g_present[i];
+        if (p.valid && p.fbp == fbp && p.ox + static_cast<int>(width) <= p.w && p.oy + static_cast<int>(height) <= p.h &&
+            (best < 0 || p.serial > g_present[best].serial))
+            best = i;
+    }
+    if (best < 0)
+        return false;
+    PresentSlot &p = g_present[best];
+    ++p.holds;
+    out.slot = best;
+    out.tex = p.tex;
+    out.texW = p.w * p.scale;
+    out.texH = p.h * p.scale;
+    out.scale = p.scale;
+    out.ox = p.ox;
+    out.oy = p.oy;
+    return true;
+}
+
+void ape2HoldGpuFrame(const Ape2GpuFrame &frame)
+{
+    if (frame.slot < 0)
+        return;
+    std::lock_guard<std::mutex> lock(g_presentMutex);
+    ++g_present[frame.slot].holds;
+}
+
+void ape2ReleaseGpuFrame(const Ape2GpuFrame &frame)
+{
+    if (frame.slot < 0)
+        return;
+    std::lock_guard<std::mutex> lock(g_presentMutex);
+    if (g_present[frame.slot].holds > 0)
+        --g_present[frame.slot].holds;
+}
+
+void ape2WaitGpuFrame(const Ape2GpuFrame &frame)
+{
+    if (frame.slot < 0)
+        return;
+    // loaded in the presenter's own context (the GS thread's pointers belong to its context)
+    using WaitSyncFn = void(WINAPI *)(GLsync, GLbitfield, GLuint64);
+    static const WaitSyncFn waitSync = reinterpret_cast<WaitSyncFn>(glfwGetProcAddress("glWaitSync"));
+    GLsync fence = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(g_presentMutex);
+        fence = g_present[frame.slot].fence; // held: the GS thread does not replace it
+    }
+    if (waitSync && fence)
+        waitSync(fence, 0, GL_TIMEOUT_IGNORED);
+}
