+    // ---------------------------------------------------------------- presentation (0072)
+    // the displayed buffer at fbp (blocks) as the presenter's high-resolution picture. Without a target there the
+    // buffer's newest contents came from VRAM writes, so its older copies stop being offered.
+    void publishPresent(uint32_t fbp, Target *rt, int ox, int oy)
+    {
+        if (!gpuPresentOn())
+            return;
+        std::lock_guard<std::mutex> lock(g_presentMutex);
+        if (!rt)
+        {
+            for (PresentSlot &p : g_present)
+                if (p.valid && p.fbp == fbp)
+                    p.valid = false;
+            return;
+        }
+        // a slot nobody holds: an unused one, else the oldest copy
+        PresentSlot *slot = nullptr;
+        for (PresentSlot &p : g_present)
+        {
+            if (p.holds > 0)
+                continue;
+            if (!slot || (!p.valid && slot->valid) || (p.valid == slot->valid && p.serial < slot->serial))
+                slot = &p;
+        }
+        if (!slot)
+            return;
+        flush();
+        const int W = rt->w * m_scale, H = rt->h * m_scale;
+        if (!slot->tex || slot->w * slot->scale != W || slot->h * slot->scale != H)
+        {
+            if (slot->tex)
+            {
+                glDeleteTextures(1, &slot->tex);
+                glDeleteFramebuffers(1, &slot->fbo);
+            }
+            slot->tex = newTex(W, H, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE);
+            texParams(slot->tex, GL_LINEAR, GL_CLAMP_TO_EDGE, GL_CLAMP_TO_EDGE);
+            glGenFramebuffers(1, &slot->fbo);
+            glBindFramebuffer(GL_FRAMEBUFFER, slot->fbo);
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, slot->tex, 0);
+        }
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, rt->fbo);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, slot->fbo);
+        glDisable(GL_SCISSOR_TEST);
+        glBlitFramebuffer(0, 0, W, H, 0, 0, W, H, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        glBindFramebuffer(GL_FRAMEBUFFER, rt->fbo);
+        if (slot->fence)
+            glDeleteSync(slot->fence);
+        slot->fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+        glFlush(); // the presenter's context waits on the fence: it has to reach the GPU
+        slot->w = rt->w;
+        slot->h = rt->h;
+        slot->scale = m_scale;
+        slot->fbp = fbp;
+        slot->ox = ox;
+        slot->oy = oy;
+        slot->valid = true;
+        slot->serial = ++g_presentSerial;
+    }
