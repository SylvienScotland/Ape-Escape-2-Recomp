+#pragma once
+// Ape Escape 2 recomp patch 0072: the displayed buffer at the GPU renderer's internal resolution, for the presenter
+// (zz_ape2_gs_gl.cpp makes the copies on the GS thread; ps2_runtime.cpp draws them).
+#include <cstdint>
+
+struct Ape2GpuFrame
+{
+    int slot = -1;          // -1: none, use the picture read back through VRAM
+    unsigned int tex = 0;   // GL texture, shared with the presenter's context
+    int texW = 0, texH = 0; // texture size in pixels
+    int scale = 1;          // pixels per GS pixel
+    int ox = 0, oy = 0;     // the displayed area's origin in the buffer, in GS pixels
+};
+
+// presenter thread: the newest copy of the buffer at fbp (in 256-byte blocks) that covers width x height, held
+// until released; false (out.slot == -1) when there is none
+bool ape2AcquireGpuFrame(uint32_t fbp, uint32_t width, uint32_t height, Ape2GpuFrame &out);
+void ape2HoldGpuFrame(const Ape2GpuFrame &frame);
+void ape2ReleaseGpuFrame(const Ape2GpuFrame &frame);
+// presenter thread, its own context current: the GPU waits for the copy before drawing it
+void ape2WaitGpuFrame(const Ape2GpuFrame &frame);
