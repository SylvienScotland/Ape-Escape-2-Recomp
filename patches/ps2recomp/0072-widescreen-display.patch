+// 0072: display aspect of the presented picture. APE2_ASPECT=16:9 (or "wide") starts in 16:9, for the game's own
+// 16:9 screen option; F6 toggles it while playing.
+static std::atomic<bool> &ape2WideDisplay()
+{
+    static std::atomic<bool> wide{[] {
+        const char *e = std::getenv("APE2_ASPECT");
+        return e && (std::strcmp(e, "16:9") == 0 || std::strcmp(e, "wide") == 0);
+    }()};
+    return wide;
+}
+// a windowed (not maximized / fullscreen) window keeps its height and takes the picture's width, so no bars
+static void ape2FitWindowToAspect(bool wide)
+{
+#if !defined(PLATFORM_VITA)
+    if (IsWindowFullscreen() || IsWindowMaximized())
+        return;
+    const int h = GetScreenHeight();
+    SetWindowSize(static_cast<int>(static_cast<float>(h) * (wide ? 16.0f / 9.0f : 4.0f / 3.0f) + 0.5f), h);
+#else
+    (void)wide;
+#endif
+}
