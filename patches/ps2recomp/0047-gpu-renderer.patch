+    // ---------------------------------------------------------------- targets
+    static void rowsBlocks(const Target &o, int y0, int y1, uint32_t &b0, uint32_t &b1)
+    {
+        const int ph = o.is16 ? 64 : 32;
+        b0 = o.fbp + static_cast<uint32_t>(y0 / ph) * o.fbw * 32u;
+        b1 = o.fbp + static_cast<uint32_t>(y1 / ph + 1) * o.fbw * 32u;
+    }
+    static bool overlaps(const Target &o, uint32_t bp, uint32_t nblocks)
+    {
+        uint32_t a0, a1;
+        rowsBlocks(o, 0, o.vh - 1, a0, a1);
+        return a0 < bp + nblocks && bp < a1;
+    }
+    static bool dirtyOverlaps(const Target &o, uint32_t bp, uint32_t nblocks)
+    {
+        if (!o.gpuDirty)
+            return false;
+        uint32_t a0, a1;
+        rowsBlocks(o, o.dy0, o.dy1, a0, a1);
+        return a0 < bp + nblocks && bp < a1;
+    }
+    static void mark(Target &o, int x0, int y0, int x1, int y1)
+    {
+        x0 = std::max(x0, 0);
+        y0 = std::max(y0, 0);
+        x1 = std::min(x1, o.w - 1);
+        y1 = std::min(y1, o.h - 1);
+        if (x0 > x1 || y0 > y1)
+            return;
+        if (!o.gpuDirty)
+        {
+            o.dx0 = x0;
+            o.dy0 = y0;
+            o.dx1 = x1;
+            o.dy1 = y1;
+            o.gpuDirty = true;
+            return;
+        }
+        o.dx0 = std::min(o.dx0, x0);
+        o.dy0 = std::min(o.dy0, y0);
+        o.dx1 = std::max(o.dx1, x1);
+        o.dy1 = std::max(o.dy1, y1);
+    }
+    void attachZ(Target &rt, Depth *z)
+    {
+        const GLuint zt = z ? z->tex : 0;
+        if (rt.ztex == zt)
+            return;
+        glBindFramebuffer(GL_FRAMEBUFFER, rt.fbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, zt, 0);
+        rt.ztex = zt;
+    }
+    Target *findTarget(uint32_t fbp, uint32_t fbw, bool sixteen)
+    {
+        for (Target &t : m_rt)
+            if (t.used && t.fbp == fbp && t.fbw == fbw && t.is16 == sixteen)
+                return &t;
+        return nullptr;
+    }
+    void dropTarget(Target &o)
+    {
+        if (m_haveCur && m_cur.rt == &o)
+        {
+            flush();
+            m_haveCur = false;
+        }
+        download(o);
+        glDeleteTextures(1, &o.tex);
+        glDeleteFramebuffers(1, &o.fbo);
+        o.used = false;
+    }
+    void dropTargets()
+    {
+        for (int i = 0; i < kTargets; ++i)
+        {
+            if (m_rt[i].used)
+            {
+                glDeleteTextures(1, &m_rt[i].tex);
+                glDeleteFramebuffers(1, &m_rt[i].fbo);
+            }
+            if (m_z[i].used)
+                glDeleteTextures(1, &m_z[i].tex);
+            m_rt[i].used = false;
+            m_z[i].used = false;
+        }
+        m_haveCur = false;
+        m_v.clear();
+    }
+    // rows y0..y1 of a target take their content from VRAM; older targets that claim that VRAM are retired first
+    void claimRows(Target &rt, int y0, int y1)
+    {
+        uint32_t b0, b1;
+        rowsBlocks(rt, y0, y1, b0, b1);
+        for (Target &o : m_rt)
+            if (o.used && &o != &rt && overlaps(o, b0, b1 - b0))
+                dropTarget(o);
+        std::vector<uint32_t> px;
+        vramReadRgba(rt.fbp, rt.fbw, rt.is16 ? GS_PSM_CT16 : GS_PSM_CT32, 0, y0, rt.w, y1 - y0 + 1, px);
+        uploadRect(rt, 0, y0, rt.w, y1 - y0 + 1, px.data());
+    }
+    Target *getTarget(uint32_t fbp, uint32_t fbw, bool sixteen, int needH)
+    {
+        const int ph = sixteen ? 64 : 32;
+        needH = std::min(needH, 1024);
+        needH = std::max((needH + ph - 1) / ph * ph, ph);
+        Target *rt = findTarget(fbp, fbw, sixteen);
+        if (rt && rt->h >= needH)
+        {
+            rt->lru = ++m_tick;
+            if (needH > rt->vh)
+            {
+                flush();
+                const int y0 = rt->vh;
+                rt->vh = needH;
+                claimRows(*rt, y0, needH - 1);
+            }
+            return rt;
+        }
+        flush();
+        const int w = static_cast<int>(fbw ? fbw : 1u) * 64;
+        if (rt)
+        {
+            const int keep = rt->vh;
+            dropTarget(*rt);
+            needH = std::max(needH, keep);
+        }
+        else
+        {
+            for (Target &t : m_rt)
+                if (!t.used)
+                {
+                    rt = &t;
+                    break;
+                }
+            if (!rt)
+            {
+                Target *v = &m_rt[0];
+                for (Target &t : m_rt)
+                    if (t.lru < v->lru)
+                        v = &t;
+                dropTarget(*v);
+            }
+        }
+        rt = nullptr;
+        for (Target &t : m_rt)
+            if (!t.used)
+            {
+                rt = &t;
+                break;
+            }
+        const int h = needH <= 512 ? 512 : 1024;
+        *rt = Target{};
+        rt->used = true;
+        rt->fbp = fbp;
+        rt->fbw = fbw;
+        rt->is16 = sixteen;
+        rt->w = w;
+        rt->h = h;
+        rt->lru = ++m_tick;
+        rt->vh = needH;
+        rt->tex = newTex(w * m_scale, h * m_scale, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE);
+        glGenFramebuffers(1, &rt->fbo);
+        glBindFramebuffer(GL_FRAMEBUFFER, rt->fbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, rt->tex, 0);
+        claimRows(*rt, 0, needH - 1);
+        return rt;
+    }
+    Depth *getDepth(uint32_t zbp, int w, int h)
+    {
+        for (Depth &z : m_z)
+            if (z.used && z.zbp == zbp)
+            {
+                if (z.w == w && z.h == h)
+                {
+                    z.lru = ++m_tick;
+                    return &z;
+                }
+                for (Target &t : m_rt)
+                    if (t.used && t.ztex == z.tex)
+                        attachZ(t, nullptr);
+                glDeleteTextures(1, &z.tex);
+                z.used = false;
+                break;
+            }
+        Depth *z = nullptr;
+        for (Depth &d : m_z)
+            if (!d.used)
+            {
+                z = &d;
+                break;
+            }
+        if (!z)
+        {
+            z = &m_z[0];
+            for (Depth &d : m_z)
+                if (d.lru < z->lru)
+                    z = &d;
+            for (Target &t : m_rt)
+                if (t.used && t.ztex == z->tex)
+                    attachZ(t, nullptr);
+            glDeleteTextures(1, &z->tex);
+        }
+        *z = Depth{};
+        z->used = true;
+        z->zbp = zbp;
+        z->w = w;
+        z->h = h;
+        z->lru = ++m_tick;
+        // depth starts at 0 (the GS clears it by drawing; undefined contents would show through)
+        const std::vector<float> zeros(static_cast<size_t>(w * m_scale) * static_cast<size_t>(h * m_scale), 0.0f);
+        glGenTextures(1, &z->tex);
+        glBindTexture(GL_TEXTURE_2D, z->tex);
+        glTexImage2D(GL_TEXTURE_2D, 0, static_cast<GLint>(GL_DEPTH_COMPONENT32F), w * m_scale, h * m_scale, 0, GL_DEPTH_COMPONENT, GL_FLOAT, zeros.data());
+        texParams(z->tex, GL_NEAREST, GL_CLAMP_TO_EDGE, GL_CLAMP_TO_EDGE);
+        return z;
+    }
+    // [bp, bp + nblocks) overlaps a target with GPU-only content: read it back
+    void syncRange(uint32_t bp, uint32_t nblocks, const char *why)
+    {
+        (void)why;
+        for (Target &o : m_rt)
+            if (o.used && dirtyOverlaps(o, bp, nblocks))
+            {
+                flush();
+                download(o);
+            }
+    }
+    static uint32_t transferBlocks(uint32_t bw, uint32_t psm, uint32_t y0, uint32_t w, uint32_t h)
+    {
+        const uint32_t bpp = psm == GS_PSM_T4 ? 4u : psm == GS_PSM_T8 ? 8u : is16(psm) ? 16u : 32u;
+        return ((bw ? bw * 64u : w) * (y0 + h) * bpp / 8u) / 256u + 32u;
+    }
+    // VRAM written by a transfer: refresh overlapping targets
+    void vramWritten(uint32_t bp, uint32_t bw, uint32_t psm, int x0, int y0, int w, int h)
+    {
+        const uint32_t nb = transferBlocks(bw, psm, static_cast<uint32_t>(std::max(y0, 0)), static_cast<uint32_t>(w), static_cast<uint32_t>(h));
+        for (Target &o : m_rt)
+        {
+            if (!o.used || !overlaps(o, bp, nb))
+                continue;
+            flush();
+            const bool same = bp == o.fbp && bw == o.fbw && (psm == GS_PSM_CT32 || psm == GS_PSM_CT24 || is16(psm)) && is16(psm) == o.is16;
+            const int rx0 = std::max(x0, 0), ry0 = std::max(y0, 0);
+            const int rw = std::min(w, o.w - rx0), rh = h;
+            if (same && rw > 0 && rh > 0 && ry0 + rh <= o.vh)
+            {
+                std::vector<uint32_t> px;
+                vramReadRgba(o.fbp, o.fbw, o.is16 ? GS_PSM_CT16 : GS_PSM_CT32, rx0, ry0, rw, rh, px);
+                uploadRect(o, rx0, ry0, rw, rh, px.data());
+            }
+            else
+                dropTarget(o); // memory reused for something else (its drawing was saved before the write)
+        }
+    }
+    static uint32_t texBlocks(const GSTex0Reg &t)
+    {
+        const uint32_t bpp = t.psm == GS_PSM_T4 ? 4u : t.psm == GS_PSM_T8 ? 8u : is16(t.psm) ? 16u : 32u;
+        const uint32_t w = 1u << std::min<uint32_t>(t.tw, 10u), h = 1u << std::min<uint32_t>(t.th, 10u);
+        const uint32_t tbw = t.tbw ? t.tbw * 64u : w;
+        return tbw * h * bpp / 8u / 256u + 32u;
+    }
+    // a texture that is a render target (same address, a colour format the target holds)
+    Target *texTarget(const GSTex0Reg &t)
+    {
+        for (Target &o : m_rt)
+        {
+            if (!o.used || o.fbp != t.tbp0)
+                continue;
+            const bool sixteen = is16(t.psm);
+            if ((t.psm == GS_PSM_CT32 || t.psm == GS_PSM_CT24 || sixteen) && sixteen == o.is16 &&
+                (t.tbw == o.fbw || (1u << t.tw) <= o.fbw * 64u))
+                return &o;
+        }
+        return nullptr;
+    }
+    // decoded (CPU) texture as a GL texture
+    GLuint cpuTexture(const GSDrawState &state, int &tw, int &th)
+    {
+        std::lock_guard<std::mutex> lock(m_cpu->m_mutex);
+        const GSCpuBackend::DecodedTexture *d = m_cpu->PrepareTexture(state);
+        if (!d || d->w <= 0 || d->h <= 0)
+            return 0;
+        GlTexture &g = m_textures[d];
+        tw = d->w;
+        th = d->h;
+        if (g.tex && g.epoch == d->decodeEpoch && g.key0 == d->key[0] && g.key1 == d->key[1] && g.key2 == d->key[2] &&
+            g.clutVersion == d->clutVersion && g.w == d->w && g.h == d->h)
+            return g.tex;
+        // APE2_GL_TEXLOG=1: textures uploaded (size, format, address, why)
+        static const bool texLog = std::getenv("APE2_GL_TEXLOG") != nullptr;
+        if (texLog)
+        {
+            static int shown = 0;
+            if (shown < 400)
+            {
+                ++shown;
+                const auto &t0 = state.context.tex0;
+                std::fprintf(stderr, "[gpu:tex] %dx%d psm=0x%x tbp0=0x%x tbw=%u cbp=0x%x cpsm=%u %s epoch=%llu clutv=%u\n", d->w, d->h,
+                             t0.psm, t0.tbp0, t0.tbw, t0.cbp, t0.cpsm, g.tex ? "stale" : "new",
+                             static_cast<unsigned long long>(d->decodeEpoch), d->clutVersion);
+            }
+        }
+        // decode every tile that has not been decoded yet
+        auto &dt = const_cast<GSCpuBackend::DecodedTexture &>(*d);
+        const auto &dtex = dt.decodeState.context.tex0;
+        const bool indexed = dtex.psm == GS_PSM_T8 || dtex.psm == GS_PSM_T8H || dtex.psm == GS_PSM_T4 ||
+                             dtex.psm == GS_PSM_T4HL || dtex.psm == GS_PSM_T4HH;
+        if (indexed)
+        {
+            // palette textures: the palette once, then one VRAM read per texel (DecodeTexel looks the CLUT up
+            // for every texel)
+            uint32_t pal[256];
+            const int entries = (dtex.psm == GS_PSM_T8 || dtex.psm == GS_PSM_T8H) ? 256 : 16;
+            for (int i = 0; i < entries; ++i)
+                pal[i] = m_cpu->LookupCLUT(dt.decodeState, static_cast<uint8_t>(i), dtex.cpsm, dtex.csm, dtex.csa, dtex.psm, dt.clut.data());
+            const uint8_t *base = dt.rawBase ? dt.rawBase : m_cpu->m_vram;
+            for (int vv = 0; vv < dt.h; ++vv)
+            {
+                uint32_t *row = dt.texels.data() + static_cast<size_t>(vv) * static_cast<size_t>(dt.w);
+                for (int uu = 0; uu < dt.w; ++uu)
+                    row[uu] = pal[GSMem::ReadTexture(m_cpu->m_texturePageCache, base, dtex.psm, dtex.tbp0, dtex.tbw,
+                                                     static_cast<uint32_t>(uu), static_cast<uint32_t>(vv)) &
+                                  static_cast<uint32_t>(entries - 1)];
+            }
+            for (size_t i = 0; i < dt.tileCount; ++i)
+                dt.tileReady[i].store(1u, std::memory_order_release);
+        }
+        for (size_t i = 0; i < dt.tileCount; ++i)
+        {
+            if (dt.tileReady[i].load(std::memory_order_acquire))
+                continue;
+            const int u0 = static_cast<int>(i % static_cast<size_t>(dt.tilesW)) * 8, v0 = static_cast<int>(i / static_cast<size_t>(dt.tilesW)) * 8;
+            const int u1 = std::min(u0 + 8, dt.w), v1 = std::min(v0 + 8, dt.h);
+            for (int vv = v0; vv < v1; ++vv)
+                for (int uu = u0; uu < u1; ++uu)
+                    dt.texels[static_cast<size_t>(vv) * static_cast<size_t>(dt.w) + static_cast<size_t>(uu)] =
+                        m_cpu->DecodeTexel(dt.decodeState, uu, vv, dt.clut.data(), dt.rawBase);
+            dt.tileReady[i].store(1u, std::memory_order_release);
+        }
+        if (!g.tex)
+            glGenTextures(1, &g.tex);
+        glBindTexture(GL_TEXTURE_2D, g.tex);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+        if (g.w != d->w || g.h != d->h)
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, d->w, d->h, 0, GL_RGBA, GL_UNSIGNED_BYTE, d->texels.data());
+        else
+            glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, d->w, d->h, GL_RGBA, GL_UNSIGNED_BYTE, d->texels.data());
+        g.epoch = d->decodeEpoch;
+        g.key0 = d->key[0];
+        g.key1 = d->key[1];
+        g.key2 = d->key[2];
+        g.clutVersion = d->clutVersion;
+        g.w = d->w;
+        g.h = d->h;
+        ++m_stTexUploads;
+        return g.tex;
+    }
+
+    // ---------------------------------------------------------------- batches
+    void bindDst(DrawState &s, int x0, int y0, int x1, int y1)
+    {
+        Target &rt = *s.rt;
+        glActiveTexture(GL_TEXTURE1);
+        if (m_barrier)
+        {
+            glBindTexture(GL_TEXTURE_2D, rt.tex);
+            glTextureBarrier();
+            glUniform2f(u_dstoff, 0, 0);
+        }
+        else
+        {
+            const int S = m_scale;
+            int w = (x1 - x0 + 1) * S, h = (y1 - y0 + 1) * S;
+            if (w < 1 || h < 1)
+                w = h = 1;
+            if (!m_dstCopyTex || m_dstCopyW < w || m_dstCopyH < h)
+            {
+                if (m_dstCopyTex)
+                {
+                    glDeleteTextures(1, &m_dstCopyTex);
+                    glDeleteFramebuffers(1, &m_dstCopyFbo);
+                }
+                m_dstCopyW = std::max(w, m_dstCopyW);
+                m_dstCopyH = std::max(h, m_dstCopyH);
+                m_dstCopyTex = newTex(m_dstCopyW, m_dstCopyH, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE);
+                glGenFramebuffers(1, &m_dstCopyFbo);
+                glBindFramebuffer(GL_FRAMEBUFFER, m_dstCopyFbo);
+                glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_dstCopyTex, 0);
+            }
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, rt.fbo);
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_dstCopyFbo);
+            glDisable(GL_SCISSOR_TEST);
+            glBlitFramebuffer(x0 * S, y0 * S, x0 * S + w, y0 * S + h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            glBindFramebuffer(GL_FRAMEBUFFER, rt.fbo);
+            glEnable(GL_SCISSOR_TEST);
+            glActiveTexture(GL_TEXTURE1);
+            glBindTexture(GL_TEXTURE_2D, m_dstCopyTex);
+            glUniform2f(u_dstoff, static_cast<float>(x0 * S), static_cast<float>(y0 * S));
+        }
+        glActiveTexture(GL_TEXTURE0);
+        ++m_stDstReads;
+    }
+    void applyAndDraw(DrawState &s)
+    {
+        Target &rt = *s.rt;
+        glBindFramebuffer(GL_FRAMEBUFFER, rt.fbo);
+        attachZ(rt, s.zb);
+        const int S = m_scale;
+        glViewport(0, 0, rt.w * S, rt.h * S);
+        glUseProgram(m_prog);
+        glUniform1i(u_tex, 0);
+        glUniform1i(u_dst, 1);
+        glUniform4f(u_vp, 2.0f / rt.w, 2.0f / rt.h, 1.0f / 4294967296.0f, 0);
+        glUniform4i(u_mode, s.mode[0], s.mode[1], s.mode[2], s.mode[3]);
+        glUniform4i(u_atst, s.atst[0], s.atst[1], s.atst[2], s.atst[3]);
+        glUniform4i(u_blend, s.blend[0], s.blend[1], s.blend[2], s.blend[3]);
+        glUniform4i(u_misc, s.misc[0], s.misc[1], s.misc[2], s.misc[3]);
+        glUniform1f(u_fix, s.fix);
+        glUniform4i(u_fog, s.fog[0], s.fog[1], s.fog[2], s.fog[3]);
+        glEnable(GL_SCISSOR_TEST);
+        glScissor(s.scx0 * S, s.scy0 * S, (s.scx1 - s.scx0 + 1) * S, (s.scy1 - s.scy0 + 1) * S);
+        if (s.depthTest)
+        {
+            glEnable(GL_DEPTH_TEST);
+            glDepthFunc(static_cast<GLenum>(s.depthFunc));
+        }
+        else
+            glDisable(GL_DEPTH_TEST);
+        glDepthMask(s.depthWrite ? 1 : 0);
+        glColorMask(static_cast<GLboolean>(s.cmask[0]), static_cast<GLboolean>(s.cmask[1]), static_cast<GLboolean>(s.cmask[2]), static_cast<GLboolean>(s.cmask[3]));
+        if (s.blOn)
+        {
+            glEnable(GL_BLEND);
+            glBlendEquationSeparate(static_cast<GLenum>(s.blEq), GL_FUNC_ADD);
+            glBlendFuncSeparate(static_cast<GLenum>(s.blSf), static_cast<GLenum>(s.blDf), GL_ONE, GL_ZERO);
+        }
+        else
+            glDisable(GL_BLEND);
+        glActiveTexture(GL_TEXTURE0);
+        if (s.mode[0])
+        {
+            glBindTexture(GL_TEXTURE_2D, s.tex);
+            const GLint f = s.bilinear ? GL_LINEAR : GL_NEAREST;
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, f);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, f);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, s.wms == 0 ? GL_REPEAT : GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, s.wmt == 0 ? GL_REPEAT : GL_CLAMP_TO_EDGE);
+        }
+        if (s.needDst)
+            bindDst(s, std::max(m_bx0, 0), std::max(m_by0, 0), std::min(m_bx1, rt.w - 1), std::min(m_by1, rt.h - 1));
+        glBindBuffer(GL_ARRAY_BUFFER, m_vbo);
+        glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizeiptr>(m_v.size() * sizeof(Vert)), m_v.data(), GL_STREAM_DRAW);
+        glEnableVertexAttribArray(0);
+        glVertexAttribPointer(0, 4, GL_FLOAT, 0, sizeof(Vert), reinterpret_cast<void *>(0));
+        glEnableVertexAttribArray(1);
+        glVertexAttribPointer(1, 4, GL_FLOAT, 0, sizeof(Vert), reinterpret_cast<void *>(16));
+        glEnableVertexAttribArray(2);
+        glVertexAttribPointer(2, 4, GL_FLOAT, 0, sizeof(Vert), reinterpret_cast<void *>(32));
+        glDrawArrays(GL_TRIANGLES, 0, static_cast<GLsizei>(m_v.size()));
+        if (s.pass2)
+        {
+            // AFAIL: the pixels that failed the alpha test, with the reduced write mask
+            glUniform4i(u_atst, s.atst[0], s.atst[1], 1, s.atst[3]);
+            const int af = s.pass2; // 1 FB_ONLY, 2 ZB_ONLY, 3 RGB_ONLY
+            glColorMask(static_cast<GLboolean>(af != 2 && s.cmask[0]), static_cast<GLboolean>(af != 2 && s.cmask[1]),
+                        static_cast<GLboolean>(af != 2 && s.cmask[2]), static_cast<GLboolean>(af == 1 && s.cmask[3]));
+            glDepthMask(af == 2 && s.depthWrite ? 1 : 0);
+            glDrawArrays(GL_TRIANGLES, 0, static_cast<GLsizei>(m_v.size()));
+        }
+        const int x0 = std::max(m_bx0, s.scx0), y0 = std::max(m_by0, s.scy0);
+        const int x1 = std::min(m_bx1, s.scx1), y1 = std::min(m_by1, s.scy1);
+        if (s.cmask[0] || s.cmask[1] || s.cmask[2] || s.cmask[3])
+            mark(rt, x0, y0, x1, y1);
+        ++m_stBatches;
+    }
+    void flush()
+    {
+        m_ndb = 0;
+        if (m_v.empty())
+            return;
+        applyAndDraw(m_cur);
+        m_v.clear();
+        m_bx0 = m_by0 = 1 << 20;
+        m_bx1 = m_by1 = -(1 << 20);
+    }
+
+    // GS state -> batch state (PAL's hw_state_from)
+    void stateFrom(const GSDrawState &st, DrawState &s, Target *rt, Depth *zb, GLuint tex, int texRt)
+    {
+        s = DrawState{};
+        const auto &c = st.context;
+        s.rt = rt;
+        s.zb = zb;
+        s.scx0 = c.scissor.x0;
+        s.scy0 = c.scissor.y0;
+        s.scx1 = std::min<int>(c.scissor.x1, rt->w - 1);
+        s.scy1 = std::min<int>(c.scissor.y1, rt->h - 1);
+        const int tme = st.prim.tme ? 1 : 0;
+        s.mode[0] = tme;
+        s.mode[1] = tme ? c.tex0.tfx : 0;
+        s.mode[2] = tme ? c.tex0.tcc : 0;
+        s.mode[3] = st.prim.iip ? 1 : 0;
+        if (tme)
+        {
+            s.tex = tex;
+            s.texRt = texRt;
+            s.bilinear = st.linearFilter ? 1 : 0;
+            s.wms = static_cast<int>(c.clamp & 1u);
+            s.wmt = static_cast<int>((c.clamp >> 2) & 1u);
+        }
+        const uint64_t test = c.test;
+        const int ate = static_cast<int>(test & 1u), atst = static_cast<int>((test >> 1) & 7u), aref = static_cast<int>((test >> 4) & 0xFFu);
+        const int afail = static_cast<int>((test >> 12) & 3u), date = static_cast<int>((test >> 14) & 1u), datm = static_cast<int>((test >> 15) & 1u);
+        const int zte = static_cast<int>((test >> 16) & 1u), ztst = static_cast<int>((test >> 17) & 3u);
+        const bool zwrite = !c.zbuf.zmask;
+        s.depthTest = zb && zte && ztst >= 2;
+        s.depthFunc = ztst == 3 ? static_cast<int>(GL_GREATER) : static_cast<int>(GL_GEQUAL);
+        s.depthWrite = zb && zwrite;
+        if (zb && zte && ztst == 1)
+        {
+            s.depthTest = 1;
+            s.depthFunc = static_cast<int>(GL_ALWAYS);
+        }
+        const uint32_t m = c.frame.fbmsk;
+        if (rt->is16)
+        {
+            s.cmask[0] = !(m & 0xf8u);
+            s.cmask[1] = !(m & 0xf800u);
+            s.cmask[2] = !(m & 0xf80000u);
+            s.cmask[3] = !(m & 0x80000000u);
+        }
+        else
+        {
+            s.cmask[0] = (m & 0xffu) != 0xffu;
+            s.cmask[1] = (m & 0xff00u) != 0xff00u;
+            s.cmask[2] = (m & 0xff0000u) != 0xff0000u;
+            s.cmask[3] = (m & 0xff000000u) != 0xff000000u;
+        }
+        if (c.frame.psm == GS_PSM_CT24)
+            s.cmask[3] = 0;
+        s.atst[0] = ate ? atst : 8;
+        s.atst[1] = aref;
+        s.atst[2] = 0;
+        if (ate && afail != 0)
+        {
+            if (atst == 0)
+            {
+                // NEVER + AFAIL: a pure write mask
+                s.atst[0] = 8;
+                if (afail == 1)
+                    s.depthWrite = 0;
+                else if (afail == 2)
+                    s.cmask[0] = s.cmask[1] = s.cmask[2] = s.cmask[3] = 0;
+                else
+                {
+                    s.cmask[3] = 0;
+                    s.depthWrite = 0;
+                }
+            }
+            else if (atst != 1)
+                s.pass2 = afail; // first pass: passing pixels, full write
+            else
+                s.atst[0] = 8;
+        }
+        s.atst[3] = date ? 1 + datm : 0;
+        s.misc[0] = static_cast<int>(c.fba & 1u);
+        s.misc[3] = static_cast<int>(st.colclamp & 1u);
+        if (st.prim.fge)
+        {
+            s.fog[0] = 1;
+            s.fog[1] = st.fogR;
+            s.fog[2] = st.fogG;
+            s.fog[3] = st.fogB;
+        }
+        const uint64_t alpha = c.alpha;
+        const int A = static_cast<int>(alpha & 3u), B = static_cast<int>((alpha >> 2) & 3u), C = static_cast<int>((alpha >> 4) & 3u), D = static_cast<int>((alpha >> 6) & 3u);
+        const int fix = static_cast<int>((alpha >> 32) & 0xFFu);
+        s.fix = static_cast<float>(fix);
+        int shader = 0;
+        if (st.prim.abe)
+        {
+            if (A == B)
+            {
+                if (D == 0)
+                {
+                }
+                else if (D == 1)
+                {
+                    s.blOn = 1;
+                    s.blEq = GL_FUNC_ADD;
+                    s.blSf = GL_ZERO;
+                    s.blDf = GL_ONE;
+                }
+                else
+                {
+                    s.blOn = 1;
+                    s.blEq = GL_FUNC_ADD;
+                    s.blSf = GL_ZERO;
+                    s.blDf = GL_ZERO;
+                }
+            }
+            else if (C == 1 || (C == 2 && fix > 128))
+                shader = 1;
+            else
+            {
+                const int fsrc = C == 2 ? 1 : 0;
+                s.misc[2] = fsrc;
+                const int F = GL_SRC1_ALPHA, IF = GL_ONE_MINUS_SRC1_ALPHA;
+                s.blOn = 1;
+                if (A == 0 && B == 1 && D == 1)
+                {
+                    s.blEq = GL_FUNC_ADD;
+                    s.blSf = F;
+                    s.blDf = IF;
+                }
+                else if (A == 0 && B == 1 && D == 2)
+                {
+                    s.blEq = GL_FUNC_SUBTRACT;
+                    s.blSf = F;
+                    s.blDf = F;
+                }
+                else if (A == 0 && B == 2 && D == 1)
+                {
+                    s.blEq = GL_FUNC_ADD;
+                    s.blSf = fsrc ? F : GL_ONE;
+                    s.blDf = GL_ONE;
+                    if (!fsrc)
+                        s.misc[2] = 3;
+                }
+                else if (A == 0 && B == 2 && D == 2)
+                {
+                    s.blEq = GL_FUNC_ADD;
+                    s.blSf = fsrc ? F : GL_ONE;
+                    s.blDf = GL_ZERO;
+                    if (!fsrc)
+                        s.misc[2] = 3;
+                }
+                else if (A == 1 && B == 0 && D == 0)
+                {
+                    s.blEq = GL_FUNC_ADD;
+                    s.blSf = IF;
+                    s.blDf = F;
+                }
+                else if (A == 1 && B == 0 && D == 2)
+                {
+                    s.blEq = GL_FUNC_REVERSE_SUBTRACT;
+                    s.blSf = F;
+                    s.blDf = F;
+                }
+                else if (A == 2 && B == 0 && D == 1)
+                {
+                    s.blEq = GL_FUNC_REVERSE_SUBTRACT;
+                    s.blSf = fsrc ? F : GL_ONE;
+                    s.blDf = GL_ONE;
+                    if (!fsrc)
+                        s.misc[2] = 3;
+                }
+                else if (A == 2 && B == 1 && D == 0)
+                {
+                    s.blEq = GL_FUNC_SUBTRACT;
+                    s.blSf = GL_ONE;
+                    s.blDf = F;
+                }
+                else if (A == 1 && B == 2 && D == 0)
+                {
+                    s.blEq = GL_FUNC_ADD;
+                    s.blSf = GL_ONE;
+                    s.blDf = F;
+                }
+                else if (A == 1 && B == 2 && D == 2)
+                {
+                    s.blEq = GL_FUNC_ADD;
+                    s.blSf = GL_ZERO;
+                    s.blDf = F;
+                }
+                else if (A == 2 && B == 1 && D == 1)
+                {
+                    s.blEq = GL_FUNC_ADD;
+                    s.blSf = GL_ZERO;
+                    s.blDf = IF;
+                }
+                else if (A == 1 && B == 2 && D == 1 && C == 0)
+                {
+                    s.blEq = GL_FUNC_ADD;
+                    s.blSf = GL_DST_COLOR;
+                    s.blDf = GL_ONE;
+                    s.misc[2] = 2;
+                }
+                else if (A == 2 && B == 0 && D == 2)
+                {
+                    s.blEq = GL_FUNC_ADD;
+                    s.blSf = GL_ZERO;
+                    s.blDf = GL_ZERO;
+                }
