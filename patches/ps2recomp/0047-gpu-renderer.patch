+// ------------------------------------------------------------------ the backend
+using namespace ape2gl;
+
+class GSGlBackend final : public GSRasterBackend
+{
+public:
+    GSGlBackend() : m_cpu(std::make_unique<GSCpuBackend>()) {}
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override { m_cpu->Initialize(vram, vramSize); }
+    void Reset() override
+    {
+        if (onGl())
+            dropTargets();
+        m_cpu->Reset();
+    }
+
+    void Submit(const GSPrimitiveBatch &batch) override
+    {
+        if (!ensureInit())
+        {
+            m_cpu->Submit(batch);
+            return;
+        }
+        prim(batch);
+    }
+
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override
+    {
+        if (onGl())
+            syncRange(tex0.cbp, 8u, "clut");
+        m_cpu->LoadClut(tex0, texclut);
+    }
+
+    void BeginTransfer(const GSTransferCommand &command) override
+    {
+        if (onGl())
+        {
+            const auto &b = command.bitbltbuf;
+            const auto &p = command.trxpos;
+            const auto &r = command.trxreg;
+            if (command.direction == 0u || command.direction == 2u)
+            {
+                // the destination's drawing goes back to VRAM before it is (partly) overwritten
+                syncRange(b.dbp, transferBlocks(b.dbw, b.dpsm, p.dsay, r.rrw, r.rrh), "transfer destination");
+            }
+            if (command.direction == 1u || command.direction == 2u)
+                syncRange(b.sbp, transferBlocks(b.sbw, b.spsm, p.ssay, r.rrw, r.rrh), "transfer source");
+        }
+        m_cpu->BeginTransfer(command);
+        if (onGl())
+        {
+            if (command.direction == 0u)
+            {
+                m_upload = command;
+                m_uploadActive = true;
+            }
+            else if (command.direction == 2u)
+                vramWritten(command.bitbltbuf.dbp, command.bitbltbuf.dbw, command.bitbltbuf.dpsm, command.trxpos.dsax,
+                            command.trxpos.dsay, command.trxreg.rrw, command.trxreg.rrh);
+        }
+    }
+
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override
+    {
+        m_cpu->UploadImage(data, sizeBytes);
+        if (onGl() && m_uploadActive)
+        {
+            const GSTransferSnapshot snap = m_cpu->GetTransferSnapshot();
+            if (snap.copiedPixels >= snap.totalPixels)
+            {
+                m_uploadActive = false;
+                vramWritten(m_upload.bitbltbuf.dbp, m_upload.bitbltbuf.dbw, m_upload.bitbltbuf.dpsm, m_upload.trxpos.dsax,
+                            m_upload.trxpos.dsay, m_upload.trxreg.rrw, m_upload.trxreg.rrh);
+            }
+        }
+    }
+
+    void Flush() override
+    {
+        if (onGl())
+            flush();
+        m_cpu->Flush();
+    }
+    void TextureFlush() override { m_cpu->TextureFlush(); }
+    void Sync(GSSyncReason reason) override
+    {
+        if (onGl())
+            flush();
+        m_cpu->Sync(reason);
+    }
+    PresentationFrame Present(const GSPresentationRequest &request) override { return m_cpu->Present(request); }
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override
+    {
+        if (onGl())
+            syncRange(GSInternal::framePageBaseToBlock(context.frame.fbp), 2048u, "clear");
+        const bool done = m_cpu->ClearFramebuffer(context, rgba);
+        if (onGl())
+            vramWritten(GSInternal::framePageBaseToBlock(context.frame.fbp), context.frame.fbw, context.frame.psm, 0,
+                        0, static_cast<int>(context.frame.fbw) * 64, context.scissor.y1 + 1);
+        return done;
+    }
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override { return m_cpu->ConsumeLocalToHostBytes(dst, maxBytes); }
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override { return m_cpu->ReadVram(psm, base, bw, x, y); }
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override { m_cpu->WriteVram(psm, base, bw, x, y, value); }
+    void SnapshotVram(std::vector<uint8_t> &out) const override { m_cpu->SnapshotVram(out); }
+    GSTransferSnapshot GetTransferSnapshot() const override { return m_cpu->GetTransferSnapshot(); }
+
+    // GS thread: the game swapped buffers / a vsync passed: the displayed buffers' drawing goes to VRAM
+    void Display(uint64_t pmode, uint64_t dispfb1, uint64_t dispfb2)
+    {
+        if (!onGl())
+            return;
+        for (int n = 0; n < 2; ++n)
+        {
+            if (!(pmode & (1ull << n)))
+                continue;
+            const uint64_t fb = n ? dispfb2 : dispfb1;
+            const uint32_t fbp = static_cast<uint32_t>(fb & 0x1FFu) * 32u, fbw = static_cast<uint32_t>((fb >> 9) & 0x3Fu);
+            const uint32_t psm = static_cast<uint32_t>((fb >> 15) & 0x1Fu);
+            if (Target *rt = findTarget(fbp, fbw, is16(psm)))
+                if (rt->gpuDirty)
+                {
+                    flush();
+                    download(*rt);
+                }
+        }
+        if (++m_frames % 600u == 0u)
+        {
+            std::fprintf(stderr, "[gpu] last 600 displays: %llu prims in %llu draws, %llu destination reads, %llu read-backs (%llu for display), %llu target uploads, %llu texture uploads\n",
+                         static_cast<unsigned long long>(m_stDraws), static_cast<unsigned long long>(m_stBatches),
+                         static_cast<unsigned long long>(m_stDstReads), static_cast<unsigned long long>(m_stDownloads),
+                         static_cast<unsigned long long>(m_stDisplayDownloads), static_cast<unsigned long long>(m_stUploads),
+                         static_cast<unsigned long long>(m_stTexUploads));
+            m_stDraws = m_stBatches = m_stDstReads = m_stDownloads = m_stDisplayDownloads = m_stUploads = m_stTexUploads = 0;
+        }
+    }
+
+private:
+    // ---------------------------------------------------------------- state
+    struct Target
+    {
+        bool used = false;
+        uint32_t fbp = 0, fbw = 0; // fbp in 256-byte blocks
+        bool is16 = false;
+        int w = 0, h = 0; // native size of the GL texture
+        int vh = 0;       // rows in use (whole VRAM pages)
+        GLuint tex = 0, fbo = 0;
+        GLuint ztex = 0;
+        bool gpuDirty = false;
+        int dx0 = 0, dy0 = 0, dx1 = 0, dy1 = 0;
+        uint64_t lru = 0;
+    };
+    struct Depth
+    {
+        bool used = false;
+        uint32_t zbp = 0;
+        int w = 0, h = 0;
+        GLuint tex = 0;
+        uint64_t lru = 0;
+    };
+    struct DrawState
+    {
+        Target *rt = nullptr;
+        Depth *zb = nullptr;
+        GLuint tex = 0;
+        int texRt = 0, bilinear = 0, wms = 0, wmt = 0;
+        int mode[4] = {}, atst[4] = {}, blend[4] = {}, misc[4] = {}, fog[4] = {};
+        float fix = 0.0f;
+        int depthFunc = 0, depthWrite = 0, depthTest = 0;
+        int cmask[4] = {};
+        int blOn = 0, blEq = 0, blSf = 0, blDf = 0;
+        int needDst = 0;
+        int scx0 = 0, scy0 = 0, scx1 = 0, scy1 = 0;
+        int pass2 = 0;
+        bool operator==(const DrawState &o) const { return std::memcmp(this, &o, sizeof *this) == 0; }
+    };
+    struct Vert
+    {
+        float x, y, z, f;
+        float r, g, b, a;
+        float s, t, q, pad;
+    };
+    static constexpr int kTargets = 16;
+    static constexpr size_t kMaxVerts = 65536;
+    static constexpr int kMaxDstBoxes = 256;
+
+    std::unique_ptr<GSCpuBackend> m_cpu;
+    bool m_inited = false, m_failed = false;
+    std::thread::id m_glThread{};
+    int m_scale = 1;
