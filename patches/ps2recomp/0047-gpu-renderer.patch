+        m_inited = true;
+        m_glThread = std::this_thread::get_id();
+        if (!g_gsGlWindow)
+        {
+            std::fprintf(stderr, "[gpu] no GL context for the GS thread; using the software renderer\n");
+            m_failed = true;
+            return false;
+        }
+        glfwMakeContextCurrent(g_gsGlWindow);
+        if (!ape2gl::load())
+        {
+            std::fprintf(stderr, "[gpu] OpenGL functions missing; using the software renderer\n");
+            m_failed = true;
+            return false;
+        }
+        m_prog = compile(kVs, kFs, "gs");
+        m_progCopy = compile(kVsCopy, kFsCopy, "gs-copy");
+        if (!m_prog || !m_progCopy)
+        {
+            std::fprintf(stderr, "[gpu] shader setup failed; using the software renderer\n");
+            m_failed = true;
+            return false;
+        }
+        u_tex = glGetUniformLocation(m_prog, "u_tex");
+        u_dst = glGetUniformLocation(m_prog, "u_dst");
+        u_vp = glGetUniformLocation(m_prog, "u_vp");
+        u_mode = glGetUniformLocation(m_prog, "u_mode");
+        u_atst = glGetUniformLocation(m_prog, "u_atst");
+        u_blend = glGetUniformLocation(m_prog, "u_blend");
+        u_misc = glGetUniformLocation(m_prog, "u_misc");
+        u_dstoff = glGetUniformLocation(m_prog, "u_dstoff");
+        u_fix = glGetUniformLocation(m_prog, "u_fix");
+        u_fog = glGetUniformLocation(m_prog, "u_fog");
+        uc_tex = glGetUniformLocation(m_progCopy, "u_tex");
