+                glDeleteTextures(1, &m_dnTex);
+                glDeleteFramebuffers(1, &m_dnFbo);
+            }
+            m_dnTex = newTex(w, h, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE);
+            m_dnW = w;
+            m_dnH = h;
+            glGenFramebuffers(1, &m_dnFbo);
+            glBindFramebuffer(GL_FRAMEBUFFER, m_dnFbo);
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_dnTex, 0);
