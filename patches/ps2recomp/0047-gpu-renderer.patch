+    constexpr GLenum GL_TRIANGLES = 0x0004, GL_TRIANGLE_STRIP = 0x0005;
+    constexpr GLenum GL_ZERO = 0, GL_ONE = 1, GL_DST_COLOR = 0x0306;
+    constexpr GLenum GL_SRC1_ALPHA = 0x8589, GL_ONE_MINUS_SRC1_ALPHA = 0x88FB;
+    constexpr GLenum GL_FUNC_ADD = 0x8006, GL_FUNC_SUBTRACT = 0x800A, GL_FUNC_REVERSE_SUBTRACT = 0x800B;
+    constexpr GLenum GL_GREATER = 0x0204, GL_GEQUAL = 0x0206, GL_ALWAYS = 0x0207;
+    constexpr GLenum GL_DEPTH_TEST = 0x0B71, GL_BLEND = 0x0BE2, GL_SCISSOR_TEST = 0x0C11, GL_CULL_FACE = 0x0B44;
+    constexpr GLenum GL_UNPACK_ALIGNMENT = 0x0CF5, GL_PACK_ALIGNMENT = 0x0D05;
+    constexpr GLenum GL_TEXTURE_2D = 0x0DE1, GL_UNSIGNED_BYTE = 0x1401, GL_FLOAT = 0x1406;
+    constexpr GLenum GL_RGBA = 0x1908, GL_RGBA8 = 0x8058, GL_DEPTH_COMPONENT = 0x1902, GL_DEPTH_COMPONENT32F = 0x8CAC;
+    constexpr GLenum GL_NEAREST = 0x2600, GL_LINEAR = 0x2601;
+    constexpr GLenum GL_TEXTURE_MAG_FILTER = 0x2800, GL_TEXTURE_MIN_FILTER = 0x2801, GL_TEXTURE_WRAP_S = 0x2802, GL_TEXTURE_WRAP_T = 0x2803;
+    constexpr GLenum GL_CLAMP_TO_EDGE = 0x812F, GL_REPEAT = 0x2901;
+    constexpr GLenum GL_TEXTURE0 = 0x84C0, GL_TEXTURE1 = 0x84C1;
+    constexpr GLenum GL_ARRAY_BUFFER = 0x8892, GL_STREAM_DRAW = 0x88E0;
+    constexpr GLenum GL_FRAGMENT_SHADER = 0x8B30, GL_VERTEX_SHADER = 0x8B31, GL_COMPILE_STATUS = 0x8B81, GL_LINK_STATUS = 0x8B82;
+    constexpr GLenum GL_FRAMEBUFFER = 0x8D40, GL_READ_FRAMEBUFFER = 0x8CA8, GL_DRAW_FRAMEBUFFER = 0x8CA9;
