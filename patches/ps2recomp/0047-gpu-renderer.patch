+#include <memory>
+void ape2CreateGsGlContext() {}
+std::unique_ptr<GSRasterBackend> ape2MakeRasterBackend() { return std::make_unique<GSCpuBackend>(); }
+void ape2GsGlDisplay(GSRasterBackend *, uint64_t, uint64_t, uint64_t) {}
+
+#endif
