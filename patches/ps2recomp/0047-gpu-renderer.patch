+    }
+    // the drawn part of a target back into VRAM (downscaled, point sampled)
+    void download(Target &rt)
+    {
+        if (!rt.gpuDirty)
+            return;
+        const int w = rt.w, h = rt.h;
+        if (!m_dnTex || m_dnW != w || m_dnH != h)
+        {
+            if (m_dnTex)
