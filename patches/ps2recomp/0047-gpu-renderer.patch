+    // ---------------------------------------------------------------- VRAM <-> GPU
+    void vramReadRgba(uint32_t bp, uint32_t bw, uint32_t psm, int x0, int y0, int w, int h, std::vector<uint32_t> &out)
+    {
+        out.resize(static_cast<size_t>(w) * static_cast<size_t>(h));
+        std::lock_guard<std::mutex> lock(m_cpu->m_mutex);
+        for (int y = 0; y < h; ++y)
+            for (int x = 0; x < w; ++x)
+            {
+                uint32_t c = m_cpu->ReadVramUnlocked(psm, bp, bw, static_cast<uint32_t>(x0 + x) & 2047u, static_cast<uint32_t>(y0 + y) & 2047u);
+                if (is16(psm))
+                    c = ((c & 0x1fu) << 3) | (((c >> 5) & 0x1fu) << 11) | (((c >> 10) & 0x1fu) << 19) | ((c & 0x8000u) ? 0x80000000u : 0u);
+                else if (psm == GS_PSM_CT24)
+                    c |= 0x80000000u;
+                out[static_cast<size_t>(y) * static_cast<size_t>(w) + static_cast<size_t>(x)] = c;
+            }
+    }
+    void uploadRect(Target &rt, int x0, int y0, int w, int h, const uint32_t *px)
+    {
+        if (!m_upTex || m_upW < w || m_upH < h)
+        {
+            if (m_upTex)
+                glDeleteTextures(1, &m_upTex);
+            m_upW = std::max(w, m_upW);
+            m_upH = std::max(h, m_upH);
+            m_upTex = newTex(m_upW, m_upH, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE);
+        }
+        glBindTexture(GL_TEXTURE_2D, m_upTex);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, px);
+        glBindFramebuffer(GL_FRAMEBUFFER, rt.fbo);
+        glViewport(0, 0, rt.w * m_scale, rt.h * m_scale);
+        plainState();
+        const float X0 = 2.0f * x0 / rt.w - 1, X1 = 2.0f * (x0 + w) / rt.w - 1, Y0 = 2.0f * y0 / rt.h - 1, Y1 = 2.0f * (y0 + h) / rt.h - 1;
+        quad(m_upTex, X0, Y0, X1, Y1, 0, 0, static_cast<float>(w) / m_upW, static_cast<float>(h) / m_upH, false);
