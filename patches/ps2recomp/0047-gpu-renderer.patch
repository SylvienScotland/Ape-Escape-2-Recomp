+            s.blend[0] = 1;
+            s.blend[1] = A * 16 + B * 4 + D;
+            s.blend[2] = C;
+            s.misc[1] = st.pabe ? 1 : 0;
+            s.misc[2] = 0;
+        }
+        s.needDst = shader || date;
+    }
+
+    // ---------------------------------------------------------------- primitives
+    void vert(const GSVertex &v, const GSVertex &col, float x, float y, bool tme, bool fst, float zf, float fog)
+    {
+        Vert o{};
+        o.x = x;
+        o.y = y;
+        o.z = zf;
+        o.f = fog;
+        o.r = col.r;
+        o.g = col.g;
+        o.b = col.b;
+        o.a = col.a;
+        if (tme)
+        {
+            if (fst)
+            {
+                o.s = static_cast<float>(v.u) * m_fu;
+                o.t = static_cast<float>(v.v) * m_fv;
+                o.q = 1.0f;
+            }
+            else
+            {
+                o.s = v.s * m_su;
+                o.t = v.t * m_sv;
+                o.q = v.q;
+            }
+        }
+        else
+        {
+            o.s = o.t = 0;
+            o.q = 1;
+        }
+        m_v.push_back(o);
+    }
+
+    void prim(const GSPrimitiveBatch &batch)
+    {
+        const GSDrawState &st = batch.state;
+        const auto &c = st.context;
+        const uint64_t test = c.test;
+        const int zte = static_cast<int>((test >> 16) & 1u), ztst = static_cast<int>((test >> 17) & 3u);
+        if (zte && ztst == 0)
+            return; // depth test NEVER
+        const GSPrimType type = st.prim.type;
+        const int nv = batch.vertexCount;
+        if (nv == 0)
+            return;
+        const float ofx = static_cast<float>(c.xyoffset.ofx >> 4), ofy = static_cast<float>(c.xyoffset.ofy >> 4);
+        float px[3], py[3];
+        for (int i = 0; i < nv; ++i)
+        {
+            px[i] = batch.vertices[i].x - ofx;
+            py[i] = batch.vertices[i].y - ofy;
+        }
+        float fx0 = px[0], fx1 = px[0], fy0 = py[0], fy1 = py[0];
+        for (int i = 1; i < nv; ++i)
+        {
+            fx0 = std::min(fx0, px[i]);
+            fx1 = std::max(fx1, px[i]);
+            fy0 = std::min(fy0, py[i]);
+            fy1 = std::max(fy1, py[i]);
+        }
+        int bx0 = std::max(static_cast<int>(std::floor(fx0)), static_cast<int>(c.scissor.x0));
+        int by0 = std::max(static_cast<int>(std::floor(fy0)), static_cast<int>(c.scissor.y0));
+        int bx1 = std::min(static_cast<int>(std::ceil(fx1)), static_cast<int>(c.scissor.x1));
+        int by1 = std::min(static_cast<int>(std::ceil(fy1)), static_cast<int>(c.scissor.y1));
+        if (bx1 < bx0 || by1 < by0)
+            return;
+
+        // target and depth
+        const bool sixteen = is16(c.frame.psm);
+        Target *rt = getTarget(GSInternal::framePageBaseToBlock(c.frame.fbp), c.frame.fbw, sixteen, by1 + 1);
+        Depth *zb = nullptr;
+        const bool zwrite = !c.zbuf.zmask;
+        if (zte && (ztst >= 2 || zwrite || ztst == 1))
+            zb = getDepth(GSInternal::framePageBaseToBlock(c.zbuf.zbp), rt->w, rt->h);
+        // texture
+        GLuint tex = 0;
+        int texRt = 0, tw = 1, th = 1;
+        const bool tme = st.prim.tme;
+        if (tme)
+        {
+            tw = std::max<int>(1, st.textureWidth);
+            th = std::max<int>(1, st.textureHeight);
+            m_fu = 1.0f / (16.0f * tw);
+            m_fv = 1.0f / (16.0f * th);
+            m_su = m_sv = 1.0f;
+            if (Target *src = texTarget(c.tex0))
+            {
+                tex = src->tex;
+                texRt = 1;
+                m_fu = 1.0f / (16.0f * src->w);
+                m_fv = 1.0f / (16.0f * src->h);
+                m_su = static_cast<float>(tw) / src->w;
+                m_sv = static_cast<float>(th) / src->h;
+            }
+            else
+            {
+                syncRange(c.tex0.tbp0, texBlocks(c.tex0), "texture");
+                int dw = tw, dh = th;
+                tex = cpuTexture(st, dw, dh);
+            }
+        }
+        DrawState s;
+        stateFrom(st, s, rt, zb, tex, texRt);
+        if (tme && !tex)
+            s.mode[0] = 0;
+        // a target sampled while drawing into itself: draw from a snapshot of it
+        if (s.texRt && tex == rt->tex)
+        {
+            const int W = rt->w * m_scale, H = rt->h * m_scale;
+            flush();
+            if (!m_snapTex || m_snapW != W || m_snapH != H)
+            {
+                if (m_snapTex)
+                {
+                    glDeleteTextures(1, &m_snapTex);
+                    glDeleteFramebuffers(1, &m_snapFbo);
+                }
+                m_snapTex = newTex(W, H, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE);
+                m_snapW = W;
+                m_snapH = H;
+                glGenFramebuffers(1, &m_snapFbo);
+                glBindFramebuffer(GL_FRAMEBUFFER, m_snapFbo);
+                glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_snapTex, 0);
+            }
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, rt->fbo);
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_snapFbo);
+            glDisable(GL_SCISSOR_TEST);
+            glBlitFramebuffer(0, 0, W, H, 0, 0, W, H, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            s.tex = m_snapTex;
+        }
+        // primitives that read the destination can share a draw only if they don't overlap
+        bool dstConflict = false;
+        if (s.needDst && !m_v.empty())
+        {
+            if (m_ndb >= kMaxDstBoxes)
+                dstConflict = true;
+            else
+                for (int i = 0; i < m_ndb; ++i)
+                    if (bx0 <= m_db[i][2] && m_db[i][0] <= bx1 && by0 <= m_db[i][3] && m_db[i][1] <= by1)
+                    {
+                        dstConflict = true;
+                        break;
+                    }
+        }
+        if (!m_haveCur || !(s == m_cur) || m_v.size() + 6 > kMaxVerts || dstConflict)
+        {
+            flush();
+            m_cur = s;
+            m_haveCur = true;
+        }
+        if (s.needDst)
+        {
+            m_db[m_ndb][0] = bx0;
+            m_db[m_ndb][1] = by0;
+            m_db[m_ndb][2] = bx1;
+            m_db[m_ndb][3] = by1;
+            ++m_ndb;
+        }
+        m_bx0 = std::min(m_bx0, bx0);
+        m_by0 = std::min(m_by0, by0);
+        m_bx1 = std::max(m_bx1, bx1);
+        m_by1 = std::max(m_by1, by1);
+
+        const bool fst = st.prim.fst;
+        const double zmax = c.zbuf.psm == GS_PSM_Z16 || c.zbuf.psm == GS_PSM_Z16S ? 65535.0 : c.zbuf.psm == GS_PSM_Z24 ? 16777215.0 : 4294967295.0;
+        auto zOf = [zmax](const GSVertex &v)
+        { return static_cast<float>(std::min(v.z, zmax)); };
+        const GSVertex *vx = batch.vertices.data();
+        switch (type)
+        {
+        case GS_PRIM_TRIANGLE:
+        case GS_PRIM_TRISTRIP:
+        case GS_PRIM_TRIFAN:
+        {
+            if (nv < 3)
+                return;
+            const bool flat = !st.prim.iip;
+            for (int i = 0; i < 3; ++i)
+                vert(vx[i], flat ? vx[2] : vx[i], px[i], py[i], tme, fst, zOf(vx[i]), static_cast<float>(vx[i].fog));
+            break;
+        }
+        case GS_PRIM_SPRITE:
+        {
+            if (nv < 2)
+                return;
+            // corners from the two vertices; colour, Z, Q and fog of the second
+            const GSVertex &a = vx[0], &b = vx[1];
+            GSVertex v[4] = {a, b, b, b};
+            v[1].v = a.v;
+            v[1].t = a.t;
+            v[2].u = a.u;
+            v[2].s = a.s;
+            float xs[4] = {px[0], px[1], px[0], px[1]}, ys[4] = {py[0], py[0], py[1], py[1]};
+            v[0].q = b.q;
+            const float zf = zOf(b);
+            static const int idx[6] = {0, 1, 2, 1, 3, 2};
+            for (int i = 0; i < 6; ++i)
+            {
+                GSVertex t = v[idx[i]];
+                t.q = b.q;
+                vert(t, b, xs[idx[i]], ys[idx[i]], tme, fst, zf, static_cast<float>(b.fog));
+            }
+            break;
+        }
+        case GS_PRIM_LINE:
+        case GS_PRIM_LINESTRIP:
+        {
+            if (nv < 2)
+                return;
+            // a thin quad one native pixel wide
+            const float dx = px[1] - px[0], dy = py[1] - py[0];
+            const bool horiz = std::fabs(dx) >= std::fabs(dy);
+            float xs[4] = {px[0], px[0], px[1], px[1]}, ys[4] = {py[0], py[0], py[1], py[1]};
+            if (horiz)
+            {
+                ys[1] += 1.0f;
+                ys[3] += 1.0f;
+            }
+            else
+            {
+                xs[1] += 1.0f;
+                xs[3] += 1.0f;
+            }
+            const GSVertex *src[4] = {&vx[0], &vx[0], &vx[1], &vx[1]};
+            static const int idx[6] = {0, 2, 1, 1, 2, 3};
+            for (int i = 0; i < 6; ++i)
+            {
+                const GSVertex &v = *src[idx[i]];
+                vert(v, st.prim.iip ? v : vx[1], xs[idx[i]], ys[idx[i]], tme, fst, zOf(v), static_cast<float>(vx[1].fog));
+            }
+            break;
+        }
+        default:
+        {
+            float xs[4] = {px[0], px[0] + 1.0f, px[0], px[0] + 1.0f}, ys[4] = {py[0], py[0], py[0] + 1.0f, py[0] + 1.0f};
+            static const int idx[6] = {0, 1, 2, 1, 3, 2};
+            for (int i = 0; i < 6; ++i)
+                vert(vx[0], vx[0], xs[idx[i]], ys[idx[i]], tme, fst, zOf(vx[0]), static_cast<float>(vx[0].fog));
+            break;
+        }
+        }
+        ++m_stDraws;
+    }
+
+    friend void ape2GsGlDisplay(GSRasterBackend *backend, uint64_t pmode, uint64_t dispfb1, uint64_t dispfb2);
+};
+
+std::unique_ptr<GSRasterBackend> ape2MakeRasterBackend()
+{
+    if (gpuRequested())
+    {
+        const char *mt = std::getenv("APE2_MTGS");
+        if (mt && std::atoi(mt) < 2)
+            std::fprintf(stderr, "[gpu] the GPU renderer needs the GS thread (APE2_MTGS=2); using the software renderer\n");
+        else
+            return std::make_unique<GSGlBackend>();
+    }
+    return std::make_unique<GSCpuBackend>();
+}
+
+void ape2GsGlDisplay(GSRasterBackend *backend, uint64_t pmode, uint64_t dispfb1, uint64_t dispfb2)
+{
+    if (auto *gl = dynamic_cast<GSGlBackend *>(backend))
+    {
+        gl->m_inDisplayDownload = true;
+        gl->Display(pmode, dispfb1, dispfb2);
+        gl->m_inDisplayDownload = false;
+    }
+}
+
+#else
+
