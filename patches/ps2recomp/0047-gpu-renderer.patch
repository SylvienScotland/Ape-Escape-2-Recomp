+    void glfwMakeContextCurrent(GLFWwindow *window);
+}
+
+namespace
+{
+    GLFWwindow *g_gsGlWindow = nullptr;
+
+    bool gpuRequested()
+    {
+        const char *e = std::getenv("APE2_GS_RENDERER");
+        return !e || std::strcmp(e, "cpu") != 0; // the GPU renderer is the default
+    }
+}
+
+// Main thread, after the window exists: a hidden window whose context (shared with the main one) the GS thread uses.
+void ape2CreateGsGlContext()
+{
+    if (!gpuRequested() || g_gsGlWindow)
+        return;
+    GLFWwindow *main = glfwGetCurrentContext();
+    glfwDefaultWindowHints();
+    glfwWindowHint(0x00020004, 0);          // GLFW_VISIBLE
+    glfwWindowHint(0x00022002, 3);          // GLFW_CONTEXT_VERSION_MAJOR
+    glfwWindowHint(0x00022003, 3);          // GLFW_CONTEXT_VERSION_MINOR
+    glfwWindowHint(0x00022008, 0x00032001); // GLFW_OPENGL_PROFILE: core
+    g_gsGlWindow = glfwCreateWindow(16, 16, "gs", nullptr, main);
+    glfwDefaultWindowHints();
+    if (main)
+        glfwMakeContextCurrent(main);
+    std::fprintf(stderr, g_gsGlWindow ? "[gpu] GL context for the GS thread created\n" : "[gpu] could not create a GL context for the GS thread\n");
+}
