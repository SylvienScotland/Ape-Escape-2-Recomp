+            m_cpu->StampPagesUnlocked(psm, rt.fbp, rt.fbw, static_cast<uint32_t>(x0), static_cast<uint32_t>(y0),
+                                      static_cast<uint32_t>(x0 + rw - 1), static_cast<uint32_t>(y0 + rh - 1));
+            m_cpu->m_vramEpoch.fetch_add(1);
+        }
+        rt.gpuDirty = false;
+        ++m_stDownloads;
+        if (m_inDisplayDownload)
+            ++m_stDisplayDownloads;
+    }
