+    // ---------------------------------------------------------------- helpers
+    static void texParams(GLuint t, GLint filter, GLint wrapS, GLint wrapT)
+    {
+        glBindTexture(GL_TEXTURE_2D, t);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, wrapS);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, wrapT);
+    }
+    static GLuint newTex(int w, int h, GLenum ifmt, GLenum fmt, GLenum type)
+    {
+        GLuint t = 0;
+        glGenTextures(1, &t);
+        glBindTexture(GL_TEXTURE_2D, t);
+        glTexImage2D(GL_TEXTURE_2D, 0, static_cast<GLint>(ifmt), w, h, 0, fmt, type, nullptr);
+        texParams(t, GL_NEAREST, GL_CLAMP_TO_EDGE, GL_CLAMP_TO_EDGE);
+        return t;
+    }
+    void quad(GLuint src, float x0, float y0, float x1, float y1, float u0, float v0, float u1, float v1, bool linear)
+    {
+        const float q[16] = {x0, y0, u0, v0, x1, y0, u1, v0, x0, y1, u0, v1, x1, y1, u1, v1};
+        glUseProgram(m_progCopy);
+        glUniform1i(uc_tex, 0);
+        glActiveTexture(GL_TEXTURE0);
+        texParams(src, linear ? GL_LINEAR : GL_NEAREST, GL_CLAMP_TO_EDGE, GL_CLAMP_TO_EDGE);
+        glBindBuffer(GL_ARRAY_BUFFER, m_vbo);
+        glBufferData(GL_ARRAY_BUFFER, sizeof q, q, GL_STREAM_DRAW);
+        glEnableVertexAttribArray(0);
+        glVertexAttribPointer(0, 4, GL_FLOAT, 0, 16, nullptr);
+        glDisableVertexAttribArray(1);
+        glDisableVertexAttribArray(2);
+        glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+        m_haveCur = false;
+    }
+    static void plainState()
+    {
+        glDisable(GL_BLEND);
+        glDisable(GL_DEPTH_TEST);
+        glDisable(GL_SCISSOR_TEST);
+        glDepthMask(0);
+        glColorMask(1, 1, 1, 1);
+    }
