+        {
+            std::lock_guard<std::mutex> lock(m_cpu->m_mutex);
+            for (int y = 0; y < rh; ++y)
+                for (int x = 0; x < rw; ++x)
+                {
+                    uint32_t c = px[static_cast<size_t>(y) * static_cast<size_t>(rw) + static_cast<size_t>(x)];
+                    if (rt.is16)
+                        c = ((c >> 3) & 0x1fu) | (((c >> 11) & 0x1fu) << 5) | (((c >> 19) & 0x1fu) << 10) | ((c >> 31) << 15);
