diff --git a/ps2xRuntime/src/lib/ps2_vu_compiled_run.h b/ps2xRuntime/src/lib/ps2_vu_compiled_run.h
new file mode 100644
index 0000000..411fc98
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_vu_compiled_run.h
@@ -0,0 +1,32 @@
+// Running the compiled VU1 microprograms in place of the interpreter (Ape Escape 2 recomp patch);
+// see ps2_vu_compiled.h.
+#pragma once
+
+#include <cstdint>
+
+struct VU1State;
+class PS2Memory;
+
+namespace ape2vu
+{
+    enum class Mode
+    {
+        Off,
+        On,
+        Verify
+    };
+    Mode mode();
+
+    enum class Result
+    {
+        NotHandled,           // no compiled program for this entry: run the interpreter
+        Done,                 // ran to its E bit (state, VU memory and GIF kicks done)
+        ContinueInInterpreter // left the compiled code; the interpreter continues at state.pc
+    };
+    Result runVu1(const uint8_t *vuCode, uint8_t *vuData, uint64_t codeGeneration, uint32_t startPc,
+                  uint32_t top, uint32_t itop, VU1State &state, PS2Memory *memory);
+
+    void *verifyBefore(const uint8_t *vuCode, const uint8_t *vuData, uint64_t codeGeneration, uint32_t startPc,
+                       uint32_t top, uint32_t itop, const VU1State &state);
+    void verifyAfter(void *input, const uint8_t *vuCode, const uint8_t *vuData, const VU1State &after);
+}
