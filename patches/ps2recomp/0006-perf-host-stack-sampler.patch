+// Host stack sampler for the perf profiler (Ape Escape 2 recomp patch); see ps2_perf.h.
+// Lives in Kernel/ because that directory is globbed into ps2_runtime (no CMake edit needed).
+#include "../ps2_perf.h"
+
+#if defined(_WIN32)
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <dbghelp.h>
+#include <string>
+
+#pragma comment(lib, "dbghelp.lib")
+
+namespace ps2perf
+{
+    namespace
+    {
+        std::atomic<HANDLE> g_target{nullptr};
+        std::atomic<DWORD> g_targetId{0};
+
+        constexpr int kMaxFrames = 64;
+
+        // Only touched by the sampler thread.
+        std::unordered_map<DWORD64, uint32_t> g_self;
+        std::unordered_map<DWORD64, uint32_t> g_incl;
+        std::unordered_map<DWORD64, std::string> g_names;
+        uint32_t g_samples = 0;
+        bool g_symInit = false;
+
+        // Unwind the suspended thread into function start addresses. Must not allocate or take
+        // CRT locks: the target may hold them. RtlLookupFunctionEntry/RtlVirtualUnwind are what
+        // in-process sampling profilers use for this.
+        int unwind(CONTEXT &ctx, DWORD64 *frames)
+        {
+            int n = 0;
+            while (n < kMaxFrames && ctx.Rip != 0)
+            {
+                DWORD64 imageBase = 0;
+                PRUNTIME_FUNCTION fe = RtlLookupFunctionEntry(ctx.Rip, &imageBase, nullptr);
+                if (!fe)
+                {
+                    // Leaf function (no unwind info): return address is at [rsp].
+                    frames[n++] = ctx.Rip;
+                    if (ctx.Rsp == 0)
+                        break;
+                    ctx.Rip = *reinterpret_cast<const DWORD64 *>(ctx.Rsp);
+                    ctx.Rsp += 8;
+                    continue;
+                }
+                frames[n++] = imageBase + fe->BeginAddress;
+                PVOID handlerData = nullptr;
+                DWORD64 establisher = 0;
+                RtlVirtualUnwind(UNW_FLAG_NHANDLER, imageBase, ctx.Rip, fe, &ctx, &handlerData,
+                                 &establisher, nullptr);
+            }
+            return n;
+        }
+
+        const std::string &nameOf(DWORD64 addr)
+        {
+            auto it = g_names.find(addr);
+            if (it != g_names.end())
+                return it->second;
+            HANDLE proc = GetCurrentProcess();
+            if (!g_symInit)
+            {
+                SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS);
+                g_symInit = SymInitialize(proc, nullptr, TRUE) != FALSE;
+            }
+            char buf[sizeof(SYMBOL_INFO) + 256] = {};
+            auto *sym = reinterpret_cast<SYMBOL_INFO *>(buf);
+            sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+            sym->MaxNameLen = 255;
+            DWORD64 disp = 0;
+            std::string name;
+            if (g_symInit && SymFromAddr(proc, addr, &disp, sym))
+            {
+                name.assign(sym->Name, sym->NameLen);
+                if (disp != 0)
+                {
+                    char off[24];
+                    std::snprintf(off, sizeof(off), "+0x%llx", static_cast<unsigned long long>(disp));
+                    name += off;
+                }
+            }
+            else
+            {
+                char raw[32];
+                std::snprintf(raw, sizeof(raw), "0x%llx", static_cast<unsigned long long>(addr));
+                name = raw;
+            }
+            for (char &c : name)
+                if (c == '|')
+                    c = '!';
+            if (name.size() > 70)
+                name = name.substr(0, 67) + "...";
+            return g_names.emplace(addr, std::move(name)).first->second;
+        }
+
+        void printTop(const char *tag, const std::unordered_map<DWORD64, uint32_t> &hist, size_t limit)
+        {
+            std::vector<std::pair<DWORD64, uint32_t>> rows(hist.begin(), hist.end());
+            const size_t topN = rows.size() < limit ? rows.size() : limit;
+            std::partial_sort(rows.begin(), rows.begin() + topN, rows.end(),
+                              [](const auto &a, const auto &b) { return a.second > b.second; });
+            std::string line = std::string("[") + tag + "] samples=" + std::to_string(g_samples);
+            for (size_t i = 0; i < topN; ++i)
+            {
+                char pct[16];
+                std::snprintf(pct, sizeof(pct), " | %.0f%% ", 100.0 * rows[i].second / g_samples);
+                line += pct;
+                line += nameOf(rows[i].first);
+            }
+            std::fprintf(stderr, "%s\n", line.c_str());
+        }
+    }
+
+    void hostRegisterCurrentThread()
+    {
+        HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE,
+                              GetCurrentThreadId());
+        if (!h)
+            return;
+        g_targetId.store(GetCurrentThreadId());
+        HANDLE old = g_target.exchange(h);
+        if (old)
+            CloseHandle(old);
+    }
+
+    void hostSampleTick()
+    {
+        HANDLE h = g_target.load();
+        if (!h || g_targetId.load() == GetCurrentThreadId())
+            return;
+        DWORD64 frames[kMaxFrames];
+        int n = 0;
+        if (SuspendThread(h) == static_cast<DWORD>(-1))
+            return;
+        CONTEXT ctx{};
+        ctx.ContextFlags = CONTEXT_FULL;
+        if (GetThreadContext(h, &ctx))
+            n = unwind(ctx, frames);
+        ResumeThread(h);
+        if (n == 0)
+            return;
+
+        ++g_samples;
+        ++g_self[frames[0]];
+        for (int i = 0; i < n; ++i)
+        {
+            bool seen = false;
+            for (int j = 0; j < i && !seen; ++j)
+                seen = frames[j] == frames[i];
+            if (!seen)
+                ++g_incl[frames[i]];
+        }
+    }
+
+    void hostReport()
+    {
+        if (g_samples == 0)
+            return;
+        printTop("perf:host-self", g_self, 15);
+        printTop("perf:host-incl", g_incl, 30);
+        std::fflush(stderr);
+        g_self.clear();
+        g_incl.clear();
+        g_samples = 0;
+    }
+}
+
+#else
+
+namespace ps2perf
+{
+    void hostRegisterCurrentThread() {}
+    void hostSampleTick() {}
+    void hostReport() {}
+}
+
+#endif
