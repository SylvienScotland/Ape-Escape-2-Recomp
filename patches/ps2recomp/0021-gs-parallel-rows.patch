+// Row-parallel rasterization (Ape Escape 2 recomp patch 0021). Pixels of one primitive never overlap, so a
+// large triangle/sprite is drawn by several threads, each taking 4-row blocks from an atomic counter; the
+// per-row code is unchanged, so the output is identical. APE2_GS_THREADS=N sets the worker count (default
+// min(cores - 1, 8)); 1 disables it. Small primitives stay on the calling thread.
+namespace
+{
+    class RasterPool
+    {
+    public:
+        static RasterPool &instance()
+        {
+            static RasterPool pool;
+            return pool;
+        }
+
+        [[nodiscard]] int threads() const noexcept { return static_cast<int>(m_workers.size()) + 1; }
+
+        // Runs fn(task) for task in [0, taskCount) on the workers plus the calling thread.
+        void run(int taskCount, const std::function<void(int)> &fn)
+        {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_job = &fn;
+                m_taskCount = taskCount;
+                m_nextTask.store(0, std::memory_order_relaxed);
+                m_activeWorkers = static_cast<int>(m_workers.size());
+                ++m_generation;
+            }
+            m_wake.notify_all();
+            work(fn, taskCount);
+            std::unique_lock<std::mutex> lock(m_mutex);
+            m_done.wait(lock, [this] { return m_activeWorkers == 0; });
+            m_job = nullptr;
+        }
+
+    private:
+        RasterPool()
+        {
+            int count = static_cast<int>(std::thread::hardware_concurrency()) - 1;
+            count = std::clamp(count, 1, 8);
+            if (const char *env = std::getenv("APE2_GS_THREADS"))
+                count = std::clamp(std::atoi(env), 1, 64);
+            for (int i = 1; i < count; ++i)
+                m_workers.emplace_back([this] { workerLoop(); });
+            std::fprintf(stderr, "[gs] rasterizer threads: %d\n", count);
+        }
+
+        ~RasterPool()
+        {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_stop = true;
+                ++m_generation;
+            }
+            m_wake.notify_all();
+            for (std::thread &t : m_workers)
+                t.join();
+        }
+
+        void work(const std::function<void(int)> &fn, int taskCount)
+        {
+            for (int task = m_nextTask.fetch_add(1, std::memory_order_relaxed); task < taskCount;
+                 task = m_nextTask.fetch_add(1, std::memory_order_relaxed))
+                fn(task);
+        }
+
+        void workerLoop()
+        {
+            uint64_t seen = 0;
+            for (;;)
+            {
+                const std::function<void(int)> *job = nullptr;
+                int taskCount = 0;
+                {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_wake.wait(lock, [&] { return m_generation != seen; });
+                    seen = m_generation;
+                    if (m_stop)
+                        return;
+                    job = m_job;
+                    taskCount = m_taskCount;
+                }
+                if (job)
+                    work(*job, taskCount);
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    if (--m_activeWorkers == 0)
+                        m_done.notify_one();
+                }
+            }
+        }
+
+        std::vector<std::thread> m_workers;
+        std::mutex m_mutex;
+        std::condition_variable m_wake;
+        std::condition_variable m_done;
+        const std::function<void(int)> *m_job = nullptr;
+        int m_taskCount = 0;
+        std::atomic<int> m_nextTask{0};
+        int m_activeWorkers = 0;
+        uint64_t m_generation = 0;
+        bool m_stop = false;
+    };
+
+    constexpr int kRowsPerTask = 4;
+    constexpr int64_t kParallelMinPixels = 8192;
+
+    // Calls drawRow(y) for y in [y0, y1], in parallel when the bounding box is large enough.
+    template <typename DrawRow>
+    void forEachRow(int y0, int y1, int width, DrawRow &&drawRow)
+    {
+        if (y1 < y0)
+            return;
+        const int rows = y1 - y0 + 1;
+        RasterPool &pool = RasterPool::instance();
+        if (pool.threads() <= 1 || static_cast<int64_t>(rows) * std::max(width, 1) < kParallelMinPixels ||
+            rows < 2 * kRowsPerTask)
+        {
+            for (int y = y0; y <= y1; ++y)
+                drawRow(y);
+            return;
+        }
+        const int tasks = (rows + kRowsPerTask - 1) / kRowsPerTask;
+        const std::function<void(int)> task = [&](int t)
+        {
+            const int first = y0 + t * kRowsPerTask;
+            const int last = std::min(y1, first + kRowsPerTask - 1);
+            for (int y = first; y <= last; ++y)
+                drawRow(y);
+        };
+        pool.run(tasks, task);
+    }
+}
