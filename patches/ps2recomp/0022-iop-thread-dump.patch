+    void IopKernel::debugDump(uint64_t currentCycle) const
+    {
+        static const char *const kStates[] = {"dormant", "ready", "running", "sleep", "delay",
+                                              "sema", "evflag", "suspended", "dead"};
+        std::fprintf(stderr, "[iop:threads] cycle=%llu threads=%zu\n", static_cast<unsigned long long>(currentCycle),
+                     m_threads.size());
+        for (const auto &[id, t] : m_threads)
+        {
+            const auto state = static_cast<size_t>(t.state);
+            std::fprintf(stderr,
+                         "[iop:threads]   id=%d %-9s prio=%u entry=0x%x pc=0x%x ra=0x%x wait=%d bits=0x%x mode=%u wake=%llu\n",
+                         id, state < std::size(kStates) ? kStates[state] : "?", t.priority, t.entry, t.cpu.pc,
+                         t.cpu.gpr[31], t.waitId, t.waitBits, t.waitMode,
+                         static_cast<unsigned long long>(t.wakeCycle));
+        }
+        for (const auto &[id, s] : m_semaphores)
+            std::fprintf(stderr, "[iop:threads]   sema %d count=%d/%d\n", id, s.current, s.maximum);
+        for (const auto &[id, e] : m_eventFlags)
+            std::fprintf(stderr, "[iop:threads]   evflag %d bits=0x%x\n", id, e.bits);
+    }
+
     void IopKernel::reset()
     {
         m_threads.clear();
