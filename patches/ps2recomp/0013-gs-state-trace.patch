+// GS state tracer for picture debugging (Ape Escape 2 recomp patch 0013). With APE2_GS_TRACE=1, prints each
+// distinct textured draw state, CLUT load and image upload once (capped), e.g.
+//   [gs:tex] prim=6 abe=1 fst=1 lin=1 tex0{tbp0=.. tbw=.. psm=0x14 tw=8 th=8 tcc=1 tfx=0 cbp=.. cpsm=0 csm=0 csa=0}
+static bool gsTraceEnabled()
+{
+    static const bool enabled = []
+    {
+        const char *e = std::getenv("APE2_GS_TRACE");
+        return e && *e && *e != '0';
+    }();
+    return enabled;
+}
+
+static bool gsTraceFirst(uint64_t key, uint32_t cap)
+{
+    static std::mutex mutex;
+    static std::unordered_set<uint64_t> seen;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (seen.size() >= cap)
+        return false;
+    return seen.insert(key).second;
+}
+
+static uint64_t gsTraceHash(std::initializer_list<uint64_t> values)
+{
+    uint64_t h = 1469598103934665603ull;
+    for (uint64_t v : values)
+        h = (h ^ v) * 1099511628211ull;
+    return h;
+}
