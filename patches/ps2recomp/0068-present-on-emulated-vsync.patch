+// 0068: the presenter (ps2_runtime.cpp) picked up a new frame by polling the vsync tick at raylib's own 60 Hz
+// (SetTargetFPS), a second clock beside the scheduler's vsync. The two drift past each other, and whenever their
+// phases met a poll fell just before a tick: one frame was shown for 33 ms and the next one was skipped - the 1-3
+// missed vblanks per 2 s in play (LOG 0234). The presenter now waits for the scheduler's vsync instead.
+namespace
+{
+    std::mutex g_presentVsyncMutex;
+    std::condition_variable g_presentVsyncCv;
+}
+
+void ape2SignalPresentVSync()
+{
+    { std::lock_guard<std::mutex> lock(g_presentVsyncMutex); }
+    g_presentVsyncCv.notify_all();
+}
+
+// waits until the vsync tick differs from `seen` (or the timeout passes, so the window keeps handling events)
+void ape2WaitPresentVSync(const std::atomic<uint64_t> &tick, uint64_t seen, std::chrono::milliseconds timeout)
+{
+    std::unique_lock<std::mutex> lock(g_presentVsyncMutex);
+    g_presentVsyncCv.wait_for(lock, timeout, [&]() { return tick.load(std::memory_order_acquire) != seen; });
+}
+
 // the game finished a stage frame (frame-locked vsync, patch 0049; called by the game's override)
+void ape2EnterGameFrame(int threadId)
+{
+    g_gameFrameThread.store(threadId, std::memory_order_relaxed);
+    g_inGameFrame.store(true, std::memory_order_release);
+}
+
 void ape2NoteGameFrame()
 {
+    g_inGameFrame.store(false, std::memory_order_release);
     g_gameFramesDone.fetch_add(1, std::memory_order_release);
 }
