+        [[nodiscard]] uint64_t nextEventCycle(uint64_t fallback) const noexcept;
+
     private:
+        struct Handler
+        {
+            uint32_t edge = 0;    // 0 = vblank start, 1 = vblank end
+            int32_t priority = 0; // lower runs first
+            uint32_t function = 0;
+            uint32_t argument = 0;
+            uint32_t gp = 0;
+        };
+
+        void deliver(uint32_t edge, IopGuestExecutor &executor);
+
         IopKernel &m_kernel;
+        std::vector<Handler> m_handlers;
+        uint64_t m_nextStartCycle = 0;
+        uint64_t m_nextEndCycle = 0;
+        bool m_servicing = false;
     };
 }
