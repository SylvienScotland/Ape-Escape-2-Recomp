@@ -30,13 +41,96 @@ namespace ps2x::iop::detail
             cpu.gpr[2] = 0u;
             return true;
         }
-        case 8: // RegisterVblankHandler
-        case 9: // ReleaseVblankHandler
-            // Callback delivery is not required by the scheduler wait ABI yet.
+        case 8: // RegisterVblankHandler(edge, priority, handler, arg)
+        {
+            Handler handler;
+            handler.edge = cpu.gpr[4] != 0u ? 1u : 0u;
+            handler.priority = static_cast<int32_t>(cpu.gpr[5]);
+            handler.function = cpu.gpr[6];
+            handler.argument = cpu.gpr[7];
+            handler.gp = cpu.gpr[28];
+            if (handler.function != 0u)
+            {
+                const auto pos = std::find_if(m_handlers.begin(), m_handlers.end(), [&](const Handler &h)
+                                              { return h.priority > handler.priority; });
+                m_handlers.insert(pos, handler);
+                if (m_nextStartCycle == 0u)
+                {
+                    const uint64_t fieldStart = currentCycle - (currentCycle % kVblankPeriodCycles);
+                    m_nextStartCycle = fieldStart + kVblankPeriodCycles;
+                    m_nextEndCycle = fieldStart + kVblankEndPhaseCycles;
+                    if (m_nextEndCycle <= currentCycle)
+                        m_nextEndCycle += kVblankPeriodCycles;
+                }
+            }
             cpu.gpr[2] = 0u;
             return true;
+        }
+        case 9: // ReleaseVblankHandler(edge, handler)
+        {
+            const uint32_t edge = cpu.gpr[4] != 0u ? 1u : 0u;
+            const uint32_t function = cpu.gpr[5];
+            m_handlers.erase(std::remove_if(m_handlers.begin(), m_handlers.end(), [&](const Handler &h)
+                                            { return h.edge == edge && h.function == function; }),
+                             m_handlers.end());
+            cpu.gpr[2] = 0u;
+            return true;
+        }
         default:
             return false;
         }
     }
+
+    void IopVblank::deliver(uint32_t edge, IopGuestExecutor &executor)
+    {
+        // Copy: a handler may register or release handlers.
+        const std::vector<Handler> handlers = m_handlers;
+        for (const Handler &h : handlers)
+        {
+            if (h.edge != edge)
+                continue;
+            const uint32_t result = executor.executeGuestFunctionWithBudget(h.function, h.argument, 0u, 0u, 0u, h.gp, 100000u);
+            if (result == 0u) // same convention as timer callbacks: returning 0 releases the handler
+            {
+                m_handlers.erase(std::remove_if(m_handlers.begin(), m_handlers.end(), [&](const Handler &x)
+                                                { return x.edge == h.edge && x.function == h.function && x.argument == h.argument; }),
+                                 m_handlers.end());
+            }
+        }
+    }
+
+    void IopVblank::serviceDue(uint64_t currentCycle, IopGuestExecutor &executor)
+    {
+        if (m_servicing || m_handlers.empty() || m_nextStartCycle == 0u)
+            return;
+        m_servicing = true;
+        struct ServiceGuard
+        {
+            bool &flag;
+            ~ServiceGuard() { flag = false; }
+        } guard{m_servicing};
+
+        // One delivery per edge even if emulated time jumped over several fields.
+        if (currentCycle >= m_nextStartCycle)
+        {
+            const uint64_t fieldStart = currentCycle - (currentCycle % kVblankPeriodCycles);
+            m_nextStartCycle = fieldStart + kVblankPeriodCycles;
+            deliver(0u, executor);
+        }
+        if (currentCycle >= m_nextEndCycle)
+        {
+            const uint64_t fieldStart = currentCycle - (currentCycle % kVblankPeriodCycles);
+            m_nextEndCycle = fieldStart + kVblankEndPhaseCycles;
+            if (m_nextEndCycle <= currentCycle)
+                m_nextEndCycle += kVblankPeriodCycles;
+            deliver(1u, executor);
+        }
+    }
+
+    uint64_t IopVblank::nextEventCycle(uint64_t fallback) const noexcept
+    {
+        if (m_handlers.empty() || m_nextStartCycle == 0u)
+            return fallback;
+        return std::min({fallback, m_nextStartCycle, m_nextEndCycle});
+    }
 }
