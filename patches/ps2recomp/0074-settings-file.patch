+// 0074: player settings in ape2.ini (current directory, or APE2_SETTINGS), written with the defaults when missing
+// and again when F6 / F11 change them. Each one is handed on as its APE2_* variable, so a variable set in the
+// environment still wins (for test runs).
+struct Ape2Settings
+{
+    int scale = 3;            // internal_resolution: 1-8 x the PS2's 512x448
+    std::string aspect = "4:3"; // aspect: 4:3, or 16:9 with the game's own 16:9 screen option
+    bool fullscreen = false;  // fullscreen: borderless window on the current monitor
+};
+static Ape2Settings &ape2Settings()
+{
+    static Ape2Settings s;
+    return s;
+}
+static std::string ape2SettingsPath()
+{
+    const char *e = std::getenv("APE2_SETTINGS");
+    return (e && *e) ? e : "ape2.ini";
+}
+static void ape2SaveSettings()
+{
+    const Ape2Settings &s = ape2Settings();
+    std::ofstream f(ape2SettingsPath(), std::ios::trunc);
+    if (!f)
+        return;
+    f << "# Ape Escape 2 recomp settings (edit freely; F6 and F11 in game save them here too).\n"
+         "# internal_resolution: 1-8 times the PS2's 512x448 (3 = 1536x1344, 4 = 2048x1792)\n"
+         "# aspect: 4:3, or 16:9 together with the game's own 16:9 screen setting in Options (F6 toggles)\n"
+         "# fullscreen: 0 or 1, a borderless window over the whole monitor (F11 toggles)\n\n"
+      << "internal_resolution = " << s.scale << "\n"
+      << "aspect = " << s.aspect << "\n"
+      << "fullscreen = " << (s.fullscreen ? 1 : 0) << "\n";
+}
+static void ape2SetEnv(const char *name, const std::string &value)
+{
+#if defined(_WIN32)
+    _putenv_s(name, value.c_str());
+#else
+    setenv(name, value.c_str(), 1);
+#endif
+}
+static void ape2LoadSettings()
+{
+    Ape2Settings &s = ape2Settings();
+    std::ifstream f(ape2SettingsPath());
+    if (!f)
+        ape2SaveSettings();
+    std::string line;
+    while (f && std::getline(f, line))
+    {
+        const size_t hash = line.find('#');
+        if (hash != std::string::npos)
+            line.resize(hash);
+        const size_t eq = line.find('=');
+        if (eq == std::string::npos)
+            continue;
+        auto trim = [](std::string t)
+        {
+            const size_t a = t.find_first_not_of(" \t\r");
+            const size_t b = t.find_last_not_of(" \t\r");
+            return a == std::string::npos ? std::string() : t.substr(a, b - a + 1);
+        };
+        const std::string key = trim(line.substr(0, eq)), value = trim(line.substr(eq + 1));
+        if (key == "internal_resolution")
+            s.scale = std::clamp(std::atoi(value.c_str()), 1, 8);
+        else if (key == "aspect")
+            s.aspect = (value == "16:9" || value == "wide") ? "16:9" : "4:3";
+        else if (key == "fullscreen")
+            s.fullscreen = value == "1" || value == "true";
+    }
+    if (const char *e = std::getenv("APE2_GS_SCALE"))
+        s.scale = std::clamp(std::atoi(e), 1, 8);
+    else
+        ape2SetEnv("APE2_GS_SCALE", std::to_string(s.scale));
+    if (const char *e = std::getenv("APE2_ASPECT"))
+        s.aspect = (std::strcmp(e, "16:9") == 0 || std::strcmp(e, "wide") == 0) ? "16:9" : "4:3";
+    else
+        ape2SetEnv("APE2_ASPECT", s.aspect);
+    std::fprintf(stderr, "[settings] %s: internal_resolution %d, aspect %s, fullscreen %d\n", ape2SettingsPath().c_str(),
+                 s.scale, s.aspect.c_str(), s.fullscreen ? 1 : 0);
+}
