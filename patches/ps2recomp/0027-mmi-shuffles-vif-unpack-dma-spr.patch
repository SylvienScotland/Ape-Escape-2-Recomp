diff --git a/b/ps2xRuntime/src/lib/Kernel/zz_ape2_ram_watch.cpp b/ps2xRuntime/src/lib/Kernel/zz_ape2_ram_watch.cpp
new file mode 100644
index 0000000..e9a9f50
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/zz_ape2_ram_watch.cpp
@@ -0,0 +1,161 @@
+// Guest RAM write watch (Ape Escape 2 recomp debugging aid).
+//
+// APE2_RAM_WATCH=<guest addr>[,<bytes>] write-protects the host pages holding that guest range. Every store
+// into those pages traps; the handler logs the host code address (resolved to the recompiled function,
+// e.g. sub_0029B5C0_0x29b5c0, which names the guest function), lets the store complete by single-stepping
+// it, then protects the page again. Stores into the watched range itself are marked "HIT".
+// Only for short diagnostic runs: every store to those pages is slow.
+#if defined(_WIN32)
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <dbghelp.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+
+#pragma comment(lib, "dbghelp.lib")
+
+namespace
+{
+    uint8_t *g_pageStart = nullptr;
+    size_t g_pageBytes = 0;
+    uint8_t *g_watchStart = nullptr;
+    size_t g_watchBytes = 0;
+    uint8_t *g_rdram = nullptr;
+    thread_local bool t_stepping = false;
+    thread_local uint8_t *t_target = nullptr;
+    thread_local uintptr_t t_rip = 0;
+    uint32_t g_valueLines = 0;
+    std::mutex g_logMutex;
+    std::map<std::pair<uintptr_t, bool>, uint32_t> g_seen;
+    uint32_t g_lines = 0;
+
+    std::string symbolFor(uintptr_t addr)
+    {
+        static bool init = false;
+        HANDLE proc = GetCurrentProcess();
+        if (!init)
+        {
+            init = true;
+            SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS);
+            SymInitialize(proc, nullptr, TRUE);
+        }
+        alignas(SYMBOL_INFO) char buffer[sizeof(SYMBOL_INFO) + 256];
+        auto *sym = reinterpret_cast<SYMBOL_INFO *>(buffer);
+        sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+        sym->MaxNameLen = 255;
+        DWORD64 disp = 0;
+        if (SymFromAddr(proc, addr, &disp, sym))
+            return std::string(sym->Name) + "+0x" + std::to_string(static_cast<unsigned long long>(disp));
+        char t[32];
+        std::snprintf(t, sizeof(t), "0x%llx", static_cast<unsigned long long>(addr));
+        return t;
+    }
+
+    LONG CALLBACK watchHandler(EXCEPTION_POINTERS *info)
+    {
+        const DWORD code = info->ExceptionRecord->ExceptionCode;
+        if (code == EXCEPTION_ACCESS_VIOLATION && g_pageStart)
+        {
+            const auto *rec = info->ExceptionRecord;
+            if (rec->NumberParameters >= 2 && rec->ExceptionInformation[0] == 1)
+            {
+                auto *target = reinterpret_cast<uint8_t *>(rec->ExceptionInformation[1]);
+                if (target >= g_pageStart && target < g_pageStart + g_pageBytes)
+                {
+                    const bool hit = target + 16 > g_watchStart && target < g_watchStart + g_watchBytes;
+                    const uintptr_t rip = static_cast<uintptr_t>(info->ContextRecord->Rip);
+                    {
+                        std::lock_guard<std::mutex> lock(g_logMutex);
+                        uint32_t &count = g_seen[std::make_pair(rip, hit)];
+                        if (count++ == 0u && g_lines < 300u)
+                        {
+                            ++g_lines;
+                            std::fprintf(stderr, "[ram:watch] %s write to guest 0x%x from %s\n", hit ? "HIT " : "page",
+                                         static_cast<uint32_t>(target - g_rdram), symbolFor(rip).c_str());
+                        }
+                    }
+                    DWORD old = 0;
+                    VirtualProtect(g_pageStart, g_pageBytes, PAGE_READWRITE, &old);
+                    t_target = hit ? target : nullptr;
+                    t_rip = rip;
+                    t_stepping = true;
+                    info->ContextRecord->EFlags |= 0x100; // trap flag: re-protect after this instruction
+                    return EXCEPTION_CONTINUE_EXECUTION;
+                }
+            }
+        }
+        else if (code == EXCEPTION_SINGLE_STEP && t_stepping)
+        {
+            t_stepping = false;
+            if (t_target)
+            {
+                std::lock_guard<std::mutex> lock(g_logMutex);
+                if (g_valueLines < 400u)
+                {
+                    ++g_valueLines;
+                    uint8_t *line = reinterpret_cast<uint8_t *>(reinterpret_cast<uintptr_t>(t_target) & ~uintptr_t(15));
+                    uint32_t w[4];
+                    std::memcpy(w, line, 16);
+                    float f[4];
+                    std::memcpy(f, line, 16);
+                    std::fprintf(stderr, "[ram:watch]   -> guest 0x%x now %08x %08x %08x %08x (%g %g %g %g) by %s\n",
+                                 static_cast<uint32_t>(line - g_rdram), w[0], w[1], w[2], w[3], f[0], f[1], f[2], f[3],
+                                 symbolFor(t_rip).c_str());
+                }
+                t_target = nullptr;
+            }
+            DWORD old = 0;
+            VirtualProtect(g_pageStart, g_pageBytes, PAGE_READONLY, &old);
+            return EXCEPTION_CONTINUE_EXECUTION;
+        }
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+}
+
+// Called by PS2Memory once guest RAM is allocated.
+void ape2InstallRamWatch(uint8_t *rdram, size_t ramSize)
+{
+    const char *env = std::getenv("APE2_RAM_WATCH");
+    if (!env || !rdram)
+        return;
+    char *end = nullptr;
+    const uint32_t guest = static_cast<uint32_t>(std::strtoul(env, &end, 0)) & 0x01FFFFFFu;
+    size_t bytes = 16;
+    if (end && *end == ',')
+        bytes = static_cast<size_t>(std::strtoul(end + 1, nullptr, 0));
+    if (guest + bytes > ramSize)
+        return;
+    SYSTEM_INFO si{};
+    GetSystemInfo(&si);
+    const uintptr_t page = si.dwPageSize;
+    g_rdram = rdram;
+    g_watchStart = rdram + guest;
+    g_watchBytes = bytes;
+    const uintptr_t first = reinterpret_cast<uintptr_t>(g_watchStart) & ~(page - 1u);
+    const uintptr_t last = (reinterpret_cast<uintptr_t>(g_watchStart) + bytes + page - 1u) & ~(page - 1u);
+    g_pageStart = reinterpret_cast<uint8_t *>(first);
+    g_pageBytes = last - first;
+    AddVectoredExceptionHandler(1, watchHandler);
+    DWORD old = 0;
+    VirtualProtect(g_pageStart, g_pageBytes, PAGE_READONLY, &old);
+    std::fprintf(stderr, "[ram:watch] watching guest 0x%x (+%zu bytes), host pages %p +%zu\n", guest, bytes,
+                 static_cast<void *>(g_pageStart), g_pageBytes);
+}
+
+#else
+#include <cstddef>
+#include <cstdint>
+void ape2InstallRamWatch(uint8_t *, size_t) {}
+#endif
