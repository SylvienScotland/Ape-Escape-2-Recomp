+// 0061: the IPU (ps2_ipu.cpp) reaches DMA channels 3/4, memory and the interrupt queues through these
+static void ape2EnsureIpuHost(PS2Memory *m)
+{
+    static bool done = false;
+    if (done)
+        return;
+    done = true;
+    for (uint32_t base : {0x1000B000u, 0x1000B400u})
+        for (uint32_t off = 0; off <= 0x50u; off += 0x10u)
+            (void)m->m_ioRegisters[base + off]; // the IPU keeps references to these
+    ps2ipu::Host h;
+    h.user = m;
+    h.reg = [](void *u, uint32_t a) -> uint32_t & { return static_cast<PS2Memory *>(u)->m_ioRegisters[a]; };
+    h.mem = [](void *u, uint32_t a) -> uint8_t *
+    {
+        PS2Memory *mm = static_cast<PS2Memory *>(u);
+        if (a & 0x80000000u)
+            return mm->getScratchpad() + (a & 0x3FF0u);
+        return mm->getRDRAM() + (a & (PS2_RAM_SIZE - 16u));
+    };
+    h.dmaDone = [](void *u, int ch) { static_cast<PS2Memory *>(u)->completeDmacChannel(ch == 3 ? 0x1000B000u : 0x1000B400u, static_cast<uint32_t>(ch)); };
+    h.intc = [](void *u, int cause) { static_cast<PS2Memory *>(u)->queueCompletedDmacCause(0x100u | static_cast<uint32_t>(cause)); };
+    ps2ipu::setHost(h);
+}
