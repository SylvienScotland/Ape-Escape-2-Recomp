+    // ------------------------------------------------------------------ DMA
+    int d4_active() { return (CHCR(D4) & 0x100) != 0; }
+    // read the next toIPU tag; returns 0 when the chain is over
+    int d4_next_tag()
+    {
+        if (ipu.d4_tag_end)
+            return 0;
+        uint32_t t = TADR(D4);
+        uint8_t *p = hwMem(t);
+        uint32_t lo, hi;
+        std::memcpy(&lo, p, 4);
+        std::memcpy(&hi, p + 4, 4);
+        uint32_t q = lo & 0xffff, id = (lo >> 28) & 7, irq = lo >> 31, addr = hi & 0x7ffffff0u;
+        uint32_t chcr = CHCR(D4);
+        CHCR(D4) = (chcr & 0xffff) | (lo & 0xffff0000u);
+        QWC(D4) = q;
+        int asp = (chcr >> 4) & 3;
+        switch (id)
+        {
+        case 0: // refe
+            MADR(D4) = addr;
+            TADR(D4) = t + 16;
+            ipu.d4_tag_end = 1;
+            break;
+        case 1: // cnt
+            MADR(D4) = t + 16;
+            TADR(D4) = t + 16 + q * 16;
+            break;
+        case 2: // next
+            MADR(D4) = t + 16;
+            TADR(D4) = addr;
+            break;
+        case 3: // ref, refs
+        case 4:
+            MADR(D4) = addr;
+            TADR(D4) = t + 16;
+            break;
+        case 5: // call
+            MADR(D4) = t + 16;
+            if (asp == 0)
+                ASR0(D4) = t + 16 + q * 16;
+            else
+                ASR1(D4) = t + 16 + q * 16;
+            CHCR(D4) = (CHCR(D4) & ~0x30u) | (static_cast<uint32_t>(asp + 1) << 4);
+            TADR(D4) = addr;
+            break;
+        case 6: // ret
+            MADR(D4) = t + 16;
+            if (asp > 0)
+            {
+                asp--;
+                TADR(D4) = asp ? ASR1(D4) : ASR0(D4);
+                CHCR(D4) = (CHCR(D4) & ~0x30u) | (static_cast<uint32_t>(asp) << 4);
+            }
+            else
+            {
+                TADR(D4) = t + 16 + q * 16;
+                ipu.d4_tag_end = 1;
+            }
+            break;
+        case 7: // end
+            MADR(D4) = t + 16;
+            TADR(D4) = t + 16 + q * 16;
+            ipu.d4_tag_end = 1;
+            break;
+        }
+        if (irq && (chcr & 0x80))
+            ipu.d4_tag_end = 1;
+        ipu.d4_tag_active = 1;
+        return 1;
+    }
+    void d4_finish()
+    {
+        CHCR(D4) &= ~0x100u;
+        ipu.d4_tag_active = 0;
+        hwDmaDone(4);
+    }
+    // move data from the toIPU channel into the input FIFO; returns qwords moved
+    int d4_fill()
+    {
+        int moved = 0;
+        while (ipu.ifc < 8 && d4_active())
+        {
+            int chain = ((CHCR(D4) >> 2) & 3) == 1;
+            if ((QWC(D4) & 0xffff) == 0)
+            {
+                if (!chain)
+                {
+                    d4_finish();
+                    break;
+                }
+                if (ipu.d4_tag_active && ipu.d4_tag_end)
+                {
+                    d4_finish();
+                    break;
+                }
+                if (!d4_next_tag())
+                {
+                    d4_finish();
+                    break;
+                }
+                continue;
+            }
+            std::memcpy(ipu.fifo[(ipu.fr + ipu.ifc) & 7], hwMem(MADR(D4)), 16);
+            ipu.ifc++;
+            moved++;
+            MADR(D4) += 16;
+            QWC(D4) = (QWC(D4) - 1) & 0xffff;
+            if (chain) // cnt/end tags advance TADR along with MADR
+            {
+                uint32_t id = (CHCR(D4) >> 28) & 7;
+                if (id == 1 || id == 7)
+                    TADR(D4) = MADR(D4);
+            }
+            if ((QWC(D4) & 0xffff) == 0 && (!chain || ipu.d4_tag_end))
+            {
+                d4_finish();
+                break;
+            }
+        }
+        return moved;
+    }
+    // drain the output FIFO into the fromIPU channel (normal mode)
+    int d3_drain()
+    {
+        int moved = 0;
+        while (ipu.ofc > 0 && (CHCR(D3) & 0x100) && (QWC(D3) & 0xffff))
+        {
+            std::memcpy(hwMem(MADR(D3)), ipu.ofifo[ipu.or_], 16);
+            ipu.or_ = (ipu.or_ + 1) & 7;
+            ipu.ofc--;
+            moved++;
+            MADR(D3) += 16;
+            QWC(D3) = (QWC(D3) - 1) & 0xffff;
+            if ((QWC(D3) & 0xffff) == 0)
+            {
+                CHCR(D3) &= ~0x100u;
+                hwDmaDone(3);
+            }
+        }
+        return moved;
+    }
