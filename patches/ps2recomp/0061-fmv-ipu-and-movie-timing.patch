diff --git a/ps2xRuntime/src/lib/ps2_ipu.cpp b/ps2xRuntime/src/lib/ps2_ipu.cpp
new file mode 100644
index 0000000..dbb40c7
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_ipu.cpp
@@ -0,0 +1,1459 @@
+// IPU (the PS2's MPEG-2 decoder) for FMV playback (Ape Escape 2 recomp patch 0061).
+//
+// Ported from the PAL port's port/src/ipu.c (JackyPendrag0n/ae2-recomp), used with the author's permission; the
+// decoder is unchanged, the coroutine is a Windows fiber and the hardware access goes through ps2ipu::Host.
+//
+// The game plays its movies with Sony's libmpeg, which parses the stream headers itself and hands the IPU one
+// command at a time: VDEC/FDEC to read symbols and fields, BDEC to decode a macroblock's DCT blocks, CSC to turn
+// finished YCbCr macroblocks into RGB, plus SETIQ/SETTH/BCLR for setup. Data comes in through an 8-qword input
+// FIFO (fed by DMA channel 4, toIPU) and results leave through an 8-qword output FIFO (drained by channel 3,
+// fromIPU). The decoder is straight-line code running in a coroutine: whenever it needs input that is not there
+// yet, or the output FIFO is full, it yields back to the game, and it is resumed when the game feeds or drains
+// the FIFOs (by DMA or by FIFO register access). The FIFO and DMA bookkeeping follow the hardware closely because
+// libmpeg reads IPU_BP / IPU_CTRL and the DMA registers back to know how much of the stream the IPU has consumed.
+//
+// VLC tables: ISO/IEC 13818-2 Annex B. Colour conversion: the IPU's documented BT.601 integer method (Y bias 16,
+// coefficients in 1/64ths).
+
+#include "runtime/ps2_ipu.h"
+
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+namespace
+{
+    ps2ipu::Host g_host;
+    std::recursive_mutex g_lock;
+
+    uint32_t &hwReg(uint32_t a) { return g_host.reg(g_host.user, a); }
+    uint8_t *hwMem(uint32_t a) { return g_host.mem(g_host.user, a); }
+    void hwDmaDone(int ch)
+    {
+        if (g_host.dmaDone)
+            g_host.dmaDone(g_host.user, ch);
+    }
+    void raiseIntc(int cause)
+    {
+        static const bool off = std::getenv("APE2_IPU_NOINTC") != nullptr; // experiment
+        if (off)
+            return;
+        if (g_host.intc)
+            g_host.intc(g_host.user, cause);
+    }
+    uint64_t hostUsec()
+    {
+        return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                         std::chrono::steady_clock::now().time_since_epoch())
+                                         .count());
+    }
+
+    // ------------------------------------------------------------------ registers
+    constexpr uint32_t D3 = 0x1000B000u; // fromIPU
+    constexpr uint32_t D4 = 0x1000B400u; // toIPU
+    uint32_t &CHCR(uint32_t b) { return hwReg(b); }
+    uint32_t &MADR(uint32_t b) { return hwReg(b + 0x10u); }
+    uint32_t &QWC(uint32_t b) { return hwReg(b + 0x20u); }
+    uint32_t &TADR(uint32_t b) { return hwReg(b + 0x30u); }
+    uint32_t &ASR0(uint32_t b) { return hwReg(b + 0x40u); }
+    uint32_t &ASR1(uint32_t b) { return hwReg(b + 0x50u); }
+
+    enum
+    {
+        C_BCLR,
+        C_IDEC,
+        C_BDEC,
+        C_VDEC,
+        C_FDEC,
+        C_SETIQ,
+        C_SETVQ,
+        C_CSC,
+        C_PACK,
+        C_SETTH
+    };
+
+    struct IpuState
+    {
+        uint32_t cmd_data, cmd_busy;
+        uint32_t ctrl; // bits we keep: ECD 14, SCD 15, IDP 16-17, AS 20, IVF 21, QST 22, MP1 23, PCT 24-26, BUSY 31
+        uint32_t top, top_busy;
+        int cbp;
+        // input: FIFO plus the decoder's 2-qword internal buffer
+        uint8_t fifo[8][16];
+        int fr, ifc;
+        uint8_t ib[2][16];
+        int fp, bp; // fp: qwords in ib; bp: bit position in ib (0..255)
+        // output FIFO
+        uint8_t ofifo[8][16];
+        int or_, ofc;
+        // toIPU chain state
+        int d4_tag_end;    // the current tag ends the chain
+        int d4_tag_active; // QWC belongs to a tag already read
+        // tables
+        uint8_t iq[64], niq[64];
+        uint16_t vqclut[16];
+        uint16_t th0, th1;
+        int dc_pred[3];
+        uint32_t cur; // command being executed
+    };
+    IpuState ipu{};
+
+    constexpr uint32_t CTRL_ECD = 1u << 14;
+    constexpr uint32_t CTRL_SCD = 1u << 15;
+    constexpr uint32_t CTRL_BUSY = 1u << 31;
+    int ctrl_idp() { return (ipu.ctrl >> 16) & 3; }
+    int ctrl_as() { return (ipu.ctrl >> 20) & 1; }
+    int ctrl_ivf() { return (ipu.ctrl >> 21) & 1; }
+    int ctrl_qst() { return (ipu.ctrl >> 22) & 1; }
+    int ctrl_mp1() { return (ipu.ctrl >> 23) & 1; }
+    int ctrl_pct() { return (ipu.ctrl >> 24) & 7; }
+
+    // ------------------------------------------------------------------ coroutine (a fiber)
+    LPVOID co_ipu = nullptr; // the decoder fiber
