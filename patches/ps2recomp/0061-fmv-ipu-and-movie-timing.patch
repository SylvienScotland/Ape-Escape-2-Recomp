diff --git a/ps2xRuntime/include/runtime/ps2_ipu.h b/ps2xRuntime/include/runtime/ps2_ipu.h
new file mode 100644
index 0000000..8b7c8b9
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_ipu.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <cstdint>
+
+// The IPU (the PS2's MPEG-2 decoder), for FMV playback (Ape Escape 2 recomp patch 0061). Ported from the PAL
+// port's port/src/ipu.c (JackyPendrag0n/ae2-recomp). The game's own libmpeg drives it through the IPU
+// registers (0x10002000-0x10002030), the FIFOs (0x10007000 out, 0x10007010 in) and DMA channels 3 (fromIPU)
+// and 4 (toIPU).
+namespace ps2ipu
+{
+    struct Host
+    {
+        void *user = nullptr;
+        uint32_t &(*reg)(void *user, uint32_t address) = nullptr;   // a DMA channel register
+        uint8_t *(*mem)(void *user, uint32_t address) = nullptr;     // 16 bytes of DMA memory (RAM or SPR)
+        void (*dmaDone)(void *user, int channel) = nullptr;           // D_STAT + DMAC interrupt
+        void (*intc)(void *user, int cause) = nullptr;                // INTC interrupt (IPU = 8)
+    };
+
+    void setHost(const Host &host);
+    bool handles(uint32_t address);
+    uint32_t read32(uint32_t address);
+    uint64_t read64(uint32_t address);
+    void write32(uint32_t address, uint32_t value);
+    void fifoRead(uint8_t out[16]);
+    void fifoWrite(const uint8_t in[16]);
+    void dmaStart(int channel); // a CHCR write that set STR on channel 3 or 4
+    void poll();                // a read of channel 3/4's CHCR
+    // Called with the host time each burst of IPU work took, so the EE clock can be charged for it: on the PS2 the
+    // IPU decodes in parallel while the EE waits, and that wait takes real time (patch 0061).
+    void setChargeHook(void (*hook)(uint64_t hostNs));
+    // An IPU command was started within the last `ms` milliseconds (a movie is playing).
+    bool activeWithin(int ms);
+}
