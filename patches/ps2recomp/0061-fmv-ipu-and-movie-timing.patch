+    // ------------------------------------------------------------------ bit reader
+    // make sure the internal buffer holds `bits` bits past bp (at most 32 + the current word)
+    void need(int bits)
+    {
+        while (ipu.fp * 128 < ipu.bp + bits)
+        {
+            if (!ipu.ifc)
+                d4_fill();
+            if (!ipu.ifc)
+            {
+                yield(1);
+                continue;
+            }
+            std::memcpy(ipu.ib[ipu.fp], ipu.fifo[ipu.fr], 16);
+            ipu.fr = (ipu.fr + 1) & 7;
+            ipu.ifc--;
+            ipu.fp++;
+            d4_fill();
+        }
+    }
+    // the next n (<= 32) bits, left-aligned in 32, without consuming them; waits only for n bits
+    uint32_t peekn(int n)
+    {
+        need(n);
+        int byte = ipu.bp >> 3, sh = ipu.bp & 7, have = ipu.fp * 16;
+        const uint8_t *b = &ipu.ib[0][0];
+        uint64_t v = 0;
+        for (int i = 0; i < 5; i++)
+            v = (v << 8) | (byte + i < have ? b[byte + i] : 0);
+        return static_cast<uint32_t>(v >> (8 - sh));
+    }
+    uint32_t peek32() { return peekn(32); }
+    uint32_t ubits(int n) { return n ? peekn(n) >> (32 - n) : 0; }
+    int32_t sbits(int n) { return n ? static_cast<int32_t>(peekn(n)) >> (32 - n) : 0; }
+    void dump(int n)
+    {
+        ipu.bp += n;
+        while (ipu.bp >= 128 && ipu.fp > 0)
+        {
+            std::memcpy(ipu.ib[0], ipu.ib[1], 16);
+            ipu.fp--;
+            ipu.bp -= 128;
+        }
+        if (ipu.bp >= 128 && ipu.fp == 0)
+        {
+            // skipping past data that has not arrived: pull it in and drop it
+            while (ipu.bp >= 128)
+            {
+                need(1);
+                std::memcpy(ipu.ib[0], ipu.ib[1], 16);
+                ipu.fp--;
+                ipu.bp -= 128;
+            }
+        }
+    }
+    uint32_t gbits(int n)
+    {
+        uint32_t v = ubits(n);
+        dump(n);
+        return v;
+    }
