+    void read_block(int16_t *blk, int intra, int cc, int qs)
+    {
+        const uint8_t *scan = ctrl_as() ? altscan : zigzag;
+        const uint8_t *qm = intra ? ipu.iq : ipu.niq;
+        int mpeg1 = ctrl_mp1();
+        int i = 0;
+        if (intra)
+        {
+            ipu.dc_pred[cc] += dc_diff(cc != 0);
+            blk[0] = static_cast<int16_t>(ipu.dc_pred[cc] << (3 - ctrl_idp()));
+            i = 1;
+        }
+        const Vlc *tab = intra && ctrl_ivf() && !mpeg1 ? &v_dct1 : &v_dct0;
+        int first = !intra; // a non-intra block's first coefficient has its own short code
+        for (;;)
+        {
+            const VlcEnt *e = vlc_get(first ? &v_dct0f : tab);
+            first = 0;
+            if (!e->len)
+                break; // invalid code: stop the block
+            dump(e->len);
+            if (e->a == EOB)
+                break;
+            int run, val;
+            if (e->a == ESC)
+            {
+                run = static_cast<int>(gbits(6));
+                if (mpeg1)
+                {
+                    int l = sbits(8);
+                    dump(8);
+                    if (l == -128)
+                        l = static_cast<int>(gbits(8)) - 256;
+                    else if (l == 0)
+                        l = static_cast<int>(gbits(8));
+                    val = l;
+                }
+                else
+                {
+                    val = sbits(12);
+                    dump(12);
+                }
+            }
+            else
+            {
+                run = e->a;
+                val = e->b;
+                if (gbits(1))
+                    val = -val;
+            }
+            i += run;
+            if (i > 63)
+                break;
+            int j = scan[i];
+            int v; // the IPU keeps the quantiser matrices in scan order (as transmitted)
+            if (intra)
+                v = (val * qs * qm[i]) / 16; // MPEG-2: (2 * level * qs * W) / 32
+            else
+                v = ((2 * val + (val > 0 ? 1 : val < 0 ? -1 : 0)) * qs * qm[i]) / 32;
+            if (mpeg1 && v)
+                v = (v & 1) ? v : v - (v > 0 ? 1 : -1); // oddification
+            blk[j] = static_cast<int16_t>(clampi(v, -2048, 2047));
+            i++;
+        }
+        if (!mpeg1) // mismatch control
+        {
+            int sum = 0;
+            for (int k = 0; k < 64; k++)
+                sum += blk[k];
+            if (!(sum & 1))
+                blk[63] ^= 1;
+        }
+    }
+    // separable 8x8 inverse DCT (double precision reference form)
+    double idct_c[8][8];
+    void idct(int16_t *blk, int16_t *out)
+    {
+        static int init;
+        if (!init)
+        {
+            init = 1;
+            const double pi = 3.14159265358979323846, sqrt1_2 = 0.70710678118654752440;
+            for (int u = 0; u < 8; u++)
+                for (int x = 0; x < 8; x++)
+                    idct_c[x][u] = (u ? 1.0 : sqrt1_2) * std::cos((2 * x + 1) * u * pi / 16) / 2;
+        }
+        double tmp[64];
+        for (int y = 0; y < 8; y++)
+        {
+            const int16_t *r = blk + y * 8;
+            int nz = 0;
+            for (int u = 0; u < 8; u++)
+                nz |= r[u];
+            for (int x = 0; x < 8; x++)
+            {
+                double s = 0;
+                if (nz)
+                    for (int u = 0; u < 8; u++)
+                        s += idct_c[x][u] * r[u];
+                tmp[y * 8 + x] = s;
+            }
+        }
+        for (int x = 0; x < 8; x++)
+            for (int y = 0; y < 8; y++)
+            {
+                double s = 0;
+                for (int v = 0; v < 8; v++)
+                    s += idct_c[y][v] * tmp[v * 8 + x];
+                out[y * 8 + x] = static_cast<int16_t>(clampi(static_cast<int>(std::floor(s + 0.5)), -256, 255));
+            }
+    }
+
+    // ------------------------------------------------------------------ macroblocks
+    struct MB16
+    {
+        int16_t y[16][16], cb[8][8], cr[8][8];
+    };
+    struct MB8
+    {
+        uint8_t y[16][16], cb[8][8], cr[8][8];
+    };
+    void put_block(MB16 *mb, int b, const int16_t *px, int field)
+    {
+        for (int r = 0; r < 8; r++)
+            for (int c = 0; c < 8; c++)
+            {
+                int16_t v = px[r * 8 + c];
+                if (b < 4)
+                {
+                    int yy = field ? (b >> 1) + r * 2 : (b >> 1) * 8 + r, xx = (b & 1) * 8 + c;
+                    mb->y[yy][xx] = v;
+                }
+                else if (b == 4)
+                    mb->cb[r][c] = v;
+                else
+                    mb->cr[r][c] = v;
+            }
+    }
+    // decode the blocks of one macroblock (after its header) into mb
+    void decode_mb_blocks(MB16 *mb, int intra, int cbp, int field, int qs)
+    {
+        std::memset(mb, 0, sizeof *mb);
+        for (int b = 0; b < 6; b++)
+        {
+            if (!intra && !(cbp & (32 >> b)))
+                continue;
+            int16_t blk[64] = {0}, px[64];
+            read_block(blk, intra, b < 4 ? 0 : b - 3, qs);
+            idct(blk, px);
+            if (intra)
+                for (int k = 0; k < 64; k++)
+                    px[k] = static_cast<int16_t>(clampi(px[k], 0, 255));
+            put_block(mb, b, px, field);
+        }
+    }
+    // YCbCr (8-bit) -> RGB32 with the IPU's integer formula, then thresholds
+    void csc_rgb32(const MB8 *m, uint32_t *rgb)
+    {
+        for (int y = 0; y < 16; y++)
+            for (int x = 0; x < 16; x++)
+            {
+                int lum = (0x95 * (m->y[y][x] > 16 ? m->y[y][x] - 16 : 0)) >> 6;
+                int cb = m->cb[y >> 1][x >> 1] - 128, cr = m->cr[y >> 1][x >> 1] - 128;
+                int r = clampi((lum + ((0xcc * cr) >> 6) + 1) >> 1, 0, 255);
+                int g = clampi((lum + ((-0x68 * cr) >> 6) + ((-0x32 * cb) >> 6) + 1) >> 1, 0, 255);
+                int b = clampi((lum + ((0x102 * cb) >> 6) + 1) >> 1, 0, 255);
+                uint32_t a = 0x80;
+                if (ipu.th0 && r < ipu.th0 && g < ipu.th0 && b < ipu.th0)
+                {
+                    rgb[y * 16 + x] = 0;
+                    continue;
+                }
+                if (ipu.th1 && r < ipu.th1 && g < ipu.th1 && b < ipu.th1)
+                    a = 0x40;
+                rgb[y * 16 + x] = static_cast<uint32_t>(r) | (static_cast<uint32_t>(g) << 8) | (static_cast<uint32_t>(b) << 16) | (a << 24);
+            }
+    }
+    void rgb32_to_16(const uint32_t *rgb, uint16_t *o, int dither)
+    {
+        static const int dm[4][4] = {{-4, 0, -3, 1}, {2, -2, 3, -1}, {-3, 1, -4, 0}, {3, -1, 2, -2}};
+        for (int y = 0; y < 16; y++)
+            for (int x = 0; x < 16; x++)
+            {
+                uint32_t c = rgb[y * 16 + x];
+                int d = dither ? dm[y & 3][x & 3] : 0;
+                int r = clampi(static_cast<int>(c & 255) + d, 0, 255) >> 3, g = clampi(static_cast<int>((c >> 8) & 255) + d, 0, 255) >> 3,
+                    b = clampi(static_cast<int>((c >> 16) & 255) + d, 0, 255) >> 3;
+                int a = (c >> 24) == 0x40 ? 0 : (c >> 24) ? 1 : 0;
+                o[y * 16 + x] = static_cast<uint16_t>(r | (g << 5) | (b << 10) | (a << 15));
+            }
+    }
+    // after a macroblock: look for a start code at the next byte boundary (SCD) or garbage (ECD)
+    void check_start_code()
+    {
+        if (ubits(8) == 0)
+        {
+            ipu.bp = (ipu.bp + 7) & ~7;
+            dump(0);
+            for (;;)
+            {
+                uint32_t s = ubits(24);
+                if (s)
+                {
+                    if (s == 1)
+                        ipu.ctrl |= CTRL_SCD;
+                    else
+                        ipu.ctrl |= CTRL_ECD;
+                    break;
+                }
+                dump(8);
+            }
+        }
+        ipu.top = peek32();
+    }
+
+    // ------------------------------------------------------------------ commands
+    void cmd_bdec(uint32_t v)
+    {
+        int intra = (v >> 27) & 1, dcr = (v >> 26) & 1, field = (v >> 25) & 1, qsc = (v >> 16) & 31;
+        if (dcr)
+            ipu.dc_pred[0] = ipu.dc_pred[1] = ipu.dc_pred[2] = 128 << ctrl_idp();
+        ipu.ctrl &= ~CTRL_ECD;
+        int cbp = 0x3f;
+        if (!intra)
+        {
+            const VlcEnt *e = vlc_get(&v_cbp);
+            dump(e->len);
+            cbp = e->a;
+        }
+        ipu.cbp = cbp;
+        static MB16 mb;
+        decode_mb_blocks(&mb, intra, cbp, field, quant_scale(qsc));
+        ipu.ctrl &= ~CTRL_SCD;
+        out_block(&mb, sizeof mb / 16);
+        check_start_code();
+    }
+    void cmd_idec(uint32_t v)
+    {
+        int qsc = (v >> 16) & 31, dtd = (v >> 24) & 1, sgn = (v >> 25) & 1, dte = (v >> 26) & 1, ofm = (v >> 27) & 1;
+        int qs = quant_scale(qsc);
+        ipu.ctrl = (ipu.ctrl & ~(7u << 24)) | (1u << 24); // PCT = I
+        ipu.dc_pred[0] = ipu.dc_pred[1] = ipu.dc_pred[2] = 128 << ctrl_idp();
+        ipu.ctrl &= ~CTRL_ECD;
+        static MB16 mb;
+        static MB8 m8;
+        static uint32_t rgb[256];
+        static uint16_t rgb16[256];
+        for (;;)
+        {
+            const VlcEnt *e = vlc_get(&v_mbt[0]);
+            dump(e->len);
+            int modes = e->a;
+            if (!e->len)
+            {
+                ipu.ctrl |= CTRL_ECD;
+                break;
+            }
+            int field = dtd ? static_cast<int>(gbits(1)) : 0;
+            if (modes & 0x10)
+                qs = quant_scale(static_cast<int>(gbits(5)));
+            decode_mb_blocks(&mb, 1, 0x3f, field, qs);
+            for (int i = 0; i < 256; i++)
+                (&m8.y[0][0])[i] = static_cast<uint8_t>((&mb.y[0][0])[i]);
+            for (int i = 0; i < 64; i++)
+            {
+                (&m8.cb[0][0])[i] = static_cast<uint8_t>((&mb.cb[0][0])[i]);
+                (&m8.cr[0][0])[i] = static_cast<uint8_t>((&mb.cr[0][0])[i]);
+            }
+            csc_rgb32(&m8, rgb);
+            if (sgn)
+                for (int i = 0; i < 256; i++)
+                    rgb[i] ^= 0x808080u;
+            if (ofm)
+            {
+                rgb32_to_16(rgb, rgb16, dte);
+                out_block(rgb16, 32);
+            }
+            else
+                out_block(rgb, 64);
+            // next macroblock address increment: anything but "1" (no skips in I slices) ends the slice
+            int inc = 0;
+            for (;;)
+            {
+                if (ubits(11) == 8) // escape
+                {
+                    dump(11);
+                    inc += 33;
+                    continue;
+                }
+                if (ubits(11) == 15) // stuffing
+                {
+                    dump(11);
+                    continue;
+                }
+                const VlcEnt *a = vlc_get(&v_mbai);
+                if (!a->len || a->a > 33)
+                {
+                    inc = -1;
+                    break;
+                }
+                dump(a->len);
+                inc += a->a;
+                break;
+            }
+            if (inc < 0)
+                break;
+            if (inc > 1)
+                ipu.dc_pred[0] = ipu.dc_pred[1] = ipu.dc_pred[2] = 128 << ctrl_idp();
+        }
+        ipu.cbp = 0x3f;
+        ipu.ctrl &= ~(CTRL_SCD | CTRL_ECD);
+        check_start_code();
+    }
+    void cmd_vdec(uint32_t v)
+    {
+        int tbl = (v >> 26) & 3;
+        uint32_t data = 0;
+        switch (tbl)
+        {
+        case 0: // macroblock address increment
+        {
+            const VlcEnt *e = vlc_get(&v_mbai);
+            if (e->len)
+            {
+                dump(e->len);
+                data = static_cast<uint32_t>(e->a) | (static_cast<uint32_t>(e->len) << 16);
+            }
+            break;
+        }
+        case 1: // macroblock type for the picture type in IPU_CTRL
+        {
+            int pct = ctrl_pct();
+            if (pct < 1 || pct > 3)
+                pct = 1;
+            const VlcEnt *e = vlc_get(&v_mbt[pct - 1]);
+            if (e->len)
+            {
+                dump(e->len);
+                data = static_cast<uint32_t>(e->a);
+                if (pct == 2 && (e->a & 0x08))
+                    data |= 0x80; // frame motion type
+                if (pct == 3)
+                    data |= 0x80 | (static_cast<uint32_t>(e->len) << 16);
+            }
+            break;
+        }
+        case 2: // motion code
+        {
+            const VlcEnt *e = vlc_get(&v_mv);
+            if (e->len)
+            {
+                dump(e->len);
+                if (e->a == 0)
+                    data = 0x00010000;
+                else
+                {
+                    int neg = static_cast<int>(gbits(1));
+                    int d = neg ? -e->a : e->a;
+                    data = static_cast<uint32_t>(d) | (static_cast<uint32_t>(e->len) << 16);
+                }
+            }
+            break;
+        }
+        case 3: // dual-prime vector
+        {
+            uint32_t b = ubits(2);
+            if (b < 2)
+            {
+                dump(1);
+                data = 0x00010000;
+            }
+            else
+            {
+                dump(2);
+                data = (b == 2 ? 1u : 0xffffffffu) | (2u << 16);
+            }
+            break;
+        }
+        }
+        ipu.cmd_data = data;
+        if (data == 0)
+            ipu.ctrl |= CTRL_ECD;
+        else
+            ipu.ctrl &= ~CTRL_ECD;
+        ipu.top = peek32();
+    }
+    void cmd_setiq(uint32_t v)
+    {
+        uint8_t *m = (v >> 27) & 1 ? ipu.niq : ipu.iq;
+        for (int i = 0; i < 64; i++)
+            m[i] = static_cast<uint8_t>(gbits(8));
+    }
+    void cmd_setvq()
+    {
+        for (int i = 0; i < 16; i++)
+        {
+            uint16_t lo = static_cast<uint16_t>(gbits(8)), hi = static_cast<uint16_t>(gbits(8));
+            ipu.vqclut[i] = static_cast<uint16_t>(lo | (hi << 8));
+        }
+    }
+    void cmd_csc(uint32_t v)
+    {
+        int mbc = v & 0x7ff, dte = (v >> 26) & 1, ofm = (v >> 27) & 1;
+        static MB8 m;
+        static uint32_t rgb[256];
+        static uint16_t rgb16[256];
+        for (int n = 0; n < mbc; n++)
+        {
+            uint8_t *p = &m.y[0][0];
+            for (int i = 0; i < 384; i++)
+                p[i] = static_cast<uint8_t>(gbits(8));
+            csc_rgb32(&m, rgb);
+            if (ofm)
+            {
+                rgb32_to_16(rgb, rgb16, dte);
+                out_block(rgb16, 32);
+            }
+            else
+                out_block(rgb, 64);
+        }
+    }
+    void cmd_pack(uint32_t v)
+    {
+        int mbc = v & 0x7ff, dte = (v >> 26) & 1, ofm = (v >> 27) & 1;
+        static uint32_t rgb[256];
+        static uint16_t rgb16[256];
+        static uint8_t idx[128];
+        for (int n = 0; n < mbc; n++)
+        {
+            for (int i = 0; i < 256; i++)
+            {
+                uint32_t c = 0;
+                for (int k = 0; k < 4; k++)
+                    c |= gbits(8) << (8 * k);
+                rgb[i] = c;
+            }
+            rgb32_to_16(rgb, rgb16, dte);
+            if (ofm)
+            {
+                out_block(rgb16, 32);
+                continue;
+            }
+            for (int i = 0; i < 256; i += 2) // nearest VQ CLUT entry for each pixel, two per byte
+            {
+                int best[2] = {0, 0};
+                for (int h = 0; h < 2; h++)
+                {
+                    int bd = 1 << 30;
+                    uint16_t c = rgb16[i + h];
+                    for (int k = 0; k < 16; k++)
+                    {
+                        uint16_t q = ipu.vqclut[k];
+                        int dr = (c & 31) - (q & 31), dg = ((c >> 5) & 31) - ((q >> 5) & 31), db = ((c >> 10) & 31) - ((q >> 10) & 31);
+                        int d = dr * dr + dg * dg + db * db;
+                        if (d < bd)
+                        {
+                            bd = d;
+                            best[h] = k;
+                        }
+                    }
+                }
+                idx[i / 2] = static_cast<uint8_t>(best[0] | (best[1] << 4));
+            }
+            out_block(idx, 8);
+        }
+    }
+
+    int pending_skip;
+    void co_entry()
+    {
+        for (;;)
+        {
+            uint32_t v = ipu.cur;
+            if (pending_skip)
+            {
+                need(pending_skip);
+                dump(pending_skip);
+                pending_skip = 0;
+            }
+            switch (v >> 28)
+            {
+            case C_IDEC:
+                cmd_idec(v);
+                break;
+            case C_BDEC:
+                cmd_bdec(v);
+                break;
+            case C_VDEC:
+                cmd_vdec(v);
+                break;
+            case C_FDEC:
+                ipu.cmd_data = peek32();
+                ipu.top = ipu.cmd_data;
+                break;
+            case C_SETIQ:
+                cmd_setiq(v);
+                break;
+            case C_SETVQ:
+                cmd_setvq();
+                break;
+            case C_CSC:
+                cmd_csc(v);
+                break;
+            case C_PACK:
+                cmd_pack(v);
+                break;
+            }
+            co_running = 0;
+            coro_yield(); // finished; the next command restarts the loop
+        }
+    }
+
+    // ------------------------------------------------------------------ driving
+    int ipulog = -1;
+    // the last commands, dumped when a movie's stream runs out (debugging aid)
+    struct HistEntry
+    {
+        uint32_t cmd, data, top;
+        int bp, fp, ifc;
+        uint32_t ctrl;
+    };
+    HistEntry g_hist[32];
+    unsigned g_histN = 0;
+    void finish_cmd()
+    {
+        {
+            static int n;
+            if (ipulog > 1 && n++ < 400000)
+                std::fprintf(stderr, "[ipu]   done %08x -> data %08x top %08x ctrl %08x bp %d fp %d ifc %d\n", ipu.cur, ipu.cmd_data, ipu.top, ipu.ctrl,
+                             ipu.bp, ipu.fp, ipu.ifc);
+        }
+        {
+            g_hist[g_histN % 32] = HistEntry{ipu.cur, ipu.cmd_data, ipu.top, ipu.bp, ipu.fp, ipu.ifc, ipu.ctrl};
+            ++g_histN;
+        }
+        ipu.ctrl &= ~CTRL_BUSY;
+        ipu.cmd_busy = 0;
+        ipu.top_busy = 0;
+        raiseIntc(8);
+    }
+    void (*g_chargeHook)(uint64_t) = nullptr;
+    void pumpImpl();
+    // run until nothing moves: DMA in, coroutine, DMA out; the host time it took is charged to the EE clock
+    void pump()
+    {
+        if (!g_chargeHook || !co_running)
+        {
+            pumpImpl();
+            return;
+        }
+        const auto t0 = std::chrono::steady_clock::now();
+        pumpImpl();
+        const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count();
+        if (ns > 0)
+            g_chargeHook(static_cast<uint64_t>(ns));
+    }
+    void pumpImpl()
+    {
+        if (ipulog > 0)
+        {
+            static uint64_t t0;
+            uint64_t now = hostUsec();
+            if (now - t0 > 1000000)
+            {
+                t0 = now;
+                std::fprintf(stderr,
+                             "[ipu] state: cmd %08x running %d wait %d ifc %d fp %d bp %d ofc %d ctrl %08x | d3 chcr %08x madr %08x qwc %x | d4 chcr %08x madr %08x qwc %x tadr %08x end %d\n",
+                             ipu.cur, co_running, co_wait, ipu.ifc, ipu.fp, ipu.bp, ipu.ofc, ipu.ctrl, CHCR(D3), MADR(D3), QWC(D3), CHCR(D4), MADR(D4), QWC(D4),
+                             TADR(D4), ipu.d4_tag_end);
+            }
+        }
+        for (int guard = 0; guard < 100000; guard++)
+        {
+            int progress = d4_fill() + d3_drain();
+            if (co_running)
+            {
+                int can = co_wait == 1 ? (ipu.ifc > 0 || d4_active()) : co_wait == 2 ? (ipu.ofc < 8) : 1;
+                if (can)
+                {
+                    int ifc0 = ipu.ifc, ofc0 = ipu.ofc, fp0 = ipu.fp, bp0 = ipu.bp;
+                    coro_resume();
+                    if (!co_running)
+                        finish_cmd();
+                    progress += !co_running || ipu.ifc != ifc0 || ipu.ofc != ofc0 || ipu.fp != fp0 || ipu.bp != bp0;
+                }
+            }
+            if (!progress)
+                break;
+        }
+    }
+    void co_reset()
+    {
+        if (co_ipu)
+            DeleteFiber(co_ipu); // suspended (never the running fiber here): an unfinished command is abandoned
+        co_ipu = CreateFiber(1u << 18, coFiberProc, nullptr);
+        co_running = 0;
+        co_wait = 0;
+    }
+    std::atomic<int64_t> g_lastCmdNs{0};
+    void start_cmd(uint32_t v)
+    {
+        g_lastCmdNs.store(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count(),
+                          std::memory_order_relaxed);
+        tables_init();
+        if (!co_ipu || co_running)
+            co_reset(); // a new command abandons an unfinished one
+        if (ipulog < 0)
+            ipulog = std::getenv("APE2_IPULOG") ? std::atoi(std::getenv("APE2_IPULOG")) : 0;
+        {
+            static int n;
+            if (ipulog > 1 && n++ < 400000)
+                std::fprintf(stderr, "[ipu] cmd %x (%08x) ifc %d fp %d bp %d\n", v >> 28, v, ipu.ifc, ipu.fp, ipu.bp);
+        }
+        {
+            static uint32_t cnt[16], tot;
+            static uint64_t t0;
+            cnt[v >> 28]++;
+            tot++;
+            uint64_t now = hostUsec();
+            if (!t0)
+                t0 = now;
+            if (ipulog && now - t0 > 1000000)
+            {
+                t0 = now;
+                std::fprintf(stderr, "[ipu] 1s: %u cmds: bclr %u idec %u bdec %u vdec %u fdec %u setiq %u csc %u; d3 chcr %x qwc %x d4 chcr %x qwc %x\n", tot, cnt[0],
+                             cnt[1], cnt[2], cnt[3], cnt[4], cnt[5], cnt[7], CHCR(D3), QWC(D3), CHCR(D4), QWC(D4));
+                std::memset(cnt, 0, sizeof cnt);
+                tot = 0;
+            }
+        }
+        ipu.ctrl &= ~(CTRL_ECD | CTRL_SCD);
+        ipu.cur = v;
+        int c = v >> 28;
+        if (c == C_BCLR)
+        {
+            ipu.ifc = ipu.fr = 0;
+            ipu.fp = 0;
+            ipu.bp = v & 0x7f;
+            ipu.ctrl &= ~CTRL_BUSY;
+            ipu.cmd_busy = 0;
+            raiseIntc(8);
+            pump();
+            return;
+        }
+        if (c == C_SETTH)
+        {
+            ipu.th0 = v & 0x1ff;
+            ipu.th1 = (v >> 16) & 0x1ff;
+            ipu.ctrl &= ~CTRL_BUSY;
+            raiseIntc(8);
+            return;
+        }
+        ipu.ctrl |= CTRL_BUSY;
+        if (c == C_VDEC || c == C_FDEC)
+        {
+            ipu.cmd_busy = 0x80000000u;
+            ipu.top_busy = 0x80000000u;
+        }
+        if (c == C_IDEC || c == C_BDEC)
+            ipu.top_busy = 0x80000000u;
+        pending_skip = (c == C_IDEC || c == C_BDEC || c == C_VDEC || c == C_FDEC || c == C_SETIQ) ? static_cast<int>(v & 0x3f) : 0;
+        co_running = 1;
+        co_wait = 0;
+        pump();
+    }
+
+    // the next 32 bits for a register read, without waiting: 0 if not enough data yet
+    int peek32_nb(uint32_t *out)
+    {
+        while (ipu.fp * 128 < ipu.bp + 32)
+        {
+            if (!ipu.ifc)
+                d4_fill();
+            if (!ipu.ifc || ipu.fp >= 2)
+                return 0;
+            std::memcpy(ipu.ib[ipu.fp], ipu.fifo[ipu.fr], 16);
+            ipu.fr = (ipu.fr + 1) & 7;
+            ipu.ifc--;
+            ipu.fp++;
+        }
+        int byte = ipu.bp >> 3, sh = ipu.bp & 7;
+        uint64_t v = 0;
+        for (int i = 0; i < 5; i++)
+            v = (v << 8) | (byte + i < 32 ? (&ipu.ib[0][0])[byte + i] : 0);
+        *out = static_cast<uint32_t>(v >> (8 - sh));
+        return 1;
+    }
+    void soft_reset()
+    {
+        ipu.ifc = ipu.fr = ipu.fp = ipu.bp = 0;
+        ipu.ofc = ipu.or_ = 0;
+        ipu.cbp = 0;
+        ipu.th0 = ipu.th1 = 0;
+        ipu.ctrl &= 0x7f33f00u;
+        ipu.top = 0;
+        ipu.top_busy = 0;
+        ipu.cmd_data = 0;
+        ipu.cmd_busy = 0;
+        if (co_ipu)
+            co_reset();
+        raiseIntc(8);
+    }
+}
+
+namespace ps2ipu
+{
+    void setHost(const Host &host)
+    {
+        std::lock_guard<std::recursive_mutex> lock(g_lock);
+        g_host = host;
+    }
+
+    bool handles(uint32_t a) { return (a & 0xffffff00u) == 0x10002000u; }
+
+    uint64_t read64(uint32_t a)
+    {
+        std::lock_guard<std::recursive_mutex> lock(g_lock);
+        pump();
+        // End of a movie. libmpeg feeds the IPU whole qwords from its ring, so the last bytes of the video
+        // stream - the sequence end code 00 00 01 B7 after the zero padding - wait there for more data that never
+        // comes, and libmpeg scans the padding for the next start code forever (a white screen after every
+        // movie). The game's own end path sends exactly one qword "00 00 01 B7" to the IPU (its background
+        // callback, 0x1A9248, once its error callback 0x1A9238 has flagged the end). When a command has waited
+        // for input for APE2_IPU_EOS_MS (default 500) with the toIPU DMA idle, that qword is put into the input
+        // FIFO, once per stall (0 disables).
+        {
+            static const long long eosMs = [] { const char *e = std::getenv("APE2_IPU_EOS_MS"); return e ? std::atoll(e) : 500LL; }();
+            static bool starving = false, fed = false;
+            static std::chrono::steady_clock::time_point since{};
+            if (eosMs > 0 && co_running && co_wait == 1 && !ipu.ifc && !d4_active())
+            {
+                const auto now = std::chrono::steady_clock::now();
+                if (!starving)
+                {
+                    starving = true;
+                    fed = false;
+                    since = now;
+                }
+                else if (!fed && now - since > std::chrono::milliseconds(eosMs))
+                {
+                    fed = true;
+                    static const uint8_t seqEnd[16] = {0x00, 0x00, 0x01, 0xB7};
+                    std::memcpy(ipu.fifo[(ipu.fr + ipu.ifc) & 7], seqEnd, 16);
+                    ipu.ifc++;
+                    static int reports = 0;
+                    if (reports++ < 8)
+                        std::fprintf(stderr, "[ipu] stream ran out mid-scan (cmd %08x): sequence end code fed\n", ipu.cur);
+                    pump();
+                }
+            }
+            else
+                starving = false;
+        }
+        switch (a & 0xf0)
+        {
+        case 0x00:
+        {
+            int c = ipu.cur >> 28;
+            if (!(ipu.ctrl & CTRL_BUSY) && c != C_VDEC && c != C_FDEC)
+            {
+                uint32_t t;
+                if (peek32_nb(&t))
+                    ipu.cmd_data = t;
+            }
+            {
+                static unsigned long long reads = 0;
+                if (ipulog > 1 && ((++reads & 0xFFFFFu) == 0u || reads < 4u))
+                    std::fprintf(stderr, "[ipu] read cmd #%llu: data %08x busy %08x cur %08x running %d wait %d ifc %d fp %d d4 chcr %08x qwc %x\n", reads, ipu.cmd_data,
+                                 ipu.cmd_busy, ipu.cur, co_running, co_wait, ipu.ifc, ipu.fp, CHCR(D4), QWC(D4));
+            }
+            return ipu.cmd_data | (static_cast<uint64_t>(ipu.cmd_busy) << 32);
+        }
+        case 0x10:
+            return (ipu.ctrl & ~0x3fffu) | static_cast<uint32_t>(ipu.ifc) | (static_cast<uint32_t>(ipu.ofc) << 4) |
+                   (static_cast<uint32_t>(ipu.cbp & 63) << 8);
+        case 0x20:
+            return static_cast<uint32_t>(ipu.bp & 0x7f) | (static_cast<uint32_t>(ipu.ifc) << 8) | (static_cast<uint32_t>(ipu.fp) << 16);
+        case 0x30:
+        {
+            if (!(ipu.ctrl & CTRL_BUSY))
+            {
+                uint32_t t;
+                if (peek32_nb(&t))
+                {
+                    ipu.top = t;
+                    ipu.top_busy = 0;
+                }
+                else
+                    ipu.top_busy = 0x80000000u;
+            }
+            return ipu.top | (static_cast<uint64_t>(ipu.top_busy) << 32);
+        }
+        }
+        return 0;
+    }
+
+    uint32_t read32(uint32_t a)
+    {
+        uint64_t v = read64(a & ~7u);
+        return (a & 4) ? static_cast<uint32_t>(v >> 32) : static_cast<uint32_t>(v);
+    }
+
+    void write32(uint32_t a, uint32_t v)
+    {
+        std::lock_guard<std::recursive_mutex> lock(g_lock);
+        switch (a & 0xf4)
+        {
+        case 0x00:
+            start_cmd(v);
+            break;
+        case 0x10:
+            ipu.ctrl = (v & 0x47f30000u) | (ipu.ctrl & 0x8000ffffu);
+            if (((ipu.ctrl >> 16) & 3) == 3)
+                ipu.ctrl = (ipu.ctrl & ~(3u << 16)) | (1u << 16);
+            if (v & (1u << 30))
+                soft_reset();
+            ipu.ctrl &= ~(1u << 30);
+            break;
+        }
+    }
+
+    // FIFO registers: 0x10007000 output (read), 0x10007010 input (write)
+    void fifoRead(uint8_t out[16])
+    {
+        std::lock_guard<std::recursive_mutex> lock(g_lock);
+        pump();
+        if (ipu.ofc)
+        {
+            std::memcpy(out, ipu.ofifo[ipu.or_], 16);
+            ipu.or_ = (ipu.or_ + 1) & 7;
+            ipu.ofc--;
+        }
+        else
+            std::memset(out, 0, 16);
+        pump();
+    }
+
+    void fifoWrite(const uint8_t in[16])
+    {
+        std::lock_guard<std::recursive_mutex> lock(g_lock);
+        if (ipu.ifc < 8)
+        {
+            std::memcpy(ipu.fifo[(ipu.fr + ipu.ifc) & 7], in, 16);
+            ipu.ifc++;
+        }
+        pump();
+    }
+
+    void dmaStart(int ch)
+    {
+        std::lock_guard<std::recursive_mutex> lock(g_lock);
+        if (ch == 4)
+        {
+            uint32_t chcr = CHCR(D4);
+            int chain = ((chcr >> 2) & 3) == 1;
+            if (!chain)
+            {
+                ipu.d4_tag_active = 1;
+                ipu.d4_tag_end = 1;
+            }
+            else if ((QWC(D4) & 0xffff) == 0)
+            {
+                ipu.d4_tag_active = 0;
+                ipu.d4_tag_end = 0;
+            }
+            else // resuming inside a tag: does it end the chain?
+            {
+                uint32_t id = (chcr >> 28) & 7, irq = chcr >> 31;
+                ipu.d4_tag_active = 1;
+                ipu.d4_tag_end = id == 0 || id == 7 || (irq && (chcr & 0x80));
+            }
+        }
+        pump();
+    }
+
+    bool activeWithin(int ms)
+    {
+        const int64_t last = g_lastCmdNs.load(std::memory_order_relaxed);
+        if (last == 0)
+            return false;
+        const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        return now - last < static_cast<int64_t>(ms) * 1000000;
+    }
+
+    void setChargeHook(void (*hook)(uint64_t hostNs))
+    {
+        std::lock_guard<std::recursive_mutex> lock(g_lock);
+        g_chargeHook = hook;
+    }
+
+    void poll()
+    {
+        std::lock_guard<std::recursive_mutex> lock(g_lock);
+        if (co_running || ipu.ofc || ipu.ifc)
+            pump();
+    }
+}
