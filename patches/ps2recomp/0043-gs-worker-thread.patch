+namespace
+{
+    thread_local bool t_onGsWorker = false;
+    uint64_t gsWorkerNowUs()
+    {
+        return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                         std::chrono::steady_clock::now().time_since_epoch())
+                                         .count());
+    }
+}
+
+bool PS2Memory::onGsWorker()
+{
+    return t_onGsWorker;
+}
+
+void PS2Memory::startGsWorker()
+{
+    const char *env = std::getenv("APE2_MTGS");
+    if ((env && std::atoi(env) == 0) || std::thread::hardware_concurrency() < 3u)
+        return;
+    m_gsWorkerStop = false;
+    m_gsWorker = std::thread([this]
+                             { gsWorkerMain(); });
+    m_gsWorkerEnabled = true;
+    std::fprintf(stderr, "[mtgs] VIF1, VU1, GIF and the GS front end run on a worker thread\n");
+}
+
+void PS2Memory::stopGsWorker()
+{
+    if (!m_gsWorker.joinable())
+        return;
+    {
+        std::lock_guard<std::mutex> lock(m_gsWorkMutex);
+        m_gsWorkerStop = true;
+    }
+    m_gsWorkCv.notify_all();
+    m_gsWorker.join();
+    m_gsWorkerEnabled = false;
+}
+
+void PS2Memory::enqueueGsWork(bool vif1, bool fromScratchpad, uint32_t srcAddr, uint32_t qwc)
+{
+    uint32_t srcPhys = 0;
+    try
+    {
+        srcPhys = translateAddress(srcAddr);
+    }
+    catch (const std::exception &)
+    {
+        return;
+    }
+    const uint8_t *base = fromScratchpad ? m_scratchpad : m_rdram;
+    const uint32_t size = fromScratchpad ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+    std::vector<uint8_t> data(static_cast<size_t>(qwc) * 16u);
+    size_t done = 0;
+    while (done < data.size())
+    {
+        if (srcPhys >= size)
+            srcPhys = 0;
+        const size_t chunk = std::min<size_t>(data.size() - done, size - srcPhys);
+        std::memcpy(data.data() + done, base + srcPhys, chunk);
+        done += chunk;
+        srcPhys += static_cast<uint32_t>(chunk);
+    }
+    enqueueGsWork(vif1, std::move(data));
+}
+
+void PS2Memory::enqueueGsWork(bool vif1, std::vector<uint8_t> &&data)
+{
+    if (data.empty())
+        return;
+    std::unique_lock<std::mutex> lock(m_gsWorkMutex);
+    // keep the EE at most this far ahead of the worker
+    constexpr size_t kMaxQueuedBytes = 48u << 20;
+    if (m_gsWorkBytes > kMaxQueuedBytes)
+    {
+        const uint64_t t0 = gsWorkerNowUs();
+        m_gsIdleCv.wait(lock, [this]
+                        { return m_gsWorkBytes <= kMaxQueuedBytes / 2u; });
+        m_gsSyncCount[7].fetch_add(1, std::memory_order_relaxed);
+        m_gsSyncWaitUs[7].fetch_add(gsWorkerNowUs() - t0, std::memory_order_relaxed);
+    }
+    m_gsWorkBytes += data.size();
+    GsWorkItem item;
+    item.vif1 = vif1;
+    item.data = std::move(data);
+    m_gsWork.push_back(std::move(item));
+    lock.unlock();
+    m_gsWorkCv.notify_one();
+}
+
+void PS2Memory::syncGsWorker(int reason)
+{
+    if (!m_gsWorkerEnabled || t_onGsWorker)
+        return;
+    std::unique_lock<std::mutex> lock(m_gsWorkMutex);
+    if (m_gsWork.empty() && !m_gsWorkerBusy)
+        return;
+    const uint64_t t0 = gsWorkerNowUs();
+    m_gsIdleCv.wait(lock, [this]
+                    { return m_gsWork.empty() && !m_gsWorkerBusy; });
+    const int r = (reason >= 0 && reason < 8) ? reason : 0;
+    m_gsSyncCount[r].fetch_add(1, std::memory_order_relaxed);
+    m_gsSyncWaitUs[r].fetch_add(gsWorkerNowUs() - t0, std::memory_order_relaxed);
+}
+
+void PS2Memory::gsWorkerMain()
+{
+    t_onGsWorker = true;
+    static const bool stats = std::getenv("APE2_MTGS_STATS") != nullptr;
+    uint64_t busyUs = 0, lastReport = gsWorkerNowUs();
+    for (;;)
+    {
+        GsWorkItem item;
+        {
+            std::unique_lock<std::mutex> lock(m_gsWorkMutex);
+            m_gsWorkerBusy = false;
+            if (m_gsWork.empty())
+                m_gsIdleCv.notify_all();
+            m_gsWorkCv.wait(lock, [this]
+                            { return m_gsWorkerStop || !m_gsWork.empty(); });
+            if (m_gsWorkerStop)
+                return;
+            item = std::move(m_gsWork.front());
+            m_gsWork.pop_front();
+            m_gsWorkerBusy = true;
+        }
+        const uint64_t t0 = stats ? gsWorkerNowUs() : 0;
+        if (item.vif1)
+            processVIF1Data(item.data.data(), static_cast<uint32_t>(item.data.size()));
+        else
+        {
+            m_seenGifCopy = true;
+            m_gifCopyCount.fetch_add(1, std::memory_order_relaxed);
+            submitGifPacket(GifPathId::Path3, item.data.data(), static_cast<uint32_t>(item.data.size()), false);
+        }
+        if (m_gifArbiter)
+            m_gifArbiter->drain();
+        {
+            std::lock_guard<std::mutex> lock(m_gsWorkMutex);
+            m_gsWorkBytes -= item.data.size();
+            if (m_gsWorkBytes <= (24u << 20))
+                m_gsIdleCv.notify_all();
+        }
+        if (stats)
+        {
+            const uint64_t now = gsWorkerNowUs();
+            busyUs += now - t0;
+            if (now - lastReport >= 5000000u)
+            {
+                static const char *names[8] = {"other", "vu1mem", "vif1fifo", "vif1w", "gifw", "vif1r", "gifr", "full"};
+                std::fprintf(stderr, "[mtgs] worker busy %.0f%%; EE waits:", 100.0 * static_cast<double>(busyUs) / static_cast<double>(now - lastReport));
+                for (int k = 0; k < 8; ++k)
+                {
+                    const uint64_t c = m_gsSyncCount[k].exchange(0), w = m_gsSyncWaitUs[k].exchange(0);
+                    if (c)
+                        std::fprintf(stderr, " %s %llu (%.1f ms)", names[k], static_cast<unsigned long long>(c), static_cast<double>(w) / 1000.0);
+                }
+                std::fprintf(stderr, "\n");
+                busyUs = 0;
+                lastReport = now;
+            }
+        }
+    }
+}
