+const GSCpuBackend::DecodedTexture *GSCpuBackend::PrepareTexture(const GSDrawState &state)
+{
+    // APE2_GS_TEXCACHE=0 samples VRAM directly (as before)
+    static const bool disabled = [] { const char *e = std::getenv("APE2_GS_TEXCACHE"); return e && e[0] == '0'; }();
+    if (disabled || !m_vram)
+        return nullptr;
+    const auto &tex = state.context.tex0;
+    const int w = state.textureWidth, h = state.textureHeight;
+    if (w <= 0 || h <= 0 || w > 1024 || h > 1024)
+        return nullptr;
+    const bool indexed = tex.psm == GS_PSM_T8 || tex.psm == GS_PSM_T8H || tex.psm == GS_PSM_T4 || tex.psm == GS_PSM_T4HL ||
+                         tex.psm == GS_PSM_T4HH;
+    uint64_t key[3];
+    key[0] = static_cast<uint64_t>(tex.tbp0) | (static_cast<uint64_t>(tex.tbw) << 16) | (static_cast<uint64_t>(tex.psm) << 24) |
+             (static_cast<uint64_t>(w) << 32) | (static_cast<uint64_t>(h) << 48);
+    key[1] = 0u;
+    if (indexed)
+    {
+        // the palette contents are part of the key: the game switches palettes on the same texture
+        if (m_clutHash == 0u)
+        {
+            uint64_t h = 1469598103934665603ull;
+            const uint8_t *bytes = reinterpret_cast<const uint8_t *>(m_clut.data());
+            for (size_t i = 0; i < sizeof(m_clut); i += 8)
+            {
+                uint64_t w;
+                std::memcpy(&w, bytes + i, 8);
+                h = (h ^ w) * 1099511628211ull;
+                h ^= h >> 29;
+            }
+            m_clutHash = h | 1u;
+        }
+        key[1] = (m_clutHash ^ (static_cast<uint64_t>(tex.cpsm) | (static_cast<uint64_t>(tex.csm) << 8) |
+                                (static_cast<uint64_t>(tex.csa) << 16))) * 1099511628211ull;
+    }
+    key[2] = static_cast<uint64_t>(state.texa.ta0) | (static_cast<uint64_t>(state.texa.ta1) << 8) |
+             (static_cast<uint64_t>(state.texa.aem ? 1u : 0u) << 16);
+
+    constexpr size_t kMaxTextures = 256u;
+    size_t slot = SIZE_MAX;
+    for (size_t i = 0; i < m_textureCache.size(); ++i)
+    {
+        DecodedTexture &t = m_textureCache[i];
+        if (t.key[0] == key[0] && t.key[1] == key[1] && t.key[2] == key[2])
+        {
+            if (TextureStillValid(t))
+            {
+                ++m_texStats[0];
+                return &t;
+            }
+            ++m_texStats[1];
+            if (t.indexed && t.clutVersion != m_clutVersion)
+                ++m_texStats[3];
+            slot = i; // stale: decode again in place
+            break;
+        }
+    }
+    if (slot == SIZE_MAX)
+    {
+        if (m_textureCache.size() < kMaxTextures)
+        {
+            m_textureCache.emplace_back();
+            slot = m_textureCache.size() - 1u;
+        }
+        else
+        {
+            slot = m_textureCacheNext;
+            m_textureCacheNext = (m_textureCacheNext + 1u) % kMaxTextures;
+        }
+    }
+    ++m_texStats[2];
+    m_texStats[4] += static_cast<uint64_t>(w) * static_cast<uint64_t>(h);
+    {
+        static const bool stats = std::getenv("APE2_GS_TEXSTATS") != nullptr;
+        if (stats && (m_texStats[2] & 0x3FFu) == 0u)
+            std::fprintf(stderr, "[gs:texcache] hits %llu stale %llu (clut %llu) decodes %llu texels decoded %llu\n",
+                         static_cast<unsigned long long>(m_texStats[0]), static_cast<unsigned long long>(m_texStats[1]),
+                         static_cast<unsigned long long>(m_texStats[3]), static_cast<unsigned long long>(m_texStats[2]),
+                         static_cast<unsigned long long>(m_texStats[4]));
+    }
+    DecodedTexture &t = m_textureCache[slot];
+    t.key[0] = key[0];
+    t.key[1] = key[1];
+    t.key[2] = key[2];
+    t.indexed = indexed;
+    t.clutVersion = m_clutVersion;
+    t.w = w;
+    t.h = h;
+    t.texels.resize(static_cast<size_t>(w) * static_cast<size_t>(h));
+    t.tilesW = (w + 7) / 8;
+    const size_t tiles = static_cast<size_t>(t.tilesW) * static_cast<size_t>((h + 7) / 8);
+    if (t.tileCount != tiles)
+    {
+        t.tileReady.reset(new std::atomic<uint8_t>[tiles]);
+        t.tileCount = tiles;
+    }
+    for (size_t i = 0; i < tiles; ++i)
+        t.tileReady[i].store(0u, std::memory_order_relaxed);
+
+    // VRAM pages the texture covers; one extra row and column for a base that is not page-aligned
+    uint32_t pw, ph;
+    vramPageSize(tex.psm, pw, ph);
+    t.firstPage = (tex.tbp0 >> 5) & 511u;
+    t.pagesPerRow = vramPagesPerRow(tex.psm, tex.tbw);
+    t.pageRows = (static_cast<uint32_t>(h) + ph - 1u) / ph + 1u;
+    t.pageCols = std::min(t.pagesPerRow, (static_cast<uint32_t>(w) + pw - 1u) / pw + 1u);
+    t.decodeEpoch = m_vramEpoch;
+    ++m_vramEpoch; // writes from here on (this draw included) are newer than the decode
+    return &t;
+}
