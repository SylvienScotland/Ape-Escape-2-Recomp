+namespace
+{
+    // PS2 VRAM page (8 KB) size in pixels for a storage format
+    void vramPageSize(uint32_t psm, uint32_t &pw, uint32_t &ph)
+    {
+        pw = 64u;
+        ph = 32u; // 32-bit layouts (CT32/24, Z32/24, and T8H/T4HL/T4HH stored in them)
+        if (psm == GS_PSM_CT16 || psm == GS_PSM_CT16S || psm == GS_PSM_Z16 || psm == GS_PSM_Z16S)
+            ph = 64u;
+        else if (psm == GS_PSM_T8)
+        {
+            pw = 128u;
+            ph = 64u;
+        }
+        else if (psm == GS_PSM_T4)
+        {
+            pw = 128u;
+            ph = 128u;
+        }
+    }
+    uint32_t vramPagesPerRow(uint32_t psm, uint32_t bw)
+    {
+        uint32_t pw, ph;
+        vramPageSize(psm, pw, ph);
+        return std::max(1u, ((bw ? bw : 1u) * 64u + pw - 1u) / pw);
+    }
+}
+
+uint32_t GSCpuBackend::VramPageOf(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y)
+{
+    uint32_t pw, ph;
+    vramPageSize(psm, pw, ph);
+    return ((base >> 5) + (y / ph) * vramPagesPerRow(psm, bw) + (x / pw)) & 511u;
+}
+
+uint32_t GSCpuBackend::DecodeTexel(const GSDrawState &state, int u, int v)
+{
+    const auto &tex = state.context.tex0;
+    const u32 out = ReadTextureVramUnlocked(tex.psm, tex.tbp0, tex.tbw, static_cast<uint32_t>(u), static_cast<uint32_t>(v));
+    switch (tex.psm)
+    {
+    case GS_PSM_CT32:
+    case GS_PSM_Z32:
+    case GS_PSM_CT24:
+    case GS_PSM_Z24:
+        return applyTexa(state.texa, tex.psm, out);
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+    case GS_PSM_Z16:
+    case GS_PSM_Z16S:
+        return applyTexa(state.texa, tex.psm, Rgba5551ToRgba8888(out));
+    case GS_PSM_T8:
+    case GS_PSM_T8H:
+    case GS_PSM_T4:
+    case GS_PSM_T4HL:
+    case GS_PSM_T4HH:
+        return LookupCLUT(state, static_cast<u8>(out), tex.cpsm, tex.csm, tex.csa, tex.psm);
+    }
+    return 0xFFFF00FFu;
+}
+
+bool GSCpuBackend::TextureStillValid(const DecodedTexture &t) const
+{
+    for (uint32_t r = 0; r < t.pageRows; ++r)
+        for (uint32_t c = 0; c < t.pageCols; ++c)
+            if (m_pageEpoch[(t.firstPage + r * t.pagesPerRow + c) & 511u].load(std::memory_order_relaxed) >= t.decodeEpoch)
+                return false;
+    return true;
+}
