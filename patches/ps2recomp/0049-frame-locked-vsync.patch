diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index e25f39a..bf1ae70 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -39,6 +39,46 @@ namespace
     constexpr uint32_t WEF_CLEAR_ALL = 0x20u;
     constexpr auto kVBlankPeriod = std::chrono::microseconds(16667);
     constexpr auto kVBlankDuration = std::chrono::microseconds(500);
+
+    // Frame-locked vsync (Ape Escape 2 recomp patch 0049): the game moves its camera by the number of vsyncs a
+    // frame took, and overshoots when that is 2 (a frame slower than 16.7 ms): the camera shook. A vsync is held
+    // until the game has finished the frame it started at the previous one (a stage frame, overrides/
+    // zz_ape2_frame_mark.cpp), so every
+    // frame sees one vsync and a slow frame plays a little slower instead, as in the PAL port. A vsync is never
+    // held longer than four periods; screens without the frame mark run free. APE2_VSYNC_FRAMELOCK=0 disables it.
+    std::atomic<uint64_t> g_gameFramesDone{0};
+    uint64_t g_gameFramesAtVsync = 0;
+    std::chrono::steady_clock::time_point g_vsyncHeldSince{};
+
+    bool holdVBlankForGameFrame()
+    {
+        static const bool enabled = []
+        {
+            const char *e = std::getenv("APE2_VSYNC_FRAMELOCK");
+            return !e || std::atoi(e) != 0;
+        }();
+        const uint64_t frames = g_gameFramesDone.load(std::memory_order_acquire);
+        const auto now = std::chrono::steady_clock::now();
+        // only while the game is running frames that mark their end (stages); other screens run free
+        static uint64_t lastFrames = 0;
+        static std::chrono::steady_clock::time_point lastFrameSeen{};
+        if (frames != lastFrames)
+        {
+            lastFrames = frames;
+            lastFrameSeen = now;
+        }
+        const bool active = frames != 0u && now - lastFrameSeen < std::chrono::milliseconds(250);
+        if (enabled && active && frames == g_gameFramesAtVsync)
+        {
+            if (g_vsyncHeldSince == std::chrono::steady_clock::time_point{})
+                g_vsyncHeldSince = now;
+            if (now - g_vsyncHeldSince < 4 * kVBlankPeriod)
+                return true;
+        }
+        g_gameFramesAtVsync = frames;
+        g_vsyncHeldSince = {};
+        return false;
+    }
     constexpr uint64_t kAlarmTickMicroseconds = 64u;
     constexpr uint32_t kDebugPublishDispatchInterval = 4096u;
 
@@ -1904,6 +1944,13 @@ void EeScheduler::processDueDeadlines()
 
         for (ScheduledEvent &scheduled : due)
         {
+            if (scheduled.event.type == EeEventType::VBlankStart && holdVBlankForGameFrame())
+            {
+                // the game has not finished the frame it started at the last vsync: look again after it has run a
+                // little further (a cycle deadline, so the EE keeps running rather than waiting here)
+                scheduleEvent(m_eeCycle + kVBlankPeriodCycles / 64u, std::chrono::steady_clock::now(), scheduled.event);
+                continue;
+            }
             if (scheduled.event.type == EeEventType::VBlankStart)
             {
                 scheduleEvent(scheduled.deadlineCycle + kVBlankDurationCycles,
@@ -2216,3 +2263,9 @@ void EeScheduler::publishIdleDebugContext()
         publishDebugContext(selected->activeContext());
     }
 }
+
+// the game finished a stage frame (frame-locked vsync, patch 0049; called by the game's override)
+void ape2NoteGameFrame()
+{
+    g_gameFramesDone.fetch_add(1, std::memory_order_release);
+}
