+    // Trigger axes report -1 (released) .. 1 (fully pressed). Some drivers report 0 until the trigger is first
+    // moved, so the axis is only trusted once it has been seen near -1; until then the digital LT/RT state is used.
+    float triggerTravel(int gamepad, PadInputKind kind)
+    {
+        static bool axisSeenReleased[2] = {false, false};
+        const bool left = kind == PadInputKind::LeftTrigger;
+        const float axis = GetGamepadAxisMovement(gamepad, left ? GAMEPAD_AXIS_LEFT_TRIGGER : GAMEPAD_AXIS_RIGHT_TRIGGER);
+        if (axis < -0.9f)
+            axisSeenReleased[left ? 0 : 1] = true;
+        if (axisSeenReleased[left ? 0 : 1])
+            return std::clamp((axis + 1.0f) * 0.5f, 0.0f, 1.0f);
+        return IsGamepadButtonDown(gamepad, left ? GAMEPAD_BUTTON_LEFT_TRIGGER_2 : GAMEPAD_BUTTON_RIGHT_TRIGGER_2) ? 1.0f : 0.0f;
+    }
+
+    // 0 = released .. 1 = fully pressed.
+    float bindingValue(const Binding &b, int gamepad)
+    {
+        if (b.keyboard)
+            return IsKeyDown(b.key) ? 1.0f : 0.0f;
+        if (gamepad < 0)
+            return 0.0f;
+        if (b.kind == PadInputKind::Button)
+            return IsGamepadButtonDown(gamepad, b.button) ? 1.0f : 0.0f;
+        const float travel = triggerTravel(gamepad, b.kind);
+        return travel >= kTriggerThreshold ? travel : 0.0f;
+    }
+
+    uint8_t stickByte(float v)
+    {
+        if (std::fabs(v) < kStickDeadzone)
+            v = 0.0f;
+        v = std::clamp(v, -1.0f, 1.0f);
+        return static_cast<uint8_t>(std::lround((v + 1.0f) * 127.5f));
+    }
