+            const char *env = std::getenv("APE2_PAD_SCRIPT");
+            if (!env || !*env)
+                return;
+            std::istringstream in(env);
+            std::string item;
+            while (std::getline(in, item, ';'))
+            {
+                ScriptedPress p;
+                char name[32] = {};
+                if (std::sscanf(item.c_str(), " %lf - %lf : %31s", &p.start, &p.end, name) != 3)
+                    continue;
+                const std::string n = upper(name);
+                for (int i = 0; i < static_cast<int>(Control::Count); ++i)
+                    if (n == upper(kControls[i].name))
+                    {
+                        p.control = i;
+                        script.push_back(p);
+                        std::fprintf(stderr, "[pad] script: %s %.1f-%.1fs\n", kControls[i].name, p.start, p.end);
