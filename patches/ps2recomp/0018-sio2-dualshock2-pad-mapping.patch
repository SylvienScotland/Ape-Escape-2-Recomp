new file mode 100644
index 0000000..10eacf5
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/iop_pad_input.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <cstdint>
+
+// Host controller state for the emulated SIO2 DualShock 2 (Ape Escape 2 recomp patch 0018).
+// The host registers one source; the IOP's SIO2 device polls it whenever the guest reads a pad.
+namespace ps2x::iop
+{
+    struct PadInput
+    {
+        bool connected = true;
+        uint16_t buttons = 0xFFFFu; // DualShock 2 order, active low (bit 0 SELECT ... bit 15 SQUARE)
+        uint8_t rightX = 0x80u;
+        uint8_t rightY = 0x80u;
+        uint8_t leftX = 0x80u;
+        uint8_t leftY = 0x80u;
+        // Pressure, 0 = released .. 0xFF: Right, Left, Up, Down, Triangle, Circle, Cross, Square, L1, R1, L2, R2
+        uint8_t pressure[12]{};
+    };
+
+    // Returns false when no state is available for that port (reported as "no device").
+    using PadInputSource = bool (*)(int port, PadInput &out);
+
+    void setPadInputSource(PadInputSource source) noexcept;
+}
