diff --git a/ps2xIOP/src/emulator/core/iop_sio2.cpp b/ps2xIOP/src/emulator/core/iop_sio2.cpp
new file mode 100644
index 0000000..d2f8103
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_sio2.cpp
@@ -0,0 +1,347 @@
+#include "iop_sio2.h"
+
+#include "ps2x/iop/iop_pad_input.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+namespace ps2x::iop
+{
+    namespace
+    {
+        std::atomic<PadInputSource> g_padSource{nullptr};
+    }
+
+    void setPadInputSource(PadInputSource source) noexcept
+    {
+        g_padSource.store(source);
+    }
+}
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr uint32_t kRegCtrl = 0x1F808268u;
+        constexpr uint32_t kRegDataIn = 0x1F808260u;
+        constexpr uint32_t kRegDataOut = 0x1F808264u;
+        constexpr uint32_t kRegRecv1 = 0x1F80826Cu;
+        constexpr uint32_t kRegRecv2 = 0x1F808270u;
+        constexpr uint32_t kRegRecv3 = 0x1F808274u;
+        constexpr uint32_t kRegUnknown0 = 0x1F808278u;
+        constexpr uint32_t kRegUnknown1 = 0x1F80827Cu;
+        constexpr uint32_t kRegIstat = 0x1F808280u;
+
+        constexpr uint32_t kRecv1DeviceOk = 0x1100u;
+        constexpr uint32_t kRecv1NoDevice = 0x1D100u;
+
+        // IOP DMA channel 11 (SIO2in: RAM -> SIO2) and 12 (SIO2out: SIO2 -> RAM).
+        constexpr uint32_t kDma11Base = 0x1F801540u;
+        constexpr uint32_t kDma12Base = 0x1F801550u;
+        constexpr uint32_t kDmaStart = 1u << 24;
+
+        constexpr uint8_t kModeDigital = 0x41u;
+        constexpr uint8_t kModeAnalog = 0x73u;
+        constexpr uint8_t kModePressure = 0x79u;
+        constexpr uint8_t kModeConfig = 0xF3u;
+
+        bool traceEnabled()
+        {
+            static const bool enabled = []
+            {
+                const char *e = std::getenv("APE2_SIO2_TRACE");
+                return e && *e && *e != '0';
+            }();
+            return enabled;
+        }
+
+        std::string hex(const std::vector<uint8_t> &bytes)
+        {
+            std::string s;
+            char b[4];
+            for (uint8_t v : bytes)
+            {
+                std::snprintf(b, sizeof(b), "%02x", v);
+                s += b;
+            }
+            return s;
+        }
+    }
+
+    void IopSio2::reset()
+    {
+        *this = IopSio2{};
+    }
+
+    uint32_t IopSio2::read(uint32_t phys, unsigned sizeBytes)
+    {
+        (void)sizeBytes;
+        if (phys >= Base && phys < Base + 0x40u)
+            return m_send3[(phys - Base) / 4u];
+        if (phys >= Base + 0x40u && phys < kRegDataIn)
+            return m_send12[(phys - Base - 0x40u) / 4u];
+        switch (phys & ~3u)
+        {
+        case kRegDataOut:
+        {
+            if (m_fifoOut.empty())
+                return 0u;
+            const uint8_t v = m_fifoOut.front();
+            m_fifoOut.pop_front();
+            return v;
+        }
+        case kRegCtrl:
+            return m_ctrl;
+        case kRegRecv1:
+            return m_recv1;
+        case kRegRecv2:
+            return m_recv2;
+        case kRegRecv3:
+            return m_recv3;
+        case kRegUnknown0:
+            return m_unknown[0];
+        case kRegUnknown1:
+            return m_unknown[1];
+        case kRegIstat:
+            return m_istat;
+        default:
+            return 0u;
+        }
+    }
+
+    bool IopSio2::write(uint32_t phys, uint32_t value, unsigned sizeBytes, const RamAccess &ram)
+    {
+        (void)sizeBytes;
+        if (phys >= Base && phys < Base + 0x40u)
+        {
+            m_send3[(phys - Base) / 4u] = value;
+            return false;
+        }
+        if (phys >= Base + 0x40u && phys < kRegDataIn)
+        {
+            m_send12[(phys - Base - 0x40u) / 4u] = value;
+            return false;
+        }
+        switch (phys & ~3u)
+        {
+        case kRegDataIn:
+            m_fifoIn.push_back(static_cast<uint8_t>(value));
+            return false;
+        case kRegCtrl:
+            m_ctrl = value;
+            if (traceEnabled() && m_traceCount < 60u)
+            {
+                ++m_traceCount;
+                std::fprintf(stderr, "[sio2] ctrl=0x%x fifoIn=%zu chcr11=0x%x chcr12=0x%x\n", value, m_fifoIn.size(),
+                             ram.readReg(kDma11Base + 8u), ram.readReg(kDma12Base + 8u));
+            }
+            if ((value & 1u) != 0u)
+            {
+                // SIO2MAN starts with 0x3BC | 1: the queued DATAIN bytes are the command, so the reset bits
+                // must not discard them; the transfer consumes the input FIFO itself.
+                m_ctrl &= ~1u;
+                m_fifoOut.clear();
+                return runTransfers(ram);
+            }
+            if ((value & 0xCu) != 0u) // reset the FIFOs
+            {
+                m_fifoIn.clear();
+                m_fifoOut.clear();
+            }
+            return false;
+        case kRegUnknown0:
+            m_unknown[0] = value;
+            return false;
+        case kRegUnknown1:
+            m_unknown[1] = value;
+            return false;
+        case kRegIstat:
+            m_istat &= ~value;
+            return false;
+        default:
+            return false;
+        }
+    }
+
+    bool IopSio2::runTransfers(const RamAccess &ram)
+    {
+        // Command bytes: DMA channel 11 when armed, else whatever was pushed to DATAIN.
+        std::deque<uint8_t> input;
+        const uint32_t chcr11 = ram.readReg(kDma11Base + 8u);
+        const bool dmaIn = (chcr11 & kDmaStart) != 0u;
+        if (dmaIn)
+        {
+            const uint32_t madr = ram.readReg(kDma11Base) & 0x1FFFFFu;
+            const uint32_t bcr = ram.readReg(kDma11Base + 4u);
+            const uint32_t words = (bcr & 0xFFFFu) * std::max<uint32_t>(bcr >> 16, 1u);
+            std::vector<uint8_t> buf(static_cast<size_t>(words) * 4u);
+            if (!buf.empty() && ram.read(madr, buf.data(), buf.size()))
+                input.insert(input.end(), buf.begin(), buf.end());
+            ram.writeReg(kDma11Base + 8u, chcr11 & ~kDmaStart);
+        }
+        else
+        {
+            input.swap(m_fifoIn);
+        }
+
+        std::vector<uint8_t> output;
+        for (uint32_t i = 0; i < m_send3.size(); ++i)
+        {
+            const uint32_t send3 = m_send3[i];
+            if (send3 == 0u)
+                break;
+            const uint32_t port = send3 & 3u;
+            const uint32_t inSize = (send3 >> 8) & 0x1FFu;
+            const uint32_t outSize = (send3 >> 18) & 0x1FFu;
+            std::vector<uint8_t> in;
+            for (uint32_t b = 0; b < inSize && !input.empty(); ++b)
+            {
+                in.push_back(input.front());
+                input.pop_front();
+            }
+            std::vector<uint8_t> out(outSize, 0xFFu);
+            const bool present = exchange(port, in, out);
+            m_recv1 = present ? kRecv1DeviceOk : kRecv1NoDevice;
+            output.insert(output.end(), out.begin(), out.end());
+
+            if (traceEnabled() && m_traceCount < 400u)
+            {
+                ++m_traceCount;
+                std::fprintf(stderr, "[sio2] send3=0x%08x port=%u in=%s out=%s%s%s\n", send3, port, hex(in).c_str(),
+                             hex(out).c_str(), present ? "" : " (no device)", dmaIn ? " dma" : "");
+            }
+        }
+        m_recv2 = 0xFu;
+        m_recv3 = 0u;
+        m_istat |= 1u;
+
+        // Replies: DMA channel 12 when armed, else DATAOUT.
+        const uint32_t chcr12 = ram.readReg(kDma12Base + 8u);
+        if ((chcr12 & kDmaStart) != 0u)
+        {
+            const uint32_t madr = ram.readReg(kDma12Base) & 0x1FFFFFu;
+            const uint32_t bcr = ram.readReg(kDma12Base + 4u);
+            const uint32_t bytes = (bcr & 0xFFFFu) * std::max<uint32_t>(bcr >> 16, 1u) * 4u;
+            output.resize(std::max<size_t>(output.size(), bytes), 0u);
+            if (bytes != 0u)
+                (void)ram.write(madr, output.data(), bytes);
+            ram.writeReg(kDma12Base + 8u, chcr12 & ~kDmaStart);
+        }
+        else
+        {
+            m_fifoOut.insert(m_fifoOut.end(), output.begin(), output.end());
+        }
+        return true;
+    }
+
+    bool IopSio2::exchange(uint32_t port, const std::vector<uint8_t> &in, std::vector<uint8_t> &out)
+    {
+        // Only controllers on ports 0/1 (device address 0x01); memory cards / multitap answer "no device".
+        if (port > 1u || in.size() < 2u || in[0] != 0x01u)
+            return false;
+        PadInput pad{};
+        const PadInputSource source = g_padSource.load();
+        if (!source || !source(static_cast<int>(port), pad) || !pad.connected)
+            return false;
+
+        DualShock2 &ds = m_pads[port];
+        const uint8_t cmd = in[1];
+        const auto arg = [&](size_t i) -> uint8_t { return i < in.size() ? in[i] : 0u; };
+        std::vector<uint8_t> data;
+        auto buttonData = [&]()
+        {
+            data.push_back(static_cast<uint8_t>(pad.buttons & 0xFFu));
+            data.push_back(static_cast<uint8_t>(pad.buttons >> 8));
+            if (ds.analog || ds.pressure)
+            {
+                data.push_back(pad.rightX);
+                data.push_back(pad.rightY);
+                data.push_back(pad.leftX);
+                data.push_back(pad.leftY);
+            }
+            if (ds.pressure)
+                data.insert(data.end(), pad.pressure, pad.pressure + 12);
+        };
+
+        if (traceEnabled() && cmd == 0x42u && pad.buttons != m_lastTracedButtons[port])
+        {
+            m_lastTracedButtons[port] = pad.buttons;
+            std::fprintf(stderr, "[sio2] pad%u buttons=0x%04x sticks L=%02x,%02x R=%02x,%02x\n", port, pad.buttons,
+                         pad.leftX, pad.leftY, pad.rightX, pad.rightY);
+        }
+
+        const uint8_t mode = ds.config ? kModeConfig : ds.pressure ? kModePressure : ds.analog ? kModeAnalog : kModeDigital;
+        switch (cmd)
+        {
+        case 0x42: // read data
+            if (ds.config)
+                data.assign(6, 0u);
+            else
+                buttonData();
+            break;
+        case 0x43: // enter / exit config mode
+            if (ds.config)
+                data.assign(6, 0u);
+            else
+                buttonData();
+            ds.config = arg(3) == 1u;
+            break;
+        case 0x44: // set mode (digital / analog) and lock
+            if (ds.config)
+            {
+                ds.analog = arg(3) == 1u;
+                if (!ds.analog)
+                    ds.pressure = false;
+            }
+            data.assign(6, 0u);
+            break;
+        case 0x45: // query model: DualShock 2
+            data = {0x03u, 0x02u, static_cast<uint8_t>(ds.analog ? 1u : 0u), 0x02u, 0x01u, 0x00u};
+            break;
+        case 0x46: // query actuator
+            data = arg(3) == 0u ? std::vector<uint8_t>{0x00, 0x00, 0x01, 0x02, 0x00, 0x0A}
+                                : std::vector<uint8_t>{0x00, 0x00, 0x01, 0x01, 0x01, 0x14};
+            break;
+        case 0x47: // query combination
+            data = {0x00, 0x00, 0x02, 0x00, 0x01, 0x00};
+            break;
+        case 0x4C: // query mode
+            data = arg(3) == 0u ? std::vector<uint8_t>{0x00, 0x00, 0x00, 0x04, 0x00, 0x00}
+                                : std::vector<uint8_t>{0x00, 0x00, 0x00, 0x07, 0x00, 0x00};
+            break;
+        case 0x4D: // vibration map
+            data.assign(ds.vibrationMap.begin(), ds.vibrationMap.end());
+            for (size_t i = 0; i < ds.vibrationMap.size(); ++i)
+                ds.vibrationMap[i] = arg(3 + i);
+            break;
+        case 0x4F: // button response mask: enables pressure data
+            ds.pressure = true;
+            ds.analog = true;
+            data = {0x00, 0x00, 0x00, 0x00, 0x00, 0x5A};
+            break;
+        case 0x40: // set VREF parameter
+            data = {0x00, 0x00, 0x02, 0x00, 0x00, 0x5A};
+            break;
+        case 0x41: // query button mask
+            data = ds.analog ? std::vector<uint8_t>{0xFF, 0xFF, 0x03, 0x00, 0x00, 0x5A} : std::vector<uint8_t>(6, 0u);
+            break;
+        default:
+            data.assign(6, 0u);
+            break;
+        }
+
+        std::fill(out.begin(), out.end(), 0x00u);
+        if (!out.empty())
+            out[0] = 0xFFu;
+        if (out.size() > 1u)
+            out[1] = mode;
+        if (out.size() > 2u)
+            out[2] = 0x5Au;
+        for (size_t i = 0; i < data.size() && 3u + i < out.size(); ++i)
+            out[3u + i] = data[i];
+        return true;
+    }
+}
diff --git a/ps2xIOP/src/emulator/core/iop_sio2.h b/ps2xIOP/src/emulator/core/iop_sio2.h
new file mode 100644
index 0000000..ea80167
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_sio2.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <vector>
+
+// SIO2 (controller / memory card serial port) with a DualShock 2 on port 0 (Ape Escape 2 recomp patch 0018).
+// Games that load the real SIO2MAN/PADMAN/DBCMAN modules talk to these registers directly:
+//   0x1F808200-23F SEND3[16] (one word per queued transfer: port, in/out byte counts)
+//   0x1F808240-25F SEND1/SEND2 per port, 0x1F808260 DATAIN (FIFO in), 0x1F808264 DATAOUT (FIFO out)
+//   0x1F808268 CTRL (bit 0 starts the queued transfers), 0x1F80826C/70/74 RECV1/2/3, 0x1F808280 ISTAT
+// Command bytes come from DATAIN or IOP DMA channel 11, replies go to DATAOUT or DMA channel 12; completion
+// raises IOP IRQ 17. APE2_SIO2_TRACE=1 logs the traffic.
+namespace ps2x::iop::detail
+{
+    class IopSio2
+    {
+    public:
+        static constexpr uint32_t Base = 0x1F808200u;
+        static constexpr uint32_t End = 0x1F808284u;
+        static constexpr int Irq = 17;
+
+        struct RamAccess
+        {
+            std::function<bool(uint32_t address, void *dst, size_t size)> read;
+            std::function<bool(uint32_t address, const void *src, size_t size)> write;
+            std::function<uint32_t(uint32_t address)> readReg;
+            std::function<void(uint32_t address, uint32_t value)> writeReg;
+        };
+
+        void reset();
