+    void readHostPad(ps2x::iop::PadInput &out)
+    {
+        const Mapping &m = mapping();
+        const int gamepad = activeGamepad();
+        out = {};
+        float value[static_cast<size_t>(Control::Count)]{};
+        for (int c = 0; c < static_cast<int>(Control::Count); ++c)
+            for (const Binding &b : m.bindings[c])
+                value[c] = std::max(value[c], bindingValue(b, gamepad));
+        if (!padScript().empty())
+        {
+            const double now = padClockSeconds();
+            for (const ScriptedPress &p : padScript())
+                if (now >= p.start && now < p.end)
+                    value[p.control] = 1.0f;
+        }
+
+        uint16_t buttons = 0xFFFFu;
+        for (int c = 0; c < static_cast<int>(Control::Count); ++c)
+        {
+            const ControlInfo &info = kControls[c];
+            if (info.bit != 0u && value[c] > 0.0f)
+                buttons &= static_cast<uint16_t>(~info.bit);
+            if (info.pressureIndex >= 0)
+                out.pressure[info.pressureIndex] = static_cast<uint8_t>(std::lround(value[c] * 255.0f));
+        }
+        out.buttons = buttons;
+
+        auto stick = [&](StickSource source, Control up, Control down, Control left, Control right, uint8_t &x, uint8_t &y)
+        {
+            float sx = 0.0f, sy = 0.0f;
+            if (gamepad >= 0 && source != StickSource::None)
+            {
+                const bool l = source == StickSource::LeftStick;
+                sx = GetGamepadAxisMovement(gamepad, l ? GAMEPAD_AXIS_LEFT_X : GAMEPAD_AXIS_RIGHT_X);
+                sy = GetGamepadAxisMovement(gamepad, l ? GAMEPAD_AXIS_LEFT_Y : GAMEPAD_AXIS_RIGHT_Y);
+            }
+            sx += value[static_cast<int>(right)] - value[static_cast<int>(left)];
+            sy += value[static_cast<int>(down)] - value[static_cast<int>(up)];
+            x = stickByte(sx);
+            y = stickByte(sy);
+        };
+        stick(m.leftStick, Control::LeftUp, Control::LeftDown, Control::LeftLeft, Control::LeftRight, out.leftX, out.leftY);
+        stick(m.rightStick, Control::RightUp, Control::RightDown, Control::RightLeft, Control::RightRight, out.rightX,
+              out.rightY);
+    }
+
+    bool sio2PadSource(int port, ps2x::iop::PadInput &out)
+    {
+        if (port != 0)
+            return false; // one controller, on port 1
+        readHostPad(out);
+        return true;
+    }
