+    // ------------------------------------------------------------------ reverb (PAL spu2.c)
+    // The PS1/PS2 effect unit. It runs at half the output rate, one channel per output sample (left on even
+    // samples, right on odd ones), through a 39-tap half-band filter each way, with all of its delay lines in the
+    // core's work area of sound memory (ESA..EEA), which moves on by one halfword every two samples.
+    int32_t IopSpu2::reverbStep(Core &c, int R, int32_t in)
+    {
+        if (c.eea <= c.esa)
+            return 0;
+        const uint32_t span = c.eea - c.esa + 1u;
+        int16_t *m = reinterpret_cast<int16_t *>(m_ram.data());
+        const auto RA = [&](int64_t off) {
+            int64_t x = (static_cast<int64_t>(c.rvPos) + off) % static_cast<int64_t>(span);
+            if (x < 0)
+                x += span;
+            return (c.esa + static_cast<uint32_t>(x)) & (kRamSize / 2u - 1u);
+        };
+        const auto REG = [&](int n) { return static_cast<int32_t>(c.fxAddr[n]); };
+        const auto MUL = [](int32_t a, int32_t b) { return (a * b) >> 15; };
+        const int16_t *v = c.fxVol;
+        const int32_t same_dst = REG(R ? F_mRSAME : F_mLSAME), same_src = REG(R ? F_dRSAME : F_dLSAME);
+        const int32_t diff_dst = REG(R ? F_mRDIFF : F_mLDIFF), diff_src = REG(R ? F_dLDIFF : F_dRDIFF);
+        const int32_t apf1_dst = REG(R ? F_mRAPF1 : F_mLAPF1), apf2_dst = REG(R ? F_mRAPF2 : F_mLAPF2);
+        const int32_t apf1_src = apf1_dst - REG(F_dAPF1), apf2_src = apf2_dst - REG(F_dAPF2);
+        const int32_t x = MUL(v[R ? V_vRIN : V_vLIN], in);
+        const int32_t sp = m[RA(same_dst - 1)], dp = m[RA(diff_dst - 1)];
+        const int32_t same = MUL(v[V_vIIR], x + MUL(v[V_vWALL], m[RA(same_src)]) - sp) + sp;
+        const int32_t diff = MUL(v[V_vIIR], x + MUL(v[V_vWALL], m[RA(diff_src)]) - dp) + dp;
+        int32_t out = MUL(v[V_vCOMB1], m[RA(REG(R ? F_mRCOMB1 : F_mLCOMB1))]) +
+                      MUL(v[V_vCOMB2], m[RA(REG(R ? F_mRCOMB2 : F_mLCOMB2))]) +
+                      MUL(v[V_vCOMB3], m[RA(REG(R ? F_mRCOMB3 : F_mLCOMB3))]) +
+                      MUL(v[V_vCOMB4], m[RA(REG(R ? F_mRCOMB4 : F_mLCOMB4))]);
+        const int32_t a1s = m[RA(apf1_src)], a1 = out - MUL(v[V_vAPF1], a1s);
+        out = a1s + MUL(v[V_vAPF1], a1);
+        const int32_t a2s = m[RA(apf2_src)], a2 = out - MUL(v[V_vAPF2], a2s);
+        out = a2s + MUL(v[V_vAPF2], a2);
+        m[RA(same_dst)] = static_cast<int16_t>(clamp16(same));
+        m[RA(diff_dst)] = static_cast<int16_t>(clamp16(diff));
+        m[RA(apf1_dst)] = static_cast<int16_t>(clamp16(a1));
+        m[RA(apf2_dst)] = static_cast<int16_t>(clamp16(a2));
+        return clamp16(out);
+    }
+
+    // the core's effect output for this 48 kHz sample, from its wet input
+    void IopSpu2::reverb(Core &c, int32_t wl, int32_t wr, int32_t &ol, int32_t &orr)
+    {
+        const uint32_t p = ++c.rvHp & 63;
+        c.rvIn[0][p] = clamp16(wl);
+        c.rvIn[1][p] = clamp16(wr);
+        const int R = c.rvPhase & 1;
+        const int32_t y = reverbStep(c, R, rvFirAt(c.rvIn[R], p));
+        c.rvOut[R][p] = y;
+        c.rvOut[!R][p] = 0;
+        if (!(++c.rvPhase & 1) && ++c.rvPos > c.eea - c.esa)
+            c.rvPos = 0; // one halfword on every two samples
+        ol = clamp16(rvFirAt(c.rvOut[0], p) * 2);
+        orr = clamp16(rvFirAt(c.rvOut[1], p) * 2);
+    }
