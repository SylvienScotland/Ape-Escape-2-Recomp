diff --git a/ps2xIOP/src/emulator/core/iop_memory.cpp b/ps2xIOP/src/emulator/core/iop_memory.cpp
index 720bb24..4fb3fd7 100644
--- a/ps2xIOP/src/emulator/core/iop_memory.cpp
+++ b/ps2xIOP/src/emulator/core/iop_memory.cpp
@@ -1105,6 +1105,26 @@ namespace
             std::fprintf(stderr, "[spu2:admas] idle word=0x%03x now=0x%04x%c", m_admasWord & 0x3FFu, value, 10);
     }
 
+    namespace
+    {
+        // 0064: the auto-DMA block period follows the playback queue, as the SPU2 paces it on the hardware (it
+        // consumes at exactly 48 kHz and interrupts when a block is used up). A fixed period could not suit both
+        // streams: the 0206 calibration (1240 cycles/word) is right for the title music and starved the FMVs' 48 kHz
+        // stereo sound (133 blocks/s for 187.5, the movies played 1.5x long since the player follows its audio),
+        // and 880 was right for the movies and overfed the music (dropped blocks). The period is the calibrated
+        // one times 0.3 + 0.15 x depth (depth ~4.7 = 1x; 0.4x at most for an empty queue, 1.6x at most). APE2_SPU2_ADMA_ADAPT=0
+        // keeps it fixed.
+        uint64_t admaPaced(uint64_t base)
+        {
+            static const bool adapt = [] { const char *e = std::getenv("APE2_SPU2_ADMA_ADAPT"); return !(e && e[0] == '0'); }();
+            if (!adapt || base == 0u)
+                return base;
+            const double depth = static_cast<double>(spu2Queue().count);
+            const double f = std::min(1.6, std::max(0.4, 0.3 + depth * 0.15));
+            return std::max<uint64_t>(1u, static_cast<uint64_t>(static_cast<double>(base) * f));
+        }
+    }
+
