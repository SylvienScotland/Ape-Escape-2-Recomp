 // With APE2_FRAME_DUMP_VRAM=1 the whole 4 MiB of GS local memory is also written as <dir>/vram_NNNN.bin.
+// F9 in the game window (with APE2_FRAME_DUMP set): the next 60 presented frames are written as burst_NNNN.ppm
+std::atomic<int> g_ape2FrameDumpBurst{0};
+
 static void dumpPresentationFrame(const PresentationFrame &frame, const GSPresentationRequest &request,
                                   const GSRasterBackend &backend)
 {
     static const char *dir = std::getenv("APE2_FRAME_DUMP");
     if (!dir || !*dir || frame.width == 0u || frame.height == 0u)
         return;
+    static uint32_t burstDumped = 0u;
+    if (g_ape2FrameDumpBurst.load(std::memory_order_relaxed) > 0 && burstDumped < 1200u)
+    {
+        g_ape2FrameDumpBurst.fetch_sub(1, std::memory_order_relaxed);
+        char path[512];
+        std::snprintf(path, sizeof(path), "%s/burst_%04u.ppm", dir, burstDumped++);
+        if (FILE *f = std::fopen(path, "wb"))
+        {
+            std::fprintf(f, "P6\n%u %u\n255\n", frame.width, frame.height);
+            std::vector<uint8_t> row(static_cast<size_t>(frame.width) * 3u);
+            for (uint32_t y = 0; y < frame.height; ++y)
+            {
+                const size_t src = static_cast<size_t>(y) * kHostFrameWidth * 4u;
+                if (src + static_cast<size_t>(frame.width) * 4u > frame.pixels.size())
+                    break;
+                for (uint32_t x = 0; x < frame.width; ++x)
+                    for (uint32_t c = 0; c < 3u; ++c)
+                        row[x * 3u + c] = frame.pixels[src + x * 4u + c];
+                std::fwrite(row.data(), 1, row.size(), f);
+            }
+            std::fclose(f);
+        }
+        return;
+    }
     static const uint32_t every = []
     {
         const char *e = std::getenv("APE2_FRAME_DUMP_EVERY");
