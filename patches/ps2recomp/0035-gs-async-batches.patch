+// Decodes every tile of the queued textures that cover VRAM pages [p0, p1], so a write to those pages can go
+// ahead without drawing the queue first. False when it cannot (a queued primitive draws into the pages).
+bool GSCpuBackend::SettleQueuedTextures(uint32_t p0, uint32_t p1)
+{
+    for (uint32_t pg = p0;; pg = (pg + 1u) & 511u)
+    {
+        if (m_queuePages[pg] || m_inflightPages[pg] || m_inflightTexPages[pg])
+            return false;
+        if (pg == ((p1 + 1u) & 511u))
+            break;
+    }
+    for (const QueuedTextureUse &use : m_queuedTextures)
+    {
+        DecodedTexture &t = const_cast<DecodedTexture &>(*use.texture);
+        bool overlaps = false;
+        for (uint32_t r = 0; r < t.pageRows && !overlaps; ++r)
+            for (uint32_t c = 0; c < t.pageCols && !overlaps; ++c)
+            {
+                const uint32_t pg = (t.firstPage + r * t.pagesPerRow + c) & 511u;
+                overlaps = ((pg - p0) & 511u) <= ((p1 + 1u - p0) & 511u);
+            }
+        if (!overlaps)
+            continue;
+        const size_t tiles = t.tileCount;
+        for (size_t i = 0; i < tiles; ++i)
+        {
+            if (t.tileReady[i].load(std::memory_order_relaxed))
+                continue;
+            const int u0 = static_cast<int>(i % static_cast<size_t>(t.tilesW)) * 8, v0 = static_cast<int>(i / static_cast<size_t>(t.tilesW)) * 8;
+            const int u1 = std::min(u0 + 8, t.w), v1 = std::min(v0 + 8, t.h);
+            for (int vv = v0; vv < v1; ++vv)
+                for (int uu = u0; uu < u1; ++uu)
+                    t.texels[static_cast<size_t>(vv) * static_cast<size_t>(t.w) + static_cast<size_t>(uu)] =
+                        DecodeTexel(use.state, uu, vv, t.clut.data());
+            t.tileReady[i].store(1u, std::memory_order_relaxed);
+        }
+    }
+    return true;
+}
