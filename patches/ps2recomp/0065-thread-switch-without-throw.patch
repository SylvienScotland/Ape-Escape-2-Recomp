+// 0065: a thread switch normally throws EeDispatcherTransfer to drop the guest code's native frames, and on
+// Windows each throw costs microseconds. The FMV threads yield to each other ~70,000 times a second
+// (RotateThreadReadyQueue from 0x1a54f0, ~17% of the EE thread in throw/unwind). When the syscall handler is the
+// only host frame and the guest continues with just `jr $ra; nop` (every libkernel syscall stub), the switch can
+// unwind by returns instead: the stub returns to its caller's dispatchGuestBranch, which sees the deferred
+// transfer and returns false, and so on up to the scheduler loop. Executing the `jr $ra` early only moves the
+// thread's resume pc from the stub to its caller. APE2_XFER_DEFER=0 always throws.
+bool EeScheduler::canDeferTransfer() const
+{
+    static const bool enabled = [] { const char *e = std::getenv("APE2_XFER_DEFER"); return !(e && e[0] == '0'); }();
+    const uint32_t pc = m_runtime.m_ape2SyscallRetPc;
+    if (!enabled || pc == 0u || m_runtime.m_ape2HostDepth != 1u || m_rdram == nullptr)
+    {
+        return false;
+    }
+    const uint32_t offset = pc & 0x01FFFFFCu;
+    if (offset + 8u > PS2_RAM_SIZE)
+    {
+        return false;
+    }
+    uint32_t words[2] = {};
+    std::memcpy(words, m_rdram + offset, sizeof(words));
+    return words[0] == 0x03E00008u && words[1] == 0u;
+}
