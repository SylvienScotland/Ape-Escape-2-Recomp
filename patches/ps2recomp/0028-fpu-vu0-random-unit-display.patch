+namespace
+{
+    // APE2_DRAW_LOG=<first vsync>,<count>: per vsync, one line per distinct draw state with its primitive
+    // count, the first vertex's colour/fog and the union of the vertices' screen rectangles (Ape Escape 2
+    // recomp debugging aid).
+    struct Ape2DrawLogEntry
+    {
+        uint32_t count = 0;
+        int x0 = 1 << 30, y0 = 1 << 30, x1 = -(1 << 30), y1 = -(1 << 30);
+        uint32_t order = 0;
+    };
+    void ape2DrawLog(uint64_t vsync, const GSPrimitiveBatch &batch)
+    {
+        static const std::pair<uint64_t, uint64_t> range = []
+        {
+            const char *e = std::getenv("APE2_DRAW_LOG");
+            if (!e)
+                return std::pair<uint64_t, uint64_t>{~0ull, 0ull};
+            char *end = nullptr;
+            const uint64_t from = std::strtoull(e, &end, 0);
+            const uint64_t count = (end && *end == ',') ? std::strtoull(end + 1, nullptr, 0) : 1ull;
+            return std::pair<uint64_t, uint64_t>{from, count};
+        }();
+        static uint64_t current = ~0ull;
+        static std::map<std::string, Ape2DrawLogEntry> entries;
+        static uint32_t order = 0;
+        auto flush = [&]()
+        {
+            if (current == ~0ull)
+                return;
+            std::vector<std::pair<uint32_t, std::string>> lines;
+            for (const auto &[key, e] : entries)
+            {
+                char t[96];
+                std::snprintf(t, sizeof(t), " n=%u rect=(%d,%d)-(%d,%d)", e.count, e.x0, e.y0, e.x1, e.y1);
+                lines.emplace_back(e.order, key + t);
+            }
+            std::sort(lines.begin(), lines.end());
+            std::fprintf(stderr, "[draw] ---- vsync %llu: %zu states\n", static_cast<unsigned long long>(current), lines.size());
+            for (const auto &l : lines)
+                std::fprintf(stderr, "[draw] %s\n", l.second.c_str());
+            entries.clear();
+            order = 0;
+        };
+        const bool inRange = vsync >= range.first && vsync < range.first + range.second;
+        if (vsync != current)
+        {
+            flush();
+            current = inRange ? vsync : ~0ull;
+        }
+        if (!inRange)
+            return;
+        const GSDrawState &st = batch.state;
+        const GSContext &c = st.context;
+        const GSVertex &v = batch.vertices[0];
+        char key[512];
+        std::snprintf(key, sizeof(key),
+                      "fbp=%x fbmsk=%08x prim=%u tme=%u abe=%u fge=%u ctx=%u tex=%x/%x/w%u tfx=%u tcc=%u alpha=%llx test=%llx zbp=%x zmsk=%u fba=%llu pabe=%u fog=%02x%02x%02x col0=%02x%02x%02x%02x f0=%02x",
+                      c.frame.fbp, c.frame.fbmsk, static_cast<unsigned>(st.prim.type), st.prim.tme, st.prim.abe, st.prim.fge,
+                      st.prim.ctxt, c.tex0.tbp0, c.tex0.psm, c.tex0.tbw, c.tex0.tfx, c.tex0.tcc,
+                      static_cast<unsigned long long>(c.alpha), static_cast<unsigned long long>(c.test), c.zbuf.zbp, c.zbuf.zmask,
+                      static_cast<unsigned long long>(c.fba & 1ull), st.pabe, st.fogR, st.fogG, st.fogB, v.r, v.g, v.b, v.a, v.fog);
+        Ape2DrawLogEntry &e = entries[key];
+        if (e.count++ == 0u)
+            e.order = order++;
+        for (uint32_t i = 0; i < batch.vertexCount; ++i)
+        {
+            const int x = static_cast<int>(batch.vertices[i].x) - (c.xyoffset.ofx >> 4);
+            const int y = static_cast<int>(batch.vertices[i].y) - (c.xyoffset.ofy >> 4);
+            e.x0 = std::min(e.x0, x);
+            e.y0 = std::min(e.y0, y);
+            e.x1 = std::max(e.x1, x);
+            e.y1 = std::max(e.y1, y);
+        }
+    }
+}
