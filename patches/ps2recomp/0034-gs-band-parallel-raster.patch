+void GSCpuBackend::FlushQueueUnlocked()
+{
+    if (m_queue.empty())
+        return;
+    RasterPool &pool = RasterPool::instance();
+    const int n = pool.threads();
+    const std::function<void(int)> task = [&](int k)
+    {
+        t_band.k = k;
+        t_band.n = n;
+        for (const QueuedPrimitive &q : m_queue)
+            DrawPrimitiveRaster(q.batch, q.texture);
+        t_band = BandState{};
+        t_curTexture = nullptr;
+    };
+    pool.run(n, task);
+    m_queue.clear();
+    m_queuePages.fill(false);
 }
 
