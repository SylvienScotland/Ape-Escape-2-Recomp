diff --git a/ps2xIOP/src/emulator/core/iop_spu2.cpp b/ps2xIOP/src/emulator/core/iop_spu2.cpp
new file mode 100644
index 0000000..f52ed43
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.cpp
@@ -0,0 +1,471 @@
+#include "iop_spu2.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+// 0223: register-accurate SPU2. The previous model guessed the register layout from write histograms and had it
+// wrong almost everywhere: it took VMIXL (0x188, which libsd's init sets to 0xffffff) for key-on, kept the voice
+// addresses inside the voice parameter block and decoded ADPCM data from byte 1 instead of byte 2. So LIBSD's
+// real key-ons (0x1A0) and sample addresses (0x1C0) never reached a voice, and the sound banks - the hub and stage
+// music, voices and effects - stayed silent. The voice engine below is the PAL port's (port/src/spu2.c,
+// JackyPendrag0n/ae2-recomp), reached through the hardware registers instead of libsd's API.
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // Per-core register offsets (core 1 is the same layout 0x400 higher).
+        constexpr uint32_t kVoiceParamEnd = 0x180u; // 24 voices x 0x10: VOLL VOLR PITCH ADSR1 ADSR2 ENVX VOLXL VOLXR
+        constexpr uint32_t kPmon = 0x180u, kNon = 0x184u, kVmixl = 0x188u, kVmixel = 0x18Cu, kVmixr = 0x190u,
+                           kVmixer = 0x194u, kMmix = 0x198u, kAttr = 0x19Au, kIrqa = 0x19Cu, kKon = 0x1A0u,
+                           kKoff = 0x1A4u, kTsa = 0x1A8u, kData = 0x1ACu, kEndx = 0x340u;
+        constexpr uint32_t kVoiceAddrBase = 0x1C0u; // 24 voices x 0xC: SSA hi/lo, LSAX hi/lo, NAX hi/lo
+        constexpr uint32_t kVoiceAddrEnd = kVoiceAddrBase + 24u * 0xCu;
+        // Volume block, 0x28 per core from 0x760: MVOL L/R, EVOL L/R, AVOL L/R, BVOL L/R, MVOLX L/R.
+        constexpr uint32_t kVolBase = 0x760u, kVolStride = 0x28u;
+
+        constexpr int kF0[5] = {0, 60, 115, 98, 122};
+        constexpr int kF1[5] = {0, 0, -52, -55, -60};
+
+        // voice and master volumes: bit 15 clear = fixed 15-bit volume (0x3fff = full)
+        inline int32_t fixedVol(uint16_t reg) { return (reg & 0x8000u) ? 0x7fff : static_cast<int16_t>(reg << 1); }
+        int32_t volStep(uint16_t reg, int32_t cur)
+        {
+            if (!(reg & 0x8000u))
+                return fixedVol(reg);
+            const int dec = (reg >> 13) & 1, rate = reg & 0x7f;
+            const int32_t target = dec ? 0 : 0x7fff;
+            const int32_t st = 1 + ((0x7f - rate) >> 2);
+            if (cur < target)
+                cur = std::min(cur + st, target);
+            else if (cur > target)
+                cur = std::max(cur - st, target);
+            return cur;
+        }
+
+        // Window offset of a register address, or -1 for addresses this model does not decode.
+        int windowOffset(uint32_t address)
+        {
+            if (address >= IopSpu2::kBase && address < IopSpu2::kEnd)
+                return static_cast<int>(address - IopSpu2::kBase);
+            return -1; // the PS1 compatibility window is not used by the game's driver (0088)
+        }
+
+        bool konLog()
+        {
+            static const bool on = std::getenv("APE2_SPU2_KONLOG") != nullptr;
+            return on;
+        }
+    }
+
+    IopSpu2::IopSpu2()
+    {
+        m_ram.assign(kRamSize, 0u);
+        reset();
+    }
+
+    void IopSpu2::reset()
+    {
+        std::fill(m_ram.begin(), m_ram.end(), uint8_t{0});
+        for (Core &c : m_cores)
+            c = Core{};
+        std::fill(std::begin(m_raw), std::end(m_raw), uint16_t{0});
+        m_mvolWritten = false;
+        m_keyonCount = 0u;
+        m_blocksDecoded = 0u;
+    }
+
+    uint32_t IopSpu2::pairAddress(uint32_t hiOffset) const
+    {
+        const uint32_t hi = m_raw[hiOffset >> 1] & 0xFu, lo = m_raw[(hiOffset + 2u) >> 1];
+        return ((hi << 16) | lo) << 1; // halfword address -> byte address
+    }
+
+    void IopSpu2::write16(uint32_t address, uint16_t value)
+    {
+        const int off = windowOffset(address & ~1u);
+        if (off < 0)
+            return;
+        m_raw[off >> 1] = value;
+        if (off >= 0x760 && off < static_cast<int>(kVolBase + 2u * kVolStride))
+        {
+            Core &c = m_cores[(off - kVolBase) / kVolStride];
+            switch (((off - kVolBase) % kVolStride) >> 1)
+            {
+            case 0: c.mvoll = value; m_mvolWritten = true; break;
+            case 1: c.mvolr = value; m_mvolWritten = true; break;
+            case 2: c.evoll = value; break;
+            case 3: c.evolr = value; break;
+            case 4: c.avoll = value; break;
+            case 5: c.avolr = value; break;
+            case 6: c.bvoll = value; break;
+            case 7: c.bvolr = value; break;
+            default: break;
+            }
+            return;
+        }
+        if (off >= 0x760)
+            return;
+        const int ci = off >= 0x400 ? 1 : 0;
+        const uint32_t base = ci ? 0x400u : 0u;
+        const uint32_t r = static_cast<uint32_t>(off) - base;
+        Core &c = m_cores[ci];
+        if (r < kVoiceParamEnd)
+        {
+            Voice &v = c.v[r >> 4];
+            switch (r & 0xFu)
+            {
+            case 0x0: v.voll = value; if (!(value & 0x8000u)) v.volxl = fixedVol(value); break;
+            case 0x2: v.volr = value; if (!(value & 0x8000u)) v.volxr = fixedVol(value); break;
+            case 0x4: v.pitch = value; break;
+            case 0x6: v.adsr1 = value; break;
+            case 0x8: v.adsr2 = value; break;
+            case 0xA: v.env = value & 0x7fff; break;
+            default: break;
+            }
+            return;
+        }
+        if (r >= kVoiceAddrBase && r < kVoiceAddrEnd)
+        {
+            const uint32_t vi = (r - kVoiceAddrBase) / 0xCu, field = (r - kVoiceAddrBase) % 0xCu;
+            Voice &v = c.v[vi];
+            const uint32_t hiOff = base + kVoiceAddrBase + vi * 0xCu + (field & ~3u);
+            const uint32_t addr = pairAddress(hiOff) & (kRamSize - 1u);
+            if (field < 4u)
+                v.ssa = addr & ~15u;
+            else if (field < 8u)
+            {
+                v.lsa = addr & ~15u;
+                v.lsaSet = true;
+            }
+            else
+                v.nax = addr;
+            return;
+        }
+        switch (r)
+        {
+        case kPmon: c.pmon = (c.pmon & 0xFF0000u) | value; break;
+        case kPmon + 2: c.pmon = (c.pmon & 0xFFFFu) | ((value & 0xFFu) << 16); break;
+        case kNon: c.non = (c.non & 0xFF0000u) | value; break;
+        case kNon + 2: c.non = (c.non & 0xFFFFu) | ((value & 0xFFu) << 16); break;
+        case kVmixl: c.vmixl = (c.vmixl & 0xFF0000u) | value; break;
+        case kVmixl + 2: c.vmixl = (c.vmixl & 0xFFFFu) | ((value & 0xFFu) << 16); break;
+        case kVmixel: c.vmixel = (c.vmixel & 0xFF0000u) | value; break;
+        case kVmixel + 2: c.vmixel = (c.vmixel & 0xFFFFu) | ((value & 0xFFu) << 16); break;
+        case kVmixr: c.vmixr = (c.vmixr & 0xFF0000u) | value; break;
+        case kVmixr + 2: c.vmixr = (c.vmixr & 0xFFFFu) | ((value & 0xFFu) << 16); break;
+        case kVmixer: c.vmixer = (c.vmixer & 0xFF0000u) | value; break;
+        case kVmixer + 2: c.vmixer = (c.vmixer & 0xFFFFu) | ((value & 0xFFu) << 16); break;
+        case kMmix: c.mmix = value; break;
+        case kAttr: c.attr = value; break;
+        case kKon: keyOn(ci, value); break;
+        case kKon + 2: keyOn(ci, static_cast<uint32_t>(value & 0xFFu) << 16); break;
+        case kKoff: keyOff(ci, value); break;
+        case kKoff + 2: keyOff(ci, static_cast<uint32_t>(value & 0xFFu) << 16); break;
+        case kTsa:
+        case kTsa + 2: c.tsa = pairAddress(base + kTsa) & (kRamSize - 1u); break;
+        case kData: // PIO transfer: one halfword at TSA
+            m_ram[c.tsa & (kRamSize - 1u)] = static_cast<uint8_t>(value);
+            m_ram[(c.tsa + 1u) & (kRamSize - 1u)] = static_cast<uint8_t>(value >> 8);
+            c.tsa = (c.tsa + 2u) & (kRamSize - 1u);
+            break;
+        case kEndx: c.endx &= 0xFF0000u; break; // a write clears the flags
+        case kEndx + 2: c.endx &= 0xFFFFu; break;
+        default: break;
+        }
+    }
+
+    uint16_t IopSpu2::read16(uint32_t address) const
+    {
+        const int off = windowOffset(address & ~1u);
+        if (off < 0)
+            return 0u;
+        if (off < 0x760)
+        {
+            const int ci = off >= 0x400 ? 1 : 0;
+            const uint32_t base = ci ? 0x400u : 0u;
+            const uint32_t r = static_cast<uint32_t>(off) - base;
+            const Core &c = m_cores[ci];
+            if (r < kVoiceParamEnd)
+            {
+                const Voice &v = c.v[r >> 4];
+                switch (r & 0xFu)
+                {
+                case 0xA: return static_cast<uint16_t>(v.on ? v.env : 0);
+                case 0xC: return static_cast<uint16_t>(v.volxl);
+                case 0xE: return static_cast<uint16_t>(v.volxr);
+                default: break;
+                }
+            }
+            else if (r >= kVoiceAddrBase && r < kVoiceAddrEnd)
+            {
+                const uint32_t vi = (r - kVoiceAddrBase) / 0xCu, field = (r - kVoiceAddrBase) % 0xCu;
+                if (field >= 8u) // NAX: where the voice is now
+                {
+                    const uint32_t half = c.v[vi].nax >> 1;
+                    return static_cast<uint16_t>(field == 8u ? (half >> 16) & 0xFu : half & 0xFFFFu);
+                }
+            }
+            else if (r == kEndx)
+                return static_cast<uint16_t>(c.endx & 0xFFFFu);
+            else if (r == kEndx + 2)
+                return static_cast<uint16_t>(c.endx >> 16);
+        }
+        return m_raw[off >> 1];
+    }
+
+    void IopSpu2::write32(uint32_t address, uint32_t value)
+    {
+        write16(address, static_cast<uint16_t>(value & 0xFFFFu));
+        write16(address + 2u, static_cast<uint16_t>(value >> 16));
+    }
+
+    uint32_t IopSpu2::read32(uint32_t address) const
+    {
+        return static_cast<uint32_t>(read16(address)) | (static_cast<uint32_t>(read16(address + 2u)) << 16);
+    }
+
+    void IopSpu2::transferWrite(int core, const uint8_t *data, uint32_t bytes)
+    {
+        if (data == nullptr || bytes == 0u || core < 0 || core >= kCores)
+            return;
+        Core &c = m_cores[core];
+        const uint32_t address = c.tsa & (kRamSize - 1u);
+        const uint32_t first = std::min(bytes, kRamSize - address);
+        std::memcpy(m_ram.data() + address, data, first);
+        if (bytes > first)
+            std::memcpy(m_ram.data(), data + first, std::min(bytes - first, kRamSize));
+        c.tsa = (address + bytes) & (kRamSize - 1u);
+        static unsigned logged = 0u;
+        if (logged++ < 8u)
+            std::fprintf(stderr, "[spu2:dma] core%d %u bytes to SPU RAM 0x%05x%c", core, bytes, address, 10);
+    }
+
+    // ------------------------------------------------------------------ ADPCM (PAL spu2.c)
+    void IopSpu2::decodeBlock(Voice &v)
+    {
+        const uint8_t *b = m_ram.data() + (v.nax & (kRamSize - 1u) & ~15u);
+        int shift = b[0] & 15, filter = (b[0] >> 4) & 7;
+        if (filter > 4)
+            filter = 4;
+        if (shift > 12)
+            shift = 9;
+        v.blockFlags = b[1];
+        v.curBlock = v.nax & ~15u;
+        if ((b[1] & 4) && !v.lsaSet)
+            v.lsa = v.curBlock;
+        for (int i = 0; i < 28; ++i)
+        {
+            const int nib = (b[2 + i / 2] >> ((i & 1) * 4)) & 15;
+            int32_t s = static_cast<int16_t>(nib << 12) >> shift;
+            s += (v.s1 * kF0[filter] + v.s2 * kF1[filter] + 32) >> 6;
+            s = std::clamp(s, -32768, 32767);
+            v.s2 = v.s1;
+            v.s1 = s;
+            v.buf[i] = static_cast<int16_t>(s);
+        }
+        v.bufpos = 0;
+        ++m_blocksDecoded;
+    }
+
+    // ------------------------------------------------------------------ ADSR (PAL spu2.c)
+    void IopSpu2::envTick(Voice &v)
+    {
+        int up, expo, shift, step;
+        switch (v.envPhase)
+        {
+        case kEnvAttack:
+            up = 1; expo = (v.adsr1 >> 15) & 1; shift = (v.adsr1 >> 10) & 31; step = 7 - ((v.adsr1 >> 8) & 3);
+            break;
+        case kEnvDecay: // decay and release store only the shift; their step is fixed at -8
+            up = 0; expo = 1; shift = (v.adsr1 >> 4) & 15; step = -8;
+            break;
+        case kEnvSustain:
+            up = !((v.adsr2 >> 14) & 1); expo = (v.adsr2 >> 15) & 1; shift = (v.adsr2 >> 8) & 31;
+            step = up ? 7 - ((v.adsr2 >> 6) & 3) : -8 + ((v.adsr2 >> 6) & 3);
+            break;
+        case kEnvRelease:
+            up = 0; expo = (v.adsr2 >> 5) & 1; shift = v.adsr2 & 31; step = -8;
+            break;
+        default:
+            return;
+        }
+        uint32_t cycles = 1u << (shift > 11 ? shift - 11 : 0);
+        int32_t st = step << (shift < 11 ? 11 - shift : 0);
+        if (expo && up && v.env > 0x6000)
+            cycles <<= 2;
+        if (expo && !up)
+            st = static_cast<int32_t>((static_cast<int64_t>(st) * v.env) >> 15);
+        if (++v.envCounter < cycles)
+            return;
+        v.envCounter = 0;
+        v.env = std::clamp(v.env + st, 0, 0x7fff);
+        switch (v.envPhase)
+        {
+        case kEnvAttack:
+            if (v.env >= 0x7fff)
+                v.envPhase = kEnvDecay;
+            break;
+        case kEnvDecay:
+            if (v.env <= (((v.adsr1 & 15) + 1) << 11))
+                v.envPhase = kEnvSustain;
+            break;
+        case kEnvRelease:
+            if (v.env <= 0)
+            {
+                v.envPhase = kEnvOff;
+                v.on = false;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+
+    // ------------------------------------------------------------------ voices (PAL spu2.c)
+    void IopSpu2::keyOn(int core, uint32_t bits)
+    {
+        Core &c = m_cores[core];
+        for (int vi = 0; vi < kVoices; ++vi)
+        {
+            if (!((bits >> vi) & 1u))
+                continue;
+            Voice &v = c.v[vi];
+            v.nax = v.ssa;
+            if (!v.lsaSet)
+                v.lsa = v.ssa;
+            v.lsaSet = false;
+            v.s1 = v.s2 = 0;
+            std::memset(v.hist, 0, sizeof v.hist);
+            v.counter = 0;
+            v.env = 0;
+            v.envCounter = 0;
+            v.envPhase = kEnvAttack;
+            v.on = true;
+            c.endx &= ~(1u << vi);
+            decodeBlock(v);
+            ++m_keyonCount;
+            static unsigned logged = 0u;
+            if (konLog() && logged++ < 80u)
+                std::fprintf(stderr, "[spu2:kon] core%d v%02d ssa=0x%05x pitch=0x%04x vol=%04x/%04x adsr=%04x/%04x "
+                                     "vmix=%u%u%c",
+                             core, vi, v.ssa, v.pitch, v.voll, v.volr, v.adsr1, v.adsr2, (c.vmixl >> vi) & 1u,
+                             (c.vmixr >> vi) & 1u, 10);
+        }
+    }
+
+    void IopSpu2::keyOff(int core, uint32_t bits)
+    {
+        Core &c = m_cores[core];
+        for (int vi = 0; vi < kVoices; ++vi)
+        {
+            Voice &v = c.v[vi];
+            if (((bits >> vi) & 1u) && v.on && v.envPhase != kEnvOff)
+            {
+                v.envPhase = kEnvRelease;
+                v.envCounter = 0;
+            }
+        }
+    }
+
+    int16_t IopSpu2::voiceSample(Core &c, int vi)
+    {
+        Voice &v = c.v[vi];
+        if (!v.on)
+            return 0;
+        // 4-point (Catmull-Rom) interpolation between hist[1] and hist[2]
+        const int64_t t = static_cast<int32_t>(v.counter & 0xfff);
+        const int64_t p0 = v.hist[0], p1 = v.hist[1], p2 = v.hist[2], p3 = v.hist[3];
+        const int64_t a = -p0 + 3 * p1 - 3 * p2 + p3, b = 2 * p0 - 5 * p1 + 4 * p2 - p3, cc = -p0 + p2, d = 2 * p1;
+        const int64_t s = (((((a * t) >> 12) + b) * t >> 12) + cc) * t >> 12;
+        const int32_t out = std::clamp(static_cast<int32_t>((s + d) / 2), -32768, 32767);
+        const uint32_t pitch = v.pitch > 0x3fff ? 0x3fff : v.pitch;
+        v.counter += pitch;
+        while (v.counter >= 0x1000)
+        {
+            v.counter -= 0x1000;
+            v.hist[0] = v.hist[1];
+            v.hist[1] = v.hist[2];
+            v.hist[2] = v.hist[3];
+            v.hist[3] = v.buf[v.bufpos++];
+            if (v.bufpos >= 28)
+            {
+                // end of block: handle loop flags, then fetch the next one
+                const uint8_t fl = v.blockFlags;
+                if (fl & 1)
+                {
+                    c.endx |= 1u << vi;
+                    if (fl & 2)
+                        v.nax = v.lsa;
+                    else
+                    {
+                        v.on = false;
+                        v.env = 0;
+                        v.envPhase = kEnvOff;
+                        v.nax = v.curBlock + 16;
+                        break;
+                    }
+                }
+                else
+                    v.nax = v.curBlock + 16;
+                decodeBlock(v);
+            }
+        }
+        envTick(v);
+        return static_cast<int16_t>((out * v.env) >> 15);
+    }
+
+    int IopSpu2::activeVoices() const noexcept
+    {
+        int count = 0;
+        for (const Core &c : m_cores)
+            for (const Voice &v : c.v)
+                count += v.on ? 1 : 0;
+        return count;
+    }
+
+    size_t IopSpu2::mix(int16_t *out, size_t frames)
+    {
+        if (out == nullptr || frames == 0u)
+            return 0u;
+        for (size_t f = 0; f < frames; ++f)
+        {
+            int32_t ol = 0, orr = 0;
+            for (int ci = 0; ci < kCores; ++ci)
+            {
+                Core &c = m_cores[ci];
+                int32_t dl = 0, dr = 0;
+                for (int vi = 0; vi < kVoices; ++vi)
+                {
+                    Voice &v = c.v[vi];
+                    if (!v.on)
+                        continue;
+                    const int32_t s = voiceSample(c, vi);
+                    v.volxl = volStep(v.voll, v.volxl);
+                    v.volxr = volStep(v.volr, v.volxr);
+                    if (c.vmixl & (1u << vi))
+                        dl += (s * v.volxl) >> 15;
+                    if (c.vmixr & (1u << vi))
+                        dr += (s * v.volxr) >> 15;
+                }
+                const int32_t mvl = m_mvolWritten ? fixedVol(c.mvoll) : 0x7fff;
+                const int32_t mvr = m_mvolWritten ? fixedVol(c.mvolr) : 0x7fff;
+                ol += (dl * mvl) >> 15;
+                orr += (dr * mvr) >> 15;
+            }
+            out[f * 2u] = static_cast<int16_t>(std::clamp(ol, -32768, 32767));
+            out[f * 2u + 1u] = static_cast<int16_t>(std::clamp(orr, -32768, 32767));
+        }
+        static unsigned long long mixed = 0ull;
+        static const bool stat = std::getenv("APE2_SPU2_STAT") != nullptr;
+        if (stat && (mixed += frames) >= 48000ull)
+        {
+            mixed = 0ull;
+            std::fprintf(stderr, "[spu2:stat] voices on=%d keyons=%llu blocks=%llu%c", activeVoices(), m_keyonCount,
+                         m_blocksDecoded, 10);
+        }
+        return frames;
+    }
+}
