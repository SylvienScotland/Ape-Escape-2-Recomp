diff --git a/ps2xRuntime/src/lib/Kernel/zz_ape2_hangdump.cpp b/ps2xRuntime/src/lib/Kernel/zz_ape2_hangdump.cpp
new file mode 100644
index 0000000..63271fc
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/zz_ape2_hangdump.cpp
@@ -0,0 +1,58 @@
+// Guest RAM dump for the "Now Loading" hang (Ape Escape 2 recomp debugging aid).
+//
+// APE2_HANG_DUMP=<path prefix> arms a one-shot dump: ~12 s into the run the EE RAM window that holds the
+// handshake spin at 0x37c5a0 (0x37b000-0x37e000) is written to <prefix>_ee.bin, and the words of the spin
+// itself are printed. The guest unpacks that code into RAM at boot, so the on-disc ELF image cannot be used
+// to read it - the running copy is the only accurate one.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <chrono>
+
+extern uint8_t *g_ape2Rdram;
+
+namespace
+{
+    void dumpOnce(const std::string &prefix, uint8_t *rdram, size_t ramSize)
+    {
+        const uint32_t lo = 0u;
+        const uint32_t hi = 0x2000000u; // whole 32 MiB picture: the pending load object lives on the heap
+        if (!rdram || lo >= ramSize)
+            return;
+        const uint32_t end = hi < ramSize ? hi : static_cast<uint32_t>(ramSize);
+        std::FILE *f = std::fopen((prefix + "_ee.bin").c_str(), "wb");
+        if (f)
+        {
+            std::fwrite(rdram + lo, 1, end - lo, f);
+            std::fclose(f);
+            std::fprintf(stderr, "[hangdump] wrote %u bytes of EE RAM at 0x%x to %s_ee.bin%c", end - lo, lo,
+                         prefix.c_str(), 10);
+        }
+        else
+        {
+            std::fprintf(stderr, "[hangdump] could not open %s_ee.bin%c", prefix.c_str(), 10);
+        }
+        for (uint32_t a = 0x37c590u; a < 0x37c5d0u; a += 4u)
+        {
+            uint32_t w = 0;
+            std::memcpy(&w, rdram + a, sizeof(w));
+            std::fprintf(stderr, "[hangdump]   0x%05x = %08x%c", a, w, 10);
+        }
+    }
+}
+
+void ape2InstallHangDump(uint8_t *rdram, size_t ramSize)
+{
+    const char *env = std::getenv("APE2_HANG_DUMP");
+    if (!env || !*env || !rdram)
+        return;
+    const std::string prefix(env);
+    std::fprintf(stderr, "[hangdump] armed: writing %s_ee.bin after 12 s%c", prefix.c_str(), 10);
+    std::thread([prefix, rdram, ramSize]() {
+        std::this_thread::sleep_for(std::chrono::seconds(12));
+        dumpOnce(prefix, rdram, ramSize);
+    }).detach();
+}
