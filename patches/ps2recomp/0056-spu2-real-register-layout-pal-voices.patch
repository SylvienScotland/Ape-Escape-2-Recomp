new file mode 100644
index 0000000..1760cca
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -0,0 +1,102 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    // The SPU2: 2 MB of sample RAM shared by both cores, 24 voices per core reading 4-bit ADPCM with pitch, loop
+    // flags and ADSR, mixed at 48 kHz to interleaved signed 16-bit stereo.
+    // 0223: the register file follows the real SPU2 layout (the one PCSX2 documents), so LIBSD.IRX's own writes
+    // program the voices. The voice engine (ADPCM, ADSR, Catmull-Rom pitch, volume sweeps) is ported from the PAL
+    // port's port/src/spu2.c (JackyPendrag0n/ae2-recomp), which drives the same engine through libsd calls.
+    class IopSpu2
+    {
+    public:
+        static constexpr uint32_t kBase = 0x1F900000u;
+        static constexpr uint32_t kEnd = 0x1F901000u;
+        static constexpr uint32_t kLegacyBase = 0x1F801C00u;
+        static constexpr uint32_t kLegacyEnd = 0x1F801E00u;
+        static constexpr uint32_t kRamSize = 0x200000u;
+        static constexpr int kVoices = 24;
+        static constexpr int kCores = 2;
+        static constexpr uint32_t kRegisterSize = 0x400u;
+
+        IopSpu2();
+
+        void reset();
+
+        [[nodiscard]] static bool contains(uint32_t address) noexcept
+        {
+            return (address >= kBase && address < kEnd) || (address >= kLegacyBase && address < kLegacyEnd);
+        }
+
+        void write16(uint32_t address, uint16_t value);
+        [[nodiscard]] uint16_t read16(uint32_t address) const;
+        void write32(uint32_t address, uint32_t value);
+        [[nodiscard]] uint32_t read32(uint32_t address) const;
+
+        // Sample-transfer DMA: bytes land in SPU RAM at the core's transfer address (TSA), which advances.
+        void transferWrite(int core, const uint8_t *data, uint32_t bytes);
+
+        // Produces interleaved stereo frames at 48 kHz and returns how many were written.
+        size_t mix(int16_t *out, size_t frames);
+
+        [[nodiscard]] unsigned long long keyonCount() const noexcept { return m_keyonCount; }
+        [[nodiscard]] int activeVoices() const noexcept;
+        [[nodiscard]] unsigned long long blocksDecoded() const noexcept { return m_blocksDecoded; }
+
+    private:
+        enum EnvPhase
+        {
+            kEnvOff,
+            kEnvAttack,
+            kEnvDecay,
+            kEnvSustain,
+            kEnvRelease
+        };
+
+        struct Voice
+        {
+            uint16_t voll = 0, volr = 0, pitch = 0, adsr1 = 0, adsr2 = 0;
+            int32_t volxl = 0, volxr = 0;
+            uint32_t ssa = 0, lsa = 0, nax = 0; // byte addresses
+            bool lsaSet = false;                // LSAX written by software since key on
+            bool on = false;
+            int envPhase = kEnvOff;
+            int32_t env = 0;
+            uint32_t envCounter = 0;
+            uint32_t counter = 0; // 12-bit fraction position
+            int16_t buf[28]{};
+            int bufpos = 0;
+            int32_t s1 = 0, s2 = 0;
+            int16_t hist[4]{};
+            uint32_t curBlock = 0;
+            uint8_t blockFlags = 0;
+        };
+
+        struct Core
+        {
+            Voice v[kVoices];
+            uint32_t pmon = 0, non = 0, vmixl = 0, vmixel = 0, vmixr = 0, vmixer = 0, endx = 0;
+            uint16_t mmix = 0, attr = 0;
+            uint16_t mvoll = 0, mvolr = 0, evoll = 0, evolr = 0, avoll = 0, avolr = 0, bvoll = 0, bvolr = 0;
+            uint32_t tsa = 0; // byte address
+        };
+
+        void decodeBlock(Voice &v);
+        void envTick(Voice &v);
+        void keyOn(int core, uint32_t bits);
+        void keyOff(int core, uint32_t bits);
+        int16_t voiceSample(Core &c, int vi);
+        [[nodiscard]] uint32_t pairAddress(uint32_t hiOffset) const; // hi/lo halfword pair -> byte address
+
+        std::vector<uint8_t> m_ram;
+        Core m_cores[kCores];
+        uint16_t m_raw[0x800]{}; // the whole register window as written, halfword indexed
+        bool m_mvolWritten = false;
+        unsigned long long m_keyonCount = 0;
+        unsigned long long m_blocksDecoded = 0;
+    };
+}
